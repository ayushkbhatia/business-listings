// Business Listings — Prisma schema.
//
// Prisma owns every application table. Supabase owns only `auth.*` and `storage.*`.
//
// Three shapes are load-bearing and each would be a migration to undo:
//   1. Product has no price. `QuoteLine.unitPrice` is the only price in the schema.
//   2. `Business.verificationTier` is staff-write-only, ops_lead role. No API path.
//   3. `AuditEvent.reason` is NOT NULL. Every staff mutation writes one.
// There is no order table, no payment capture, no payout, no commission, no escrow.
//
// Tables and columns are snake_case: ops work happens in the Supabase SQL editor and
// in scheduled SQL jobs, and quoting "licenceNumber" everywhere is a tax on that.

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

/// Mirrors auth.users. The id IS the Supabase auth uuid — there is no second
/// identity space. Roles live here and are copied into the JWT by an auth hook;
/// they are never read from user_metadata, which the user can edit.
model User {
  id         String  @id @db.Uuid
  phone      String? @unique
  email      String? @unique
  fullName   String? @map("full_name")
  roles      Role[]  @default([])
  /// Set for a seller seat. Scopes every seller capability to one business.
  businessId String? @map("business_id")
  /// Set where a seat is scoped to one branch. Board 7d, built by board 8d.
  ///
  /// `Actor.branchId` has been declared in lib/auth/roles.ts since handoff 0
  /// and is consumed by `withinScope()` and `analyticsScopeFor()` — and nothing
  /// has ever populated it, because there was no column to populate it from.
  /// Every branch-scoping check in the product therefore returned true. This is
  /// the column those checks were written against.
  branchId   String? @map("branch_id")
  locale     String  @default("en")

  /// A buyer can send an enquiry with no account at all — the board says so and
  /// it is deliberate, because requiring signup before the first enquiry is the
  /// fastest way to kill the funnel. A provisional user has a phone number, no
  /// Supabase auth record, and a token that lets them claim the identity later.
  isProvisional Boolean   @default(false) @map("is_provisional")
  claimToken    String?   @unique @map("claim_token")
  claimedAt     DateTime? @map("claimed_at")

  /// Signup captures the intent to list, not the role. `seller_owner` is scoped
  /// to a business and there is no business until the claim flow in handoff 3
  /// attaches one — granting the role here would grant it over nothing.
  wantsToList Boolean @default(false) @map("wants_to_list")

  /// The "account suspended" state on board 7a.
  ///
  /// No reason column, deliberately. A suspension is a staff state change, so
  /// the written reason is on its audit row — the same place a business
  /// suspension keeps one, and the place CLAUDE.md requires. It is also not
  /// automatically the text to show the suspended person: an investigative
  /// reason is a note to staff, and the screen offers an appeal instead.
  suspendedAt DateTime? @map("suspended_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business                Business?                @relation("BusinessTeam", fields: [businessId], references: [id], onDelete: SetNull)
  branch                  Location?                @relation("SeatBranch", fields: [branchId], references: [id], onDelete: SetNull)
  buyerCompanyId          String?                  @map("buyer_company_id")
  buyerCompany            BuyerCompany?            @relation(fields: [buyerCompanyId], references: [id], onDelete: SetNull)
  enquiries               Enquiry[]
  reviews                 Review[]
  disputesRaised          ReviewDispute[]          @relation("DisputeRaisedBy")
  disputesDecided         ReviewDispute[]          @relation("DisputeDecidedBy")
  auditEvents             AuditEvent[]
  invoiceEvents           InvoiceEvent[]
  cancellations           SubscriptionChange[]     @relation("ChangeRequestedBy")
  reportsFiled            SupplierReport[]         @relation("ReportReporter")
  messages                Message[]
  contactReveals          ContactReveal[]
  savedSearches           SavedSearch[]
  shortlist               Shortlist[]              @relation("BuyerShortlist")
  productEvents           ProductEvent[]           @relation("EventActor")
  catalogueImports        CatalogueImportRequest[] @relation("CatalogueImportRequester")
  productAlerts           ProductAlert[]
  reviewRequests          ReviewRequest[]
  importRuns              ImportRun[]
  changeRequests          ListingChangeRequest[]   @relation("ChangeRequestActor")
  listingRevisions        ListingRevision[]        @relation("ListingRevisionActor")
  /// Board 6b: who last audited a curated list, and every audit they signed.
  curatedListsEdited      CuratedList[]            @relation("CuratedListEditor")
  curatedAudits           CuratedListAudit[]       @relation("CuratedListAuditor")
  changesDecided          ListingChangeRequest[]   @relation("ChangeRequestDecider")
  demandRecorded          ScopeDemand[]            @relation("ScopeDemandRecorder")
  ruleChangesProposed     PublishRuleChange[]      @relation("RuleChangeProposer")
  ruleChangesDecided      PublishRuleChange[]      @relation("RuleChangeDecider")
  areaPagesHeld           AreaPage[]               @relation("AreaPageHolder")
  emiratePagesHeld        EmiratePage[]            @relation("EmiratePageHolder")
  invitesSent             TeamInvite[]             @relation("InviteSender")
  claimsMade              ClaimSubmission[]        @relation("ClaimClaimant")
  onboardingDrafts        OnboardingDraft[]        @relation("OnboardingDraftUser")
  categoryActivityCleared BusinessCategory[]       @relation("CategoryActivityClearedBy")
  conflictsResolved       ClaimConflict[]          @relation("ConflictResolvedBy")
  licenceImports          LicenceImportRun[]       @relation("IngestActor")
  merges                  BusinessMerge[]          @relation("MergeActor")
  pdplSubjectOf           PdplRequest[]            @relation("PdplSubject")
  pdplClosed              PdplRequest[]            @relation("PdplClosedBy")
  apiKeys                 ApiKey[]                 @relation("ApiKeyCreator")
  viewAsSessions          ViewAsSession[]          @relation("ViewAsStaff")
  callsMade               CallOutcome[]            @relation("CallStaff")
  candidatesDismissed     MergeCandidate[]         @relation("CandidateDismissedBy")
  templateVersions        TemplateVersion[]
  specRevisions           SellerTemplateRevision[] @relation("TemplateRevisionAuthor")
  boostsCreated           ListingBoost[]
  rankingDrafts           RankingDraft[]           @relation("RankingDraftAuthor")
  rankingPublishes        RankingPublish[]         @relation("RankingPublisher")
  settingsWritten         PlatformSetting[]        @relation("SettingWriter")
  askedQuestions          ProductQuestion[]
  leadsAssigned           EnquiryRecipient[]       @relation("LeadAssignee")
  leadsRouted             EnquiryRecipient[]       @relation("LeadAssigner")
  leadOutcomes            EnquiryRecipient[]       @relation("LeadOutcomeAuthor")
  quotesExtended          Quote[]                  @relation("QuoteExtender")
  channels                SeatChannel[]
  routingCursorFor        Business[]               @relation("RoutingCursor")

  @@index([businessId])
  @@map("user")
}

/// What was attempted. Kept separate because the thresholds differ: asking for
/// a code is cheap to the user and costly to us, while getting one wrong is the
/// opposite.
enum AuthAttemptKind {
  /// Asking for a code. Throttled for cost — a WhatsApp authentication message
  /// to the UAE is priced per delivery, so a resend button with no cooldown is
  /// a direct leak.
  otp_request
  /// Submitting a code. Throttled for security.
  otp_verify
  /// Asking for a password reset link.
  reset_request

  @@map("auth_attempt_kind")
}

/// One row per attempt at getting in, successful or not.
///
/// Supabase enforces its own rate limits and does not expose the counter, so
/// "too many attempts" cannot be a designed state without our own record. This
/// is also the audit trail for a locked-out user asking why.
model AuthAttempt {
  id String @id @default(cuid())

  /// Normalised: E.164 phone, or a lowercased email. Never a user id — the
  /// point is to throttle before we know, or care, who this is.
  identifier String
  kind       AuthAttemptKind
  succeeded  Boolean         @default(false)
  /// Best-effort, from the proxy header. Null when there is none to read.
  ip         String?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([identifier, kind, createdAt])
  @@index([createdAt])
  @@map("auth_attempt")
}

enum Role {
  buyer
  seller_owner
  seller_manager
  seller_sales
  seller_finance
  staff_moderator
  staff_field
  staff_finance
  staff_ops_lead

  @@map("role")
}

/// A buyer's employer. Carries the TRN and the approval threshold a procurement
/// team sets for itself — "orders over AED 25,000 need approval" is the buyer's
/// own process, not a platform order entity.
model BuyerCompany {
  id                   String   @id @default(cuid())
  name                 String
  trn                  String?
  emirate              Emirate?
  approvalThresholdAed Int?     @map("approval_threshold_aed")
  createdAt            DateTime @default(now()) @map("created_at")

  members   User[]
  enquiries Enquiry[]

  @@map("buyer_company")
}

// ─────────────────────────────────────────────────────────────────────────────
// Geography & taxonomy
// ─────────────────────────────────────────────────────────────────────────────

enum Emirate {
  abu_dhabi
  dubai
  sharjah
  ajman
  umm_al_quwain
  ras_al_khaimah
  fujairah

  @@map("emirate")
}

/// What a seller says they sell, in their own words — board `2b-s`, decision D8.
///
/// **Not the same question as `TradeKind`, and not a duplicate of it.** A
/// trade kind is a fact about a *category*: customs clearance is sold by the
/// job whoever is selling it. This is a *business's own declaration*, and the
/// two have different jobs — `sellsKind` drives which onboarding a seller gets,
/// which dashboard nav they see and which setup tasks appear; `Category.tradeKind`
/// decides how each individual listing renders.
///
/// `both` exists here and deliberately not on `TradeKind`. A firm that supplies
/// equipment and services it is ordinary, and on the category a third value
/// would let a subcategory be neither — but on the business it is the plain
/// truth, and it is what sizes the setup honestly. It introduces no third model:
/// the business simply holds subcategories of both kinds and each listing still
/// renders per its own.
///
/// `unset` is the state before the seller has been asked. Onboarding routes back
/// to the question rather than guessing, because inferring this onto a live
/// business is the mistake `offering_type` made.
enum SellsKind {
  unset
  goods
  services
  both

  @@map("sells_kind")
}

/// Whether a trade is sold by the item or by the job.
///
/// Two values and deliberately no third. "Both" is a property of a *business*,
/// not of a trade: a firm that sells pumps and services them holds one category
/// of each, which the many-to-many `BusinessCategory` already expresses. Adding
/// `both` here would let one subcategory be neither, and every reader would
/// need a branch for a state the taxonomy cannot act on.
///
/// Not a booking model. There is no calendar, no slot and no availability
/// window behind `services` — the conversion event stays the enquiry. See
/// `docs/services-spec.md` §2.
enum TradeKind {
  goods
  services

  @@map("trade_kind")
}

/// Areas and free zones are translatable records, not code strings. Arabic names
/// live here from day one so the taxonomy is a data change, never a deploy.
model Area {
  id          String    @id @default(cuid())
  emirate     Emirate
  name        String
  nameAr      String?   @map("name_ar")
  slug        String    @unique
  /// A free zone is a cross-cutting toggle, not a place in the area hierarchy.
  isFreeZone  Boolean   @default(false) @map("is_free_zone")
  lat         Float?
  lng         Float?
  /// Unused. Handoff 0 intended an area-wide publish switch; board 6a put the
  /// gate on `AreaPage` per (area, category) instead, and this column has had
  /// no reader and no writer in application code since. It is always null.
  /// Named here rather than dropped so nobody reaches for "the area's
  /// published date" and gets a column that is never written.
  publishedAt DateTime? @map("published_at")

  locations Location[]
  coverage  BusinessCoverage[]
  pages     AreaPage[]
  lists     CuratedList[]
  demand    ScopeDemand[]

  @@index([emirate])
  @@map("area")
}

/// Self-referencing tree, two levels in use.
model Category {
  id                  String     @id @default(cuid())
  parentId            String?    @map("parent_id")
  name                String
  nameAr              String?    @map("name_ar")
  slug                String     @unique
  /// Two-letter mono mark, e.g. "IN".
  code                String
  /// Query routing. Includes Arabic terms — صمامات must find valve suppliers.
  synonyms            String[]   @default([])
  defaultTemplateId   String?    @map("default_template_id")
  /// How this trade is sold — decision D5, `docs/services-spec.md`.
  ///
  /// Null inherits from the parent, so a sector can be set once and a
  /// subcategory overridden where it differs. `resolveTradeKind` walks up to
  /// the nearest ancestor that has one, and a tree with none anywhere resolves
  /// to `goods`, because that is what every surface assumed before this column
  /// existed and an unset taxonomy must not change what the site does.
  ///
  /// The unit is the subcategory, not the sector, and that is the finding this
  /// column exists to record: not one of the thirteen sectors is purely one or
  /// the other. Logistics holds *Customs clearance* beside *Material handling
  /// equipment*; IT holds *Cybersecurity* beside *Servers & storage*. A
  /// sector-level flag would be wrong on roughly half the tree.
  tradeKind           TradeKind? @map("trade_kind")
  showOnHome          Boolean    @default(false) @map("show_on_home")
  acceptsRfq          Boolean    @default(true) @map("accepts_rfq")
  requiresExtraCheck  Boolean    @default(false) @map("requires_extra_check")
  /// The landing page's own copy.
  ///
  /// Board 6f: a category page with a heading and a grid of results is a page
  /// search engines have nothing to rank. This is the paragraph that gives it
  /// something, and `lib/content/matrix.ts` counts its words against the same
  /// 250 the template pages answer to.
  ///
  /// Nullable, and most are null. That is the point of the matrix: it shows
  /// which pages have nothing to say yet.
  intro               String?
  /// Listings needed before landing pages publish.
  publishThreshold    Int        @default(60) @map("publish_threshold")
  verifiedShareMin    Float      @default(0.30) @map("verified_share_min")
  /// Listings required per 1,000 monthly searches — board 6f.
  ///
  /// The second half of the listings rule. A page needs the absolute floor
  /// above or this figure applied to its recorded demand, whichever is higher,
  /// so a trade nobody searches for publishes at 60 and one with four thousand
  /// searches a month has to be worth arriving at. It bites only on scopes
  /// somebody has recorded a `ScopeDemand` row for.
  demandPerThousand   Int        @default(25) @map("demand_per_thousand")
  /// The fraction of that need a page which is ALREADY live keeps holding at.
  ///
  /// Board 6f asks for hysteresis: publish at 60, unpublish at 48. Without a
  /// band a scope sitting on the floor flaps, and every flap is a URL entering
  /// and leaving the sitemap. A share rather than a second integer because the
  /// need is no longer one number — at 0.8 it reproduces the board's 60 and 48
  /// exactly and scales with a demand-raised floor.
  holdShare           Float      @default(0.80) @map("hold_share")
  /// Words of the page's own copy — board 6f's fourth control.
  ///
  /// A column rather than the module default it used to read, because §5 puts
  /// the word floor on the rules panel beside the other five and every one of
  /// them republishes the site. `thresholdsFor` pinned this to 250 with a
  /// comment saying "board 6f owns it"; it does now.
  minIntroWords       Int        @default(250) @map("min_intro_words")
  /// Whether generated drafts must be read by a person before they publish.
  ///
  /// Board 6f §2: "Generate 38 drafts", not "Generate queued pages". A single
  /// button that publishes 38 pages into a live index is a materially different
  /// and worse button. On by default, and `generateDrafts` refuses to publish
  /// anything while it is on.
  humanReviewRequired Boolean    @default(true) @map("human_review_required")
  /// Days a newly published page is protected from the sweep — board 6f.
  ///
  /// The sweep skips a page inside this window rather than the page staying
  /// live while thin: see `AreaPage.firstPublishedAt`.
  minLiveDays         Int        @default(30) @map("min_live_days")
  sortOrder           Int        @default(0) @map("sort_order")
  createdAt           DateTime   @default(now()) @map("created_at")

  parent            Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]             @relation("CategoryTree")
  defaultTemplate   SpecTemplate?          @relation("CategoryDefaultTemplate", fields: [defaultTemplateId], references: [id], onDelete: SetNull)
  templates         SpecTemplateCategory[]
  primaryFor        Business[]             @relation("BusinessPrimaryCategory")
  sectorFor         Business[]             @relation("BusinessSector")
  businesses        BusinessCategory[]
  products          Product[]
  placements        PlacementSlot[]
  importMappings    ImportMapping[]
  positionDays      CategoryPositionDay[]
  rankDays          CategoryRankDay[]
  placementWaitlist PlacementWaitlist[]
  stagedListings    StagedListing[]
  guideCtas         Guide[]                @relation("GuideCtaCategory")
  areaPages         AreaPage[]
  emiratePages      EmiratePage[]
  scopeDemand       ScopeDemand[]
  ruleChanges       PublishRuleChange[]
  boosts            ListingBoost[]
  campaignCtas      Campaign[]             @relation("CampaignCtaCategory")
  productAlerts     ProductAlert[]
  curatedLists      CuratedList[]
  sectorTemplates   StorefrontTemplate[]   @relation("SectorTemplates")

  @@index([parentId])
  /// Synonyms are matched exactly — an Arabic term either is or is not in the
  /// list — so a plain GIN over the array is the right shape.
  @@index([synonyms], type: Gin)
  @@map("category")
}

// ─────────────────────────────────────────────────────────────────────────────
// Spec templates
// ─────────────────────────────────────────────────────────────────────────────

enum TemplateStatus {
  draft
  live
  retired

  @@map("template_status")
}

enum FieldType {
  select
  multiselect
  number
  number_range
  text
  boolean

  @@map("field_type")
}

/// Platform-owned and versioned. A seller clones it; the clone maps back here so
/// cross-seller comparison survives a rename.
model SpecTemplate {
  id           String         @id @default(cuid())
  name         String
  version      Int            @default(1)
  status       TemplateStatus @default(draft)
  /// Ops's unapplied edits, in the shape `lib/spec/changes.ts` reads.
  ///
  /// On the row rather than in a second `draft` row, for the reason
  /// `lib/spec/versions.ts` gives at length: `Product.specValues` is keyed by
  /// `SpecField.id`, so a draft that is a copy of the template hands every
  /// carried-forward field a new id and empties every catalogue in the
  /// category the moment it is published. Null means nothing pending, which is
  /// why it is nullable rather than defaulted — board 4e §5 makes the draft
  /// card absent with none pending rather than empty.
  draftChanges Json?          @map("draft_changes")
  createdAt    DateTime       @default(now()) @map("created_at")

  /// Every subcategory this template serves. Board 4e: the relation is
  /// many-to-many. Pipes & fittings holds four templates, because grooved,
  /// threaded, flanged and press fittings share almost no fields; the valve
  /// template serves both Valves & fittings and Pumps & motors. Which one a
  /// seller is offered first is `Category.defaultTemplateId`, a default and
  /// not an exclusive assignment.
  categories           SpecTemplateCategory[]
  defaultForCategories Category[]             @relation("CategoryDefaultTemplate")
  fields               SpecField[]
  sellerTemplates      SellerTemplate[]

  @@index([status])
  @@map("spec_template")
}

/// Which templates serve which subcategories — board 4e's many-to-many.
///
/// Explicit rather than an implicit Prisma relation, because coverage is a
/// query over it — subcategories with no row here — and that query is the
/// number this screen exists to move.
model SpecTemplateCategory {
  templateId String @map("template_id")
  categoryId String @map("category_id")

  template SpecTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([templateId, categoryId])
  @@index([categoryId])
  @@map("spec_template_category")
}

model SpecField {
  id              String    @id @default(cuid())
  templateId      String    @map("template_id")
  key             String
  label           String
  labelAr         String?   @map("label_ar")
  type            FieldType
  unit            String?
  options         String[]  @default([])
  required        Boolean   @default(false)
  /// Vestigial. Nothing writes this any more, and nothing should.
  ///
  /// It was board 4e's grace period: a publish could add a required field with
  /// a deadline, and the field bit on that date. The 4e handoff retires the
  /// idea outright, because a grace period implies a day 61 and the only things
  /// that could happen then — delisting, unpublishing, dropping out of search —
  /// are exactly what `3h` §5 and `6f`'s 301-not-404 exist to prevent. A
  /// version publish is additive and lands not-required; requiring a field is a
  /// separate action that flags and blocks the next save, with no deadline.
  ///
  /// The column stays because the read rule stays: a field is required now if
  /// `required` and (`requiredFrom` is null or in the past). Dropping it would
  /// make any row that still carries a future date required immediately, which
  /// is the one thing the retirement is meant to prevent.
  requiredFrom    DateTime? @map("required_from")
  /// Drives the site-wide filter rail. Changing this changes the rail with no
  /// code change — see handoff 1 acceptance criterion 4.
  isFilterable    Boolean   @default(false) @map("is_filterable")
  /// Whether this field differs between variants of the same product.
  ///
  /// Board 4e authors it and board 3g enforces it: a `VARIES` field is never
  /// offered for push-to-variants and never inherited by a duplicate, because
  /// pushing nominal size across a set overwrites DN80's size with DN100's. It
  /// has to live on the platform field — a clone can only inherit a flag the
  /// library template carries, so if it originated on the seller's copy `3g`
  /// would have nothing to read.
  variesByVariant Boolean   @default(false) @map("varies_by_variant")
  sortOrder       Int       @default(0) @map("sort_order")

  template SpecTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId, isFilterable])
  @@map("spec_field")
}

/// A seller's clone. fieldMappings keeps seller field -> platform field, so a
/// rename never silently drops the mapping.
model SellerTemplate {
  id                 String   @id @default(cuid())
  businessId         String   @map("business_id")
  platformTemplateId String   @map("platform_template_id")
  name               String
  /// `/dashboard/templates/:slug`. Unique per business, not globally — two
  /// suppliers both calling a template "Valves" is not a collision.
  slug               String
  /// What products and buyers read. Keyed by platform `SpecField.id`; see
  /// lib/catalogue/template.ts for the shape and why it stores only overrides.
  fieldMappings      Json     @default("{}") @map("field_mappings")
  /// What the seller has been editing and has not applied. Null means nothing
  /// is pending, which is why it is nullable rather than defaulted: board 3h
  /// makes the primary action absent with none pending rather than disabled.
  draftMappings      Json?    @map("draft_mappings")
  draftOwnFields     Json?    @map("draft_own_fields")
  /// The seller's own extra fields — warranty, lead time, whatever they compete
  /// on. Here rather than as `SpecField` rows, because a `SpecField` belongs to
  /// a platform template every seller in the category shares: one seller's
  /// warranty column would appear in everyone's editor and in the facet rail.
  /// Never a facet and never in comparison; board 3h renders them `YOURS ONLY`.
  ownFields          Json     @default("[]") @map("own_fields")
  /// How many times this seller has applied changes. Board 3h's `YOUR REV 7`.
  revision           Int      @default(1)
  /// Which platform version this copy has been reconciled against. The board
  /// showed one number and offered to compare the seller against it, which
  /// cannot both hold — these are two counters, not one.
  tracksVersion      Int      @default(1) @map("tracks_version")
  createdAt          DateTime @default(now()) @map("created_at")

  business         Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platformTemplate SpecTemplate             @relation(fields: [platformTemplateId], references: [id], onDelete: Restrict)
  revisions        SellerTemplateRevision[]

  /// One clone per business per platform template. Without it, five readers
  /// resolve "the seller's template" differently and a second row makes them
  /// disagree about which labels a seller has — silently, because each returns
  /// a valid-looking answer.
  @@unique([businessId, platformTemplateId], map: "seller_template_business_platform_key")
  @@unique([businessId, slug], map: "seller_template_business_slug_key")
  @@index([businessId])
  @@map("seller_template")
}

/// One row per apply. Board 3h's `Revision history`.
///
/// A snapshot of the whole overlay rather than a diff: rolling back has to
/// restore field order and options exactly, and replaying a chain of diffs to
/// get there is a second implementation of the overlay that can disagree with
/// the first.
model SellerTemplateRevision {
  id               String   @id @default(cuid())
  sellerTemplateId String   @map("seller_template_id")
  revision         Int
  name             String
  fieldMappings    Json     @default("{}") @map("field_mappings")
  ownFields        Json     @default("[]") @map("own_fields")
  /// What changed in this apply, so the history can say "renamed Size to
  /// Nominal size" without re-deriving it from two snapshots.
  summary          Json     @default("[]")
  /// Nullable: `removeSeat` nulls a departed seat's business rather than
  /// deleting the person, and a revision with no author is still a revision.
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  template  SellerTemplate @relation(fields: [sellerTemplateId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("TemplateRevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sellerTemplateId, revision], map: "seller_template_revision_key")
  @@index([sellerTemplateId, createdAt(sort: Desc)], map: "seller_template_revision_recent_idx")
  @@map("seller_template_revision")
}

// ─────────────────────────────────────────────────────────────────────────────
// Business & listing
// ─────────────────────────────────────────────────────────────────────────────

enum ClaimStatus {
  unclaimed
  claimed
  disputed

  @@map("claim_status")
}

enum ListingSource {
  licence_import
  self_added

  @@map("listing_source")
}

enum TeamSizeBand {
  b1_10
  b11_50
  b51_200
  b201_500
  b500_plus

  @@map("team_size_band")
}

/// Licensing authority. The seven emirate departments plus the free zones.
enum Authority {
  DED
  ADDED
  SHJ
  AJM
  UAQ
  RAK
  FUJ
  DMCC
  JAFZA
  SAIF
  DAFZA
  DSO
  DIC
  DMC
  DHCC
  DWC
  DIFC
  ADGM
  KIZAD
  HFZA
  RAKEZ
  UAQFTZ
  FCC
  MFZ
  DUQE
  IFZA
  SPCFZ
  AFZ
  TWOFOUR54
  MASDAR
  ADAFZ
  DPC
  DTEC
  IMPZ
  JLT
  TECOM

  @@map("authority")
}

model Business {
  id               String        @id @default(cuid())
  /// Locked to the licence. Not seller-editable.
  tradeName        String        @map("trade_name")
  displayName      String        @map("display_name")
  /// Immutable once published. A rename creates a 301, never an overwrite.
  slug             String        @unique
  licenceNumber    String        @map("licence_number")
  licenceAuthority Authority     @map("licence_authority")
  licenceExpiry    DateTime      @map("licence_expiry")
  /// Fifteen digits. Masked on every surface except the seller's own.
  trn              String?
  establishedYear  Int?          @map("established_year")
  teamSize         TeamSizeBand? @map("team_size")
  languages        String[]      @default([])
  /// What this seller says they sell — board `2b-s`. Their declaration, not the
  /// resolved kind of any one listing, which comes from `Category.tradeKind`.
  ///
  /// Defaults to `unset`: a business that has not passed the question is routed
  /// back to it rather than assumed to be anything.
  sellsKind        SellsKind     @default(unset) @map("sells_kind")
  /// The trading activity as the licence register words it, carried over from
  /// `StagedListing.activity` at import.
  ///
  /// Kept as the registry's own prose rather than a code: the exports word it
  /// differently per emirate and free zone, and a normalised enum would be a
  /// mapping table that is wrong for the thirty-seventh authority. Board 2c
  /// reads it to decide whether a category a seller picked is one their licence
  /// covers — a paint trader receiving electrical RFQs is the failure this
  /// prevents. Null where the import carried none, which is not the same as
  /// covering nothing: an absent activity flags nothing.
  licenceActivity  String?       @map("licence_activity")
  description      String?
  /// "30 days on approved account", "50% advance, balance on delivery".
  ///
  /// The seller's own words, not a picklist. Terms in this trade are a
  /// negotiation and the useful thing to publish is what they usually agree to,
  /// which no enumeration would hold. Never a price, and nothing here is a
  /// commitment the platform is party to.
  paymentTerms     String?       @map("payment_terms")
  /// "Same-day within Dubai, next day to the Northern Emirates."
  ///
  /// Board 1d's details panel asks for delivery as a fact a buyer can plan
  /// around. Free text for the same reason as payment terms: a supplier who
  /// delivers to site on their own truck and one who uses a courier are both
  /// answering the question, and a dropdown would make one of them lie.
  deliveryNote     String?       @map("delivery_note")
  /// Denormalised match surface: this supplier's own words, their categories
  /// and synonyms, and every product name, SKU and spec value in their
  /// catalogue — sizes and trade abbreviations expanded to every spelling.
  ///
  /// Board 1c's first requirement is that a query naming a *specification*
  /// finds the supplier who can meet it: `chilled water pumps` must reach a
  /// pumps supplier whose products carry `Application: chilled water`, not only
  /// one who wrote those words about themselves. Joining products at read time
  /// would mean normalising sizes across every candidate row, which is a
  /// sequential scan with a regex in it. Normalised once on write instead.
  ///
  /// Goes stale by construction, so a product write refreshes its business's
  /// row too — `lib/search/reindex.ts` owns both. Null means never indexed and
  /// is matched as empty, never as "matches everything".
  searchText       String?       @map("search_text")

  /// 0..2, held by the `business_verification_tier_range` CHECK. STAFF WRITE
  /// ONLY, ops_lead role. There is no API path and no seller-editable field.
  /// Drops to 1 automatically the day licenceExpiry passes — a scheduled job,
  /// no grace period.
  ///
  /// The ladder ran to 4 until site visits were withdrawn. Tiers 3 and 4 both
  /// rested on somebody standing in the warehouse — "site visited", and
  /// "premises visited and trading history audited" — and with no field team
  /// there is no evidence behind either. Rather than leave two rungs meaning
  /// whatever staff decide on the day, the visited rung went and `audited`
  /// moved down to 3, re-based on trading history.
  ///
  /// Rung 3 then became trade references, drawn `reserved` so the ladder had
  /// somewhere to go, and is now cut outright: it will never be built, and a
  /// reserved rung nobody intends to ship is a promise on a live screen. Tier 2
  /// is the top rung. See `20260919090000_cut_trade_references`.
  ///
  /// This said "drops to 2" until the job was written, and 2 was wrong in the
  /// dangerous direction: 2 IS the badge threshold (`VERIFIED_TIER`), and tier
  /// 2 means "we checked the licence with the issuing authority and confirm it
  /// is current" — the one claim an expired licence falsifies. Dropping to 2
  /// would have left a lapsed supplier wearing a badge that says the opposite
  /// of the truth, and contradicted board 1d, which removes the badge the same
  /// day. Tier 1 is "the supplier gives us a licence number", which stays true
  /// after expiry. See `lib/verification/expiry-job.ts`.
  verificationTier Int       @default(0) @map("verification_tier")
  verifiedAt       DateTime? @map("verified_at")

  claimStatus        ClaimStatus   @default(unclaimed) @map("claim_status")
  planId             String?       @map("plan_id")
  primaryCategoryId  String        @map("primary_category_id")
  /// The top-level ancestor of `primaryCategoryId`, denormalised.
  ///
  /// A storefront template belongs to a sector and the store count is the
  /// number every builder screen shows before a save, so it has to be one
  /// indexed column rather than a recursive walk per render.
  ///
  /// `BusinessCategory` rows are deliberately ignored: a third of businesses
  /// carry a second one, and a listing that belonged to two sectors would
  /// belong to two templates. Kept in step with `primaryCategoryId` by
  /// `lib/taxonomy/sector.ts`, and an integration test walks every row to check
  /// the two still agree.
  sectorId           String?       @map("sector_id")
  source             ListingSource @default(licence_import)
  /// Which licence import created this listing, where one did.
  ///
  /// Replaces a bare `import_run_id` TEXT column that existed from the init
  /// migration with no foreign key, no relation, no index and no reader — it
  /// predated `ImportRun`, which points at products, and read as provenance
  /// while being nothing.
  licenceImportRunId String?       @map("licence_import_run_id")
  suspendedAt        DateTime?     @map("suspended_at")
  /// The listing that absorbed this one, where one did.
  ///
  /// A merge never deletes. Everything hangs off `business_id` and cascades, so
  /// deleting the absorbed listing destroys the reviews that were the reason to
  /// merge — and criterion 2 wants thirty days of reversibility. The row stays,
  /// keeps its slug, and points here.
  mergedIntoId       String?       @map("merged_into_id")
  mergedAt           DateTime?     @map("merged_at")
  publishedAt        DateTime?     @map("published_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  /// Storefront theme preset, or a validated custom hex. Recolours the header,
  /// headings, buttons, links and form focus only. Never a verification badge,
  /// never a status tone, never platform chrome.
  /// How an incoming enquiry is put in front of the team. Board 7d.
  ///
  /// Not "the setting that protects the response score", which is what this
  /// comment used to say: there is no score in this product. What it moves is
  /// the median first reply, which is a weight in search ranking and the band a
  /// buyer reads on the listing. Both are measured; a score is not a thing.
  leadRouting           LeadRouting   @default(everyone) @map("lead_routing")
  /// Where round-robin got to.
  ///
  /// The last seat routed to rather than an index: 7d §8.3 requires the rotation
  /// to survive a seat being removed mid-cycle, and an integer into a list that
  /// just got shorter points at the wrong person. "The next eligible seat after
  /// this one" degrades to "the first eligible seat" when the cursor's seat is
  /// gone, which is the correct answer rather than an arbitrary one.
  routingCursorId       String?       @map("routing_cursor_id") @db.Uuid
  routingCursor         User?         @relation("RoutingCursor", fields: [routingCursorId], references: [id], onDelete: SetNull)
  seatChannels          SeatChannel[]
  /// Minutes before an unanswered enquiry is escalated to the owner.
  leadEscalationMinutes Int           @default(120) @map("lead_escalation_minutes")

  /// Board 7e §4 — the acknowledgement sent when a lead arrives out of hours.
  ///
  /// An acknowledgement and never a reply. `lib/messaging/service.ts` refuses to
  /// stamp `EnquiryRecipient.firstReplyAt` for a message marked `automatic`, and
  /// that refusal is what keeps the median honest: if a template could stamp it,
  /// the band every buyer reads and the 18 ranking points for reply time would
  /// both be won by switching this on, and every seller would.
  autoReplyEnabled Boolean @default(false) @map("auto_reply_enabled")
  /// The seller's own words, with `{buyer_name}`, `{next_open_time}` and
  /// `{whatsapp_number}` filled in at send. Null falls back to the default copy.
  autoReplyBody    String? @map("auto_reply_body")

  themePreset String? @map("theme_preset")
  themeHex    String? @map("theme_hex")

  // ── Derived. Computed by jobs, read-only everywhere else. No seller input;
  //    that is what makes them worth showing. See data-model.md.
  responseTimeMedianMs Int?      @map("response_time_median_ms")
  profileStrength      Int?      @map("profile_strength")
  specCompleteness     Float?    @map("spec_completeness")
  quotedValueAed       Decimal?  @map("quoted_value_aed") @db.Decimal(14, 2)
  ratingOverall        Float?    @map("rating_overall")
  reviewCount          Int       @default(0) @map("review_count")
  derivedAt            DateTime? @map("derived_at")

  primaryCategory        Category                 @relation("BusinessPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  /// Declared so Prisma knows the constraint the database already has.
  ///
  /// `sectorId` stays a denormalised pointer and is still read directly — see
  /// the field's own comment. This changes nothing about how it is used; it
  /// stops `migrate dev` proposing to drop `business_sector_id_fkey`, which it
  /// did on every run because a constraint the datamodel cannot see is drift to
  /// remove. Restrict, matching the database: a sector with listings standing
  /// on it should not be deletable.
  sector                 Category?                @relation("BusinessSector", fields: [sectorId], references: [id], onDelete: Restrict)
  categories             BusinessCategory[]
  plan                   Plan?                    @relation(fields: [planId], references: [id], onDelete: SetNull)
  team                   User[]                   @relation("BusinessTeam")
  locations              Location[]
  coverage               BusinessCoverage[]
  products               Product[]
  productQuestions       ProductQuestion[]
  media                  Media[]
  mediaFolders           MediaFolder[]
  documents              Document[]
  sellerTemplates        SellerTemplate[]
  recipients             EnquiryRecipient[]
  missedEnquiries        MissedEnquiry[]
  importRuns             ImportRun[]
  importMappings         ImportMapping[]
  changeRequests         ListingChangeRequest[]
  teamInvites            TeamInvite[]
  shortlistedBy          Shortlist[]
  viewDays               ListingViewDay[]
  searchImpressionDays   SearchImpressionDay[]
  categoryPositionDays   CategoryPositionDay[]
  categoryRankDays       CategoryRankDay[]
  factorDays             ListingFactorDay[]
  productViewDays        ProductViewDay[]
  deviceDays             ListingDeviceDay[]
  productEvents          ProductEvent[]
  catalogueImports       CatalogueImportRequest[]
  /// Board 6b. Membership of a curated list, and any drift against its snapshot.
  curatedEntries         CuratedListMember[]
  curatedDrift           CuratedListDrift[]
  claimSubmissions       ClaimSubmission[]
  listingRevisions       ListingRevision[]
  setupBaseline          SetupBaseline?
  licenceImportRun       LicenceImportRun?        @relation(fields: [licenceImportRunId], references: [id], onDelete: SetNull)
  mergedInto             Business?                @relation("BusinessMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  absorbed               Business[]               @relation("BusinessMergedInto")
  mergeCandidatesKeep    MergeCandidate[]         @relation("CandidateKeep")
  mergeCandidatesAbsorb  MergeCandidate[]         @relation("CandidateAbsorb")
  mergesKept             BusinessMerge[]          @relation("MergeKeep")
  mergesAbsorbed         BusinessMerge[]          @relation("MergeAbsorb")
  stagedListings         StagedListing[]
  viewAsSessions         ViewAsSession[]
  callOutcomes           CallOutcome[]
  claimConflicts         ClaimConflict[]          @relation("ConflictBusiness")
  onboardingDrafts       OnboardingDraft[]        @relation("OnboardingDraftBusiness")
  producedByConflicts    ClaimConflict[]          @relation("ConflictProduced")
  placementWaitlist      PlacementWaitlist[]
  quotes                 Quote[]
  messages               Message[]
  reviews                Review[]
  reviewDisputes         ReviewDispute[]
  reports                SupplierReport[]         @relation("ReportSubject")
  subscription           Subscription?
  subscriptionChanges    SubscriptionChange[]
  paymentMethod          PaymentMethod?
  invoices               Invoice[]
  mrrMovements           MrrMovement[]
  placements             PlacementSlot[]
  contactReveals         ContactReveal[]
  redirectsFrom          Redirect[]
  notificationPreference NotificationPreference?
  reviewRequests         ReviewRequest[]
  storefrontContent      StorefrontContent[]
  teamMembers            TeamMember[]
  customDomain           CustomDomain?
  boosts                 ListingBoost[]

  @@index([primaryCategoryId])
  @@index([sectorId], map: "business_sector_idx")
  @@index([claimStatus])
  @@index([verificationTier])
  @@index([publishedAt])
  @@index([licenceExpiry])
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([tradeName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("business")
}

/// Additional categories beyond the primary one.
/// An extra category a listing sits in, beyond its primary one.
///
/// The primary lives on `Business.primaryCategoryId` and is a moderated field —
/// changing it goes through `ListingChangeRequest`, so a person has already
/// looked at it. These are chosen freely on board 2c up to the plan's cap, which
/// is why the activity check lives here and not there.
model BusinessCategory {
  businessId String   @map("business_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  /// Set when the category matched nothing in the licence's stated activity.
  ///
  /// Board 2c, criterion 8: the chip is **accepted** — a seller is not refused
  /// mid-form on a text match against registry prose — and flagged for a
  /// reviewer, and the listing is left out of fan-outs *in this category* until
  /// somebody clears it. Silently accepting would let a paint trader receive
  /// electrical RFQs; silently refusing would tell a legitimate seller their own
  /// licence is wrong. Null once a reviewer has cleared it, and null from the
  /// start where the activity did cover it.
  unverifiedActivityAt DateTime? @map("unverified_activity_at")
  /// Who cleared the flag, so the decision has an author.
  clearedById          String?   @map("cleared_by_id") @db.Uuid

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  clearedBy User?    @relation("CategoryActivityClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)

  @@id([businessId, categoryId])
  @@index([categoryId])
  /// The reviewer's queue: every flag still standing, oldest first.
  @@index([unverifiedActivityAt])
  @@map("business_category")
}

/// How a branch's pin was placed, and therefore what it may be used for.
///
/// Two values, not three. "Missing" is not a precision — it is `lat IS NULL`,
/// which the database already records, and a third enum value would let a row
/// claim to have no pin while carrying coordinates. A CHECK ties the two
/// together instead: a pinned branch has a precision, an unpinned one has none.
///
/// `exact` means a person put the marker where the gate is — dragged on board
/// 2d's map, or resolved to a rooftop. `approximate` means the coordinates came
/// from the area rather than the address, so they say which part of the emirate
/// this is and nothing finer.
///
/// The distinction earns its column because **only `exact` may be measured**.
/// An area centroid ranked by distance is a number derived from a guess and
/// presented as a fact — board 3c's third criterion, and not a hypothetical:
/// 116 of the 118 pinned branches in production on 2026-09-07 sat within the
/// seed's own jitter of their area's centre, and every one of them was being
/// sorted by "distance".
enum GeocodePrecision {
  exact
  approximate

  @@map("geocode_precision")
}

enum LocationType {
  head_office
  warehouse
  trade_counter
  depot
  sales_office
  workshop

  @@map("location_type")
}

model Location {
  id            String       @id @default(cuid())
  businessId    String       @map("business_id")
  type          LocationType
  emirate       Emirate
  areaId        String       @map("area_id")
  addressLine   String       @map("address_line")
  lat           Float?
  /// Null means unpinned. Excluded from map search entirely — a location is
  /// never approximated to an area centroid, because a wrong pin is worse than
  /// no pin and the gap is surfaced to the seller instead.
  lng           Float?
  phone         String?
  whatsapp      String?
  /// Whether anybody has checked this number. Read by nothing today.
  ///
  /// It used to gate display: the branches page hid an unverified number and a
  /// results row hid the branch's WhatsApp behind it. Nothing has ever written
  /// it outside `prisma/seed.mts`, so in production it hid every branch number
  /// from every buyer and made the WhatsApp action on a results row impossible
  /// to render — while the seeded 80% made both look like they worked. The
  /// storefront one level up never had the gate at all.
  ///
  /// The gates are gone. Listings are seeded from public directory data that
  /// businesses publish about themselves, a wrong number is a reason for an
  /// owner to claim the listing, and an unclaimed listing already says
  /// page-wide that nothing on it has been confirmed.
  ///
  /// The column is kept rather than dropped because there is a real check
  /// waiting for it: `ClaimSubmission.phone` is "the number we would call,
  /// taken from the public licence record, never typed by the claimant", so a
  /// branch phone matching the licence record is verified by stronger evidence
  /// than an OTP — which a landline cannot receive anyway. Until that is built
  /// this is an unread column, and that is the honest description of it.
  phoneVerified Boolean      @default(false) @map("phone_verified")
  /// Per-day open/close, split shifts.
  hours         Json         @default("{}")
  /// Applied automatically on announced dates.
  ramadanHours  Json?        @map("ramadan_hours")

  /// The Ramadan year these hours were last confirmed for.
  ///
  /// Board 3d's first correction, and the field board 3a's reminder reads.
  /// Ramadan **dates** are ours — estimated until the UAE announcement, shifted
  /// by us, and the seller emailed. Ramadan **hours** are the seller's, and
  /// they carry over from last year until somebody says they still hold. The
  /// board collapsed both into one `AUTO-APPLIED` label, so a seller arriving
  /// from 3a's "Ramadan hours for 2027 unconfirmed" card found nothing to act
  /// on.
  ///
  /// Null, or a year behind the coming window, means unconfirmed. It does not
  /// mean unset: the carried-over times still apply, because the alternative is
  /// a listing that goes silent for a month.
  ramadanConfirmedYear Int? @map("ramadan_confirmed_year")
  serviceRadiusKm      Int? @map("service_radius_km")

  /// A branch that is shut for a stated stretch — a fit-out, a relocation, a
  /// flood. Distinct from `published = false`, and deliberately so: unpublishing
  /// removes the address from the directory, which is the wrong answer for a
  /// counter that reopens in three weeks. A buyer who knows this branch needs to
  /// be told the dates, not shown nothing.
  ///
  /// Board 3d writes these. Board 1f renders them above the branch's hours.
  /// A CHECK refuses a half-set window and a reason-less closure — the strip
  /// says what is wrong and when it ends, and it can only do that if both are
  /// there.
  closedFrom    DateTime? @map("closed_from")
  closedUntil   DateTime? @map("closed_until")
  closureReason String?   @map("closure_reason")

  /// How the pin got where it is. Null exactly when there is no pin.
  ///
  /// Written by whoever placed the marker, never inferred later: a coordinate
  /// cannot be examined afterwards to find out whether a person chose it.
  geocodePrecision GeocodePrecision? @map("geocode_precision")

  published Boolean @default(false)

  /// The first time this branch was shown to buyers, and never cleared.
  ///
  /// It exists to separate the two ways `published = false` can be true. A
  /// branch nobody has finished is a **draft**; one that was live and has been
  /// taken down is **hidden**. Board 3c states different consequences for them
  /// and board 3d acts on the difference — its branch picker offers a hidden
  /// branch, because its hours still matter when it comes back, and skips a
  /// draft, which has no buyers to make claims to.
  ///
  /// Derived rather than stored as a third status column, for the reason
  /// `isPinned` is derived from two floats: a status enum beside the boolean is
  /// a second answer to "can buyers see this", and the two would eventually
  /// disagree. `AreaPage` splits `publishedAt` from `firstPublishedAt` for the
  /// opposite reason — there, both dates are read, and here the boolean is the
  /// live state and this is only ever the durable half.
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  /// When this branch last changed, for the "Saved 20 seconds ago" line the
  /// onboarding step and the dashboard both carry.
  ///
  /// A per-row timestamp rather than one on the business, because board 2d
  /// autosaves a single field of a single branch and the header reports that
  /// save. A business-level stamp would move when any branch changed and would
  /// report the wrong branch's work as this one's.
  updatedAt DateTime @updatedAt @map("updated_at")

  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  area                Area              @relation(fields: [areaId], references: [id], onDelete: Restrict)
  producedByConflicts ClaimConflict[]   @relation("ConflictProducedLocation")
  contactReveals      ContactReveal[]
  teamMembers         TeamMember[]
  seats               User[]            @relation("SeatBranch")
  teamInvites         TeamInvite[]      @relation("InviteBranch")
  closures            LocationClosure[]

  @@index([businessId])
  @@index([areaId])
  @@index([emirate])
  @@map("location")
}

/// A public holiday, as the platform maintains it.
///
/// Board 3d's seventh correction: the rail mixed official UAE dates with the
/// seller's own `+ Add date` and distinguished neither, which is the same split
/// board 3e makes between documents we verify and documents a seller uploads.
/// These are ours. `LocationClosure` holds theirs.
///
/// **The promise attached to this table has an owner named in board 3d Q1**:
/// platform-maintained, two years ahead, reviewed each January. The card says
/// "Official UAE dates are kept current for you", and a commitment in shipped
/// copy that nobody owns is the shape board 4e Q2 already got wrong once.
///
/// National, not per-branch. Board 3d Q4 recommends per-branch *deviation* —
/// a trade counter can open on National Day when the head office does not —
/// and that is deliberately not built: no control on the screen offers it, and
/// it arrives later as a row per (location, holiday) rather than as a rebuild.
model PublicHoliday {
  id   String @id @default(cuid())
  name String

  /// Inclusive, both ends. Eid runs three or four days and is one row.
  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date

  /// A half day carries its hours, or it is not a setting the seller can see.
  ///
  /// Board 3d's sixth correction: Islamic New Year rendered a `Half day` pill
  /// and a date and nothing else. A CHECK ties the pair together, so a half day
  /// with no times cannot be stored — criterion 8.
  halfDay   Boolean @default(false) @map("half_day")
  openFrom  String? @map("open_from")
  openUntil String? @map("open_until")

  /// Islamic dates are estimates until they are announced, exactly as Ramadan's
  /// are. Eid follows the same moon sighting, so a row that claimed to know
  /// next year's date as fact would be wrong in the same way and just as
  /// quietly. Gregorian holidays — New Year's Day, National Day — are confirmed
  /// the moment they are entered.
  confirmed Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, startsOn])
  @@index([startsOn])
  @@map("public_holiday")
}

/// A stretch of days one branch is shut, or open shorter, because the seller
/// said so.
///
/// The seller's half of the holiday rail — `+ Add date`, and the footer's
/// "Dates you add are yours to maintain". Per branch, because the screen is,
/// and because a depot closing for stock-take says nothing about the showroom.
///
/// **Not the temporary closure.** That is `Location.closedFrom/closedUntil/
/// closureReason`, which shipped before this board, is rendered by board 1f and
/// is already constrained to refuse a half-set window. Board 3d's data table
/// asks for one `location_closures` holding both, and moving the temporary
/// closure here would be a drop beside an add — which
/// `docs/deployments.md` § Ordering says has no safe order and must be split in
/// two. One closure at a time per branch is also what §5 describes.
model LocationClosure {
  id         String @id @default(cuid())
  locationId String @map("location_id")

  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date

  /// Why, in the seller's words. Buyers read this on board 1f, so it is
  /// required for the same reason the temporary closure's is: a strip that says
  /// a branch is shut and not why is a strip that generates a phone call.
  reason String

  /// A half day rather than a closure. Same pair, same CHECK as `PublicHoliday`.
  openFrom  String? @map("open_from")
  openUntil String? @map("open_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, startsOn])
  @@map("location_closure")
}

/// Where a supplier says they deliver, and how fast.
///
/// Board 3c's fourth section, and the reason it is a table rather than a text
/// field: these rows drive `1h`'s RFQ routing and sit beside the `1b`/`1c`
/// facets a buyer filters on, so a typed area would match nothing and the
/// seller would never learn why the enquiries stopped. Board 2d already holds
/// the same rule one screen earlier — "no code path allows free-text area
/// entry".
///
/// Distinct from `Location.serviceRadiusKm`, which is not a duplicate of it.
/// A radius is geometry around one branch and answers "how far do you drive".
/// A coverage row is a named place and a promise, and it is what a buyer reads
/// and what a router matches. A supplier can have both, and most do: 40 km from
/// Al Quoz, and "Sharjah, next day" for the trade they run up the E311.
///
/// Per business, not per branch — board 3c Q3, matching what `1h` routes on
/// today. A Sharjah depot and an Abu Dhabi office plainly serve different
/// radii, and the day that matters this table grows a nullable `location_id`
/// rather than being rebuilt.
model BusinessCoverage {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  /// The scope, at its coarsest. Always set, including on an area row, where it
  /// is copied from the area — the same rule `Location` follows, written in one
  /// place in the service so the two cannot drift. It is here rather than only
  /// on the join so `1h` can match an emirate without one.
  emirate Emirate

  /// The area, or null for the whole emirate.
  ///
  /// Both scales are real and both come from the taxonomy. A supplier who
  /// delivers anywhere in Dubai should not have to name forty areas, and one
  /// who only serves Al Quoz should not have to claim the emirate.
  areaId String? @map("area_id")

  /// The promise, in hours. `0` is same day.
  ///
  /// An integer rather than a band enum because a band is a rendering of this
  /// and not a fact about it: "24h" and "next day" are the same promise written
  /// twice, and a new band would otherwise be a migration. The screen offers a
  /// fixed set of values; the column stores what was chosen.
  leadTimeHours Int @map("lead_time_hours")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  area     Area?    @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([emirate])
  @@index([areaId])
  @@map("business_coverage")
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — no price, at any tier, on any surface
// ─────────────────────────────────────────────────────────────────────────────

enum Availability {
  in_stock
  made_to_order
  indent
  out_of_stock

  @@map("availability")
}

enum ProductStatus {
  draft
  live
  out_of_stock

  @@map("product_status")
}

model Product {
  id             String        @id @default(cuid())
  businessId     String        @map("business_id")
  name           String
  slug           String
  sku            String?
  categoryId     String        @map("category_id")
  availability   Availability
  stockQty       Int?          @map("stock_qty")
  /// When the stock number was last stated, not when the row last changed.
  ///
  /// Board 1e shows a quantity only while it is under thirty days old, and
  /// `updatedAt` cannot answer that: it moves when a seller fixes a typo in the
  /// description, which says nothing about whether 240 units are still on the
  /// shelf. A stale number is worse than no number — "In stock" is honest and
  /// "240 units" from March is a promise the seller never made.
  ///
  /// Null means the count has never been dated, which is read as stale.
  stockUpdatedAt DateTime?     @map("stock_updated_at")
  leadTimeDays   Int?          @map("lead_time_days")
  minOrderQty    Int?          @map("min_order_qty")
  /// Keyed by SpecField id. Normalised size tokens land in searchText so a
  /// DN100 query finds a product the seller typed as 4".
  specValues     Json          @default("{}") @map("spec_values")
  /// Denormalised match surface: name, sku, spec values and every size synonym.
  searchText     String?       @map("search_text")
  description    String?
  status         ProductStatus @default(draft)
  /// Which import created this row, so a run can be undone without guessing.
  importRunId    String?       @map("import_run_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // NO price. NO currency. NO tier pricing. Prices live on quote_line only.
  // The CSV importer is the widest path into this table and refuses a price
  // column outright — see lib/import/columns.ts.

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  importRun     ImportRun?        @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  importChanges ImportRunChange[]
  viewDays      ProductViewDay[]
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media         ProductMedia[]
  documents     ProductDocument[]
  quoteLines    QuoteLine[]
  enquiryLines  EnquiryLine[]
  alerts        ProductAlert[]
  /// Buyers waiting for this one to come back into stock.
  watches       ProductAlert[]    @relation("ProductWatch")
  questions     ProductQuestion[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([categoryId])
  @@index([availability])
  /// Trigram, not full text. A buyer types DN100 or 4" and means an exact
  /// substring of a machine string; a stemmer helps with neither, and 4" is
  /// not a legal tsquery. Declared here rather than only in raw SQL so
  /// `migrate diff` stops reading it as drift and generating a DROP.
  @@index([importRunId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("product")
}

/// A buyer's question about one product, and the seller's answer.
///
/// Board 1g's "Ask the seller" card renders one answered question verbatim and
/// counts the rest. Verbatim matters: a paraphrase would be the platform
/// speaking for a supplier about their own goods, and the value of the card is
/// that another buyer already asked the thing you are about to.
///
/// Only an answered, unremoved question is public. An unanswered one is a lead
/// for the seller, not content for the page — a page full of unanswered
/// questions reads as a supplier who ignores people, and that is a claim we
/// would be making on their behalf out of an absence.
///
/// Moderation mirrors `Review`: `removedAt` with a `removalReason`, staff only,
/// audited. Same shape because it is the same decision, and a second mechanism
/// would be a second place for a removal to be forgotten.
model ProductQuestion {
  id         String  @id @default(cuid())
  productId  String  @map("product_id")
  businessId String  @map("business_id")
  /// Null for a buyer with no account. An enquiry needs no signup and neither
  /// does a question — requiring one before the first ask is how a card like
  /// this ends up with nothing in it.
  askerId    String? @map("asker_id") @db.Uuid
  body       String

  answer     String?
  answeredAt DateTime? @map("answered_at")
  /// The seat that answered. For the seller's own record, never shown to buyers.
  answeredBy String?   @map("answered_by") @db.Uuid

  removedAt     DateTime? @map("removed_at")
  removalReason String?   @map("removal_reason")

  createdAt DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  asker    User?    @relation(fields: [askerId], references: [id], onDelete: SetNull)

  /// The public read: answered, not removed.
  @@index([productId, removedAt, answeredAt])
  /// The seller's queue: unanswered, oldest first.
  @@index([businessId, answeredAt])
  @@map("product_question")
}

enum MediaKind {
  logo
  cover
  gallery
  product
  review
  storefront
  /// Vestigial. It held site-visit photographs, and site visits were withdrawn
  /// — nothing writes this kind and no surface renders it. The label survives
  /// because Postgres cannot drop an enum value without recreating the type and
  /// rewriting every row of `media`, which is a table rewrite in exchange for
  /// tidiness. Do not reuse it for anything else; a kind that once meant
  /// evidence in a private bucket is not a kind to hand new content.
  visit
  /// Held in the library and placed on nothing. Board 3b's unpick.
  ///
  /// Every other kind names a surface, which made "in the library but not on
  /// the storefront" a state the model could not hold: `lib/media/references.ts`
  /// counts any non-product file as a storefront reference, so a photograph a
  /// seller removed from their listing had nowhere to go that did not either
  /// keep it on the page or claim it belonged to a product.
  ///
  /// Removing a photograph on `/dashboard/listing` moves it here. The file, its
  /// alt text, its folder and its dimensions are untouched — board 3b
  /// criterion 7: unpicking is not deleting, and deleting is `3i`'s action with
  /// `3i`'s blast-radius warning in front of it.
  library

  @@map("media_kind")
}

model Media {
  id          String    @id @default(cuid())
  kind        MediaKind
  /// Supabase Storage object path. The bucket is not in Prisma's schema.
  storagePath String    @map("storage_path")
  /// The name of the file as the seller's computer had it.
  ///
  /// `Document` has carried one since handoff 1 and `Media` did not, which made
  /// the two halves of one library answer "what is this file called?" two
  /// different ways. Board 11d needs them to agree, because a CSV column of
  /// filenames is matched against both.
  ///
  /// It cannot be derived from `storagePath`. `safeName` in
  /// `lib/storage/buckets.ts` lowercases, replaces punctuation and appends six
  /// random characters — deliberately, because two uploads called `photo.jpg`
  /// are the normal case and the second must not replace the first. So
  /// `BF-100 (1).JPG` is stored as `bf-100-1-x7k2m9.jpg`, and a mapper matching
  /// on the stored path resolves nothing while reporting it as nothing matching
  /// rather than as the wrong question asked.
  ///
  /// Null on every row uploaded before 11d. The backfill puts the stored
  /// basename here so those files still match something, and
  /// `lib/import/filenames.ts` reconciles the two forms.
  filename    String?
  alt         String?
  /// Pixels, measured in the browser before upload. Board 8b writes these.
  ///
  /// They existed and nothing ever wrote them, which is why the long-edge
  /// floor could not be enforced: a 300px thumbnail of a logo went up as a
  /// warehouse photograph and the storefront stretched it. The measurement is
  /// free — the same canvas that resizes the file to fit under a megabyte has
  /// already decoded it.
  width       Int?
  height      Int?
  /// Bytes as stored. Asserted by the client, bounded by the bucket.
  bytes       Int?
  /// Which suggested slot the seller filed this under. Board 8b.
  ///
  /// A prompt, never a required field: "Your team at work", "Delivery
  /// vehicle". It is what gives a photograph a name on the grid instead of
  /// `IMG_4471.jpg`, and it is what the green line under a tile describes —
  /// the **slot's** static copy, not an assessment of the pixels. Nothing in
  /// this build looks at image content, and the two must not converge: see
  /// docs/inferred.md, board 8b.
  slotKey     String?   @map("slot_key")
  /// Position in the storefront gallery. Drag to reorder on board 8b.
  ///
  /// Two production queries have ordered by this since handoff 1 while nothing
  /// but the seed ever wrote it, so every real seller's photographs tied at
  /// zero and came back in insertion order by accident.
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  businessId String? @map("business_id")
  reviewId   String? @map("review_id")
  /// Which of the seller's folders this file sits in. Null is `Unfiled`.
  ///
  /// Board 3i §2: every file is in exactly one folder and the counts sum to the
  /// header total. `Unfiled` is the null case rather than a row, so there is no
  /// state in which a file is in two folders — the board listed `Unused 41` as
  /// a sixth folder, which put 41 files in `Product shots` and in `Unused` at
  /// once. Unreferenced is a **state**, computed; this is a folder.
  folderId   String? @map("folder_id")

  business Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review   Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  /// Every product this file appears on. Many-to-many since board 3i.
  ///
  /// It was `productId`, one nullable column, so a photograph belonged to at
  /// most one product and the same image had to be uploaded again for the next
  /// size in the range. One file, many products, stored once — and both the
  /// gallery order and which image is primary live on the join, because they
  /// are facts about a file *on a product*, not about the file.
  products    ProductMedia[]
  teamMembers TeamMember[]

  @@index([businessId])
  /// The grid, in order. Board 8b reads exactly this.
  @@index([businessId, kind, sortOrder])
  @@index([folderId])
  @@map("media")
}

/// A seller edit, for the recent-changes list on board 3b's rail.
///
/// **Not the audit log.** `AuditEvent` records *decisions* — a staff member
/// changing something they do not own, with a written reason and a NOT NULL
/// `actorId` that is theirs. A seller editing their own description is not a
/// decision anybody has to answer for, and filing it there would dilute the one
/// table whose whole value is that every row in it is a staff action somebody
/// can be asked about. Non-negotiable 3 covers staff state changes; this is the
/// other kind.
///
/// So: a short, seller-visible trail of who changed what and when, which board
/// 3b's rail shows three of. The full history a moderator reads is still `4i`'s
/// audit rows for the fields that pass through moderation.
///
/// No before/after values. The rail says "Description · S. Menon · 2 H", and
/// storing the old prose to render a line that never shows it would be keeping
/// a copy of every description a seller has ever written for no reader.
model ListingRevision {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  /// Who saved it. `Restrict`, because a revision naming nobody is not a
  /// revision — the line the rail draws is "what changed, and by whom".
  actorId    String   @map("actor_id") @db.Uuid
  /// The field group as the seller would name it: `description`, `photos`,
  /// `payment_terms`. Rendered through the catalogue, never shown raw.
  field      String
  /// How many items the save touched, where that is the fact worth showing —
  /// "Photos ×6". Null where the field is singular.
  itemCount  Int?     @map("item_count")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User     @relation("ListingRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  /// The rail reads exactly this: one business, newest first.
  @@index([businessId, createdAt])
  @@map("listing_revision")
}

/// A seller's own folder. Board 3i §2.
///
/// Named by the seller — the render's six are one seller's choices, not a fixed
/// set. `Unfiled` is not a row: it is `folderId IS NULL`, which is what keeps
/// "every file is in exactly one folder" true without a default folder that
/// could be renamed or deleted out from under it.
model MediaFolder {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  media     Media[]
  documents Document[]

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
  @@map("media_folder")
}

/// One image on one product. Board 3i's reference model.
///
/// `sortOrder` is the gallery order board 1g renders, and **position 0 is the
/// primary image** — there is no separate `isPrimary` flag, because a flag and
/// an order are two sources of truth for the same fact and they drift. Board
/// 3i's acceptance criterion 8 is that the primary is settable and 1g's order
/// matches it; one column satisfies both by construction.
model ProductMedia {
  productId String @map("product_id")
  mediaId   String @map("media_id")
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([mediaId])
  /// The gallery, in order.
  @@index([productId, sortOrder])
  @@map("product_media")
}

/// One document on one product — a datasheet or certificate covering a range.
///
/// Board 3g Q4, answered on 3i: documents are shared and referenced, never
/// copied per product. A UL certificate covers a whole range, and the board was
/// already rendering `ds-bf-valve.pdf · 4 products` without a model that
/// allowed it.
model ProductDocument {
  productId  String @map("product_id")
  documentId String @map("document_id")
  sortOrder  Int    @default(0) @map("sort_order")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([productId, documentId])
  @@index([documentId])
  @@map("product_document")
}

enum DocumentKind {
  trade_licence
  vat_certificate
  datasheet
  catalogue
  certificate
  enquiry_attachment

  @@map("document_kind")
}

model Document {
  id          String       @id @default(cuid())
  kind        DocumentKind
  storagePath String       @map("storage_path")
  filename    String
  bytes       Int?
  mimeType    String?      @map("mime_type")
  createdAt   DateTime     @default(now()) @map("created_at")

  /// Listed on the public storefront. The **file never is**.
  ///
  /// Board 1d: "Certificates list name and validity month only, never the
  /// document." A trade licence PDF carries the licence number, the manager's
  /// name and often a signature; an ISO certificate carries the auditor's
  /// reference. Publishing that a supplier holds ISO 9001 until March 2027 is
  /// useful to a buyer, and publishing the scan is handing over a forgeable
  /// original. So this flag governs the *row*, and `storagePath` stays behind
  /// the signed-URL route in every case.
  ///
  /// Defaults to false. A document becomes public because somebody said so,
  /// never because it was uploaded.
  isPublic     Boolean   @default(false) @map("is_public")
  /// What a buyer would call it — "ISO 9001:2015", not "scan_0043_final.pdf".
  ///
  /// `filename` is whatever came off the seller's desktop and is not fit to
  /// render. Null means the row has never been prepared for the public list,
  /// which is another reason it is not on it.
  displayName  String?   @map("display_name")
  /// Validity, rendered to the month.
  ///
  /// The board asks for the month rather than the day on purpose: a certificate
  /// that expires "March 2027" is the fact a buyer needs, and a precise date
  /// invites a page that looks wrong for the twenty-four hours around it. Null
  /// for documents that do not expire.
  validUntil   DateTime? @map("valid_until")
  /// The credential's own number — `CD-DXB-8842`, an ISO certificate number.
  ///
  /// Board 3e §4 gives the uploaded-by-you table a `NUMBER` column, and the
  /// number is how a buyer's compliance officer matches a certificate against a
  /// register they already hold. It is the seller's to type, because we do not
  /// check it: nothing in the platform validates this against an issuing body,
  /// and the `Uploaded by you` heading is what says so.
  ///
  /// Never on the licence or the TRN rows. Those two read their numbers off
  /// `Business.licenceNumber` and `Business.trn`, which are licence-locked.
  reference    String?
  /// When a moderator last looked at this document. Null means never.
  ///
  /// Board 3e §4's third state: a credential the seller has asked to publish
  /// shows `In review · 2 working days` and stays off the storefront until
  /// somebody has looked. The gate is `isPublic AND reviewedAt IS NOT NULL`,
  /// checked in `lib/storefront/loader.ts` — two facts, because they are two
  /// different people's decisions and collapsing them into one column means
  /// either the seller can publish unreviewed or a moderator can publish
  /// something the seller wanted hidden.
  ///
  /// It is not a claim that the certificate is true. Nothing here is checked
  /// against an issuing authority — that is the whole distinction the screen
  /// draws between `Verified by us` and `Uploaded by you`, and a review that
  /// confirmed a certificate would erase it. What a moderator decides is
  /// whether the file is the document it says it is and fit for a public page.
  reviewedAt   DateTime? @map("reviewed_at")
  /// Written by staff on a decision. Non-negotiable 3 — the audit row carries
  /// the same words, and this is the copy the seller reads on the row.
  reviewReason String?   @map("review_reason")

  businessId String? @map("business_id")
  enquiryId  String? @map("enquiry_id")
  /// The seller's folder. Null is `Unfiled`. See `Media.folderId`.
  folderId   String? @map("folder_id")

  business         Business?                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enquiry          Enquiry?                 @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  folder           MediaFolder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  /// Every product citing this document. Many-to-many since board 3i.
  products         ProductDocument[]
  claims           ClaimSubmission[]
  catalogueImports CatalogueImportRequest[]
  quoteAttachments QuoteAttachment[]

  @@index([businessId])
  @@index([enquiryId])
  @@index([folderId])
  /// The storefront's certificates block reads exactly this.
  @@index([businessId, isPublic])
  /// The moderation queue: everything a seller has asked to publish and nobody
  /// has looked at, oldest first, so the two-working-day SLA is readable.
  @@index([isPublic, reviewedAt, createdAt])
  @@map("document")
}

// ─────────────────────────────────────────────────────────────────────────────
// The enquiry spine
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentTerms {
  advance
  cod
  net_15
  net_30
  net_60
  lc

  @@map("payment_terms")
}

enum RecipientState {
  delivered
  opened
  quoted
  declined
  no_response

  @@map("recipient_state")
}

enum QuoteStatus {
  draft
  sent
  read
  accepted
  lost
  expired

  @@map("quote_status")
}

model Enquiry {
  id             String        @id @default(cuid())
  /// ENQ-8841
  ref            String        @unique
  buyerId        String        @map("buyer_id") @db.Uuid
  buyerCompanyId String?       @map("buyer_company_id")
  requirement    String
  deliverToArea  String?       @map("deliver_to_area")
  /// Where the goods are going, as the buyer picked it on the composer.
  ///
  /// Board `3l`'s fourth panel. The RFQ form has always collected this and
  /// `lib/enquiry/fanout.ts` has always routed on it — *"same emirate is a real
  /// delivery difference in the UAE, not a nicety"* — and the write threw it
  /// away, keeping only the free-text `deliverToArea` beside it. So the one
  /// piece of first-party geography the buyer actually states was the one thing
  /// not stored.
  ///
  /// Nullable, and the null is a real answer: *Not stated*. The alternative
  /// offered for this panel was a country guessed from the buyer's IP, which is
  /// a claim rather than a measurement — and a directory whose only asset is
  /// that its numbers are true does not guess where a customer is.
  emirate        Emirate?
  neededBy       DateTime?     @map("needed_by")
  termsWanted    PaymentTerms? @map("terms_wanted")
  closesAt       DateTime      @map("closes_at")

  /// Board 1i: editing a requirement creates a revision, never a silent edit.
  ///
  /// A seller who has already priced 40 valves must not find the quantity
  /// changed underneath their quote. So the number goes up, recipients who have
  /// not quoted receive the new text, and the ones who have are told and their
  /// quote is marked superseded — they may re-quote against R2.
  ///
  /// The buyer sees `REVISED 2 SEP · R2` under the header. `revisedAt` is null
  /// on R1, which is every enquiry that was sent once and left alone.
  revision                    Int       @default(1)
  revisedAt                   DateTime? @map("revised_at")
  /// Set only on acceptance. Releases contact to exactly one business.
  contactReleasedToBusinessId String?   @map("contact_released_to_business_id")
  contactReleasedAt           DateTime? @map("contact_released_at")
  createdAt                   DateTime  @default(now()) @map("created_at")

  /// Criterion 9. Where this enquiry came from, if the buyer arrived through a
  /// campaign or a tagged link.
  ///
  /// Three columns rather than a blob, because the console groups by them and
  /// a JSON key is not an index. `utm_content` and `utm_term` are deliberately
  /// not stored: nothing reports on them, and an attribution column nobody
  /// reads is personal data kept for no reason.
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  /// The campaign landing page they arrived on, where it was one of ours.
  campaignId  String? @map("campaign_id")

  buyer          User               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerCompany   BuyerCompany?      @relation(fields: [buyerCompanyId], references: [id], onDelete: SetNull)
  lines          EnquiryLine[]
  /// 1..8 businesses.
  recipients     EnquiryRecipient[]
  missedBy       MissedEnquiry[]
  attachments    Document[]
  quotes         Quote[]
  messages       Message[]
  review         Review?
  reviewRequests ReviewRequest[]
  campaign       Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([buyerId])
  @@index([closesAt])
  /// The console groups by campaign and by source. Both are reads over the
  /// whole table with a date range, which is exactly what this is for.
  @@index([utmCampaign, createdAt])
  /// Board 11c `B7`: who a seller may ask for a review.
  ///
  /// "Confirm the acceptance timestamp is stored and queryable per buyer" — it
  /// was stored and it was not queryable. The eligible-buyer read filters on
  /// both of these columns together and ran as a sequential scan over every
  /// enquiry on the platform, on a page a seller opens to find two names.
  @@index([contactReleasedToBusinessId, contactReleasedAt])
  @@map("enquiry")
}

model EnquiryLine {
  id                 String   @id @default(cuid())
  enquiryId          String   @map("enquiry_id")
  /// What the buyer was looking at when they asked, where they were looking at
  /// anything. Nullable because most enquiries start from a search rather than
  /// a product, and because every row written before this column existed has
  /// no answer — the RFQ tray had the id and put it in the description.
  ///
  /// Added now, while the table is small, so "auto-pick most-enquired" on the
  /// featured-products section has something to rank on later. Until there are
  /// enough rows, that section is manual-pick and says so.
  productId          String?  @map("product_id")
  description        String
  qty                Int
  unit               String?
  /// What the buyer hopes to pay, per unit. Optional, private to this enquiry
  /// and its recipients, and never on a public surface. It is the buyer's own
  /// budget rather than a supplier's price for goods, which is why it sits
  /// here and not anywhere near Product.
  targetUnitPriceAed Decimal? @map("target_unit_price_aed") @db.Decimal(12, 2)
  /// Free text as the buyer wrote it, e.g. `DN100` or `4"`.
  size               String?
  sortOrder          Int      @default(0) @map("sort_order")

  enquiry    Enquiry     @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  /// `SetNull`, not `Cascade`. A seller deleting a product must not delete the
  /// buyer's enquiry line — what they asked for still happened.
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  quoteLines QuoteLine[]

  @@index([enquiryId])
  @@index([productId], map: "enquiry_line_product_idx")
  @@map("enquiry_line")
}

/// A supplier the fan-out left out, and why.
///
/// Deliberately not a `RecipientState` on EnquiryRecipient. That table means
/// "this business received this enquiry", and a capped seller did not: every
/// query that filters on state — the leads inbox, the nav badges, the
/// response-time median — would silently start counting a delivery that never
/// happened unless each one remembered to exclude it.
///
/// It is also the structural half of rule 1. There is no buyer relation here at
/// all, so the missed-enquiry list on board 11a can show the requirement and
/// the date and has no column to leak a name from.
/// One CSV upload, and everything needed to undo it.
///
/// Criterion 7 gives a seller twenty-four hours to reverse an import. That is
/// only possible if the rows a run created are identifiable, which is what
/// `Product.importRunId` is for — counting backwards from a timestamp would
/// also catch anything the seller typed by hand in the same minute.
///
/// `columnPlan` is the mapping as it was actually applied, not as it was
/// offered. It is what the reversal screen shows and what "save this mapping
/// for next month" copies from, and keeping the applied version means a
/// mapping that was overridden at the last moment cannot come back different.
model ImportRun {
  id           String    @id @default(cuid())
  businessId   String    @map("business_id")
  actorId      String    @map("actor_id") @db.Uuid
  filename     String
  /// Rows in the file, including ones that were skipped.
  rowCount     Int       @map("row_count")
  /// Products actually created.
  createdCount Int       @map("created_count")
  /// Products that already existed, were matched by SKU, and were rewritten.
  ///
  /// Board 11d §4 asserts `new + updated + errors == rows`, which is only an
  /// assertion if all three are stored. The board rendered the sum from
  /// constants.
  updatedCount Int       @default(0) @map("updated_count")
  /// Rows that could not import at all, for the same sum.
  errorCount   Int       @default(0) @map("error_count")
  /// How many of the created products the plan had room to list.
  ///
  /// Separate from `createdCount`, because the difference between them is the
  /// whole of §4's cap outcome: on Free 412 rows import, ten list, and the rest
  /// are stored unlisted. One count cannot say that.
  listedCount  Int       @default(0) @map("listed_count")
  columnPlan   Json      @map("column_plan")
  /// Set when the seller reverses it. A reverted run is kept, not deleted.
  revertedAt   DateTime? @map("reverted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  products Product[]
  changes  ImportRunChange[]

  @@index([businessId, createdAt])
  @@map("import_run")
}

/// What a product looked like before an import overwrote it.
///
/// Board 11d §4: *"the 386 new products are unlisted and the 18 updated ones
/// return to their previous values."* The board promised a 24-hour rollback
/// without saying what it restored, which — on an import that rewrote 18 live
/// products — is the only part anyone needs. It is also the part that cannot be
/// reconstructed after the fact: `Product.importRunId` names what a run
/// **created**, and until this table nothing named what it **changed**.
///
/// One row per product a run rewrote, holding the fields an import is allowed
/// to touch. A snapshot, not a diff: a diff has to be applied against the row
/// as it stands, and the seller may have edited it since — which is exactly
/// when a rollback most needs to be predictable rather than clever.
model ImportRunChange {
  id            String   @id @default(cuid())
  importRunId   String   @map("import_run_id")
  productId     String   @map("product_id")
  /// The product's own columns and `specValues`, as they were.
  previous      Json
  /// The media ids attached before, in gallery order.
  ///
  /// Ordered, because board 3i settled that position 0 **is** the primary image
  /// and there is no separate flag. Restoring the set without the order would
  /// restore a different primary image, which is the one part of a product page
  /// a buyer sees first.
  previousMedia String[] @map("previous_media")
  createdAt     DateTime @default(now()) @map("created_at")

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([importRunId, productId])
  @@index([productId])
  @@map("import_run_change")
}

/// A column mapping the seller saved to use again.
///
/// Suppliers re-upload the same export from the same system every month. Making
/// them re-map thirty columns each time is how a catalogue stops being updated.
model ImportMapping {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  name       String
  categoryId String?   @map("category_id")
  columnPlan Json      @map("column_plan")
  createdAt  DateTime  @default(now()) @map("created_at")
  usedAt     DateTime? @map("used_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([businessId, name])
  @@index([businessId])
  @@map("import_mapping")
}

/// A change to a listing that a person has to look at before the public does.
///
/// Acceptance criterion 8: only trade name, category and licence details queue.
/// Photographs, hours, products and descriptions publish immediately.
///
/// The narrowness is the design, not a phase-one compromise. Everything a
/// seller edits is either something a buyer would be misled by if it were wrong
/// — the name over the door, what they sell, the licence that says they may —
/// or something the seller is simply the authority on. There are 41,000
/// listings; a queue that gates the second kind is a queue that never empties,
/// and a dashboard where nothing a seller does appears is a dashboard they stop
/// opening.
///
/// Handoff 4 builds the screens that drain this. Handoff 3 fills it correctly,
/// which is the half that has to be right first.
model ListingChangeRequest {
  id             String              @id @default(cuid())
  businessId     String              @map("business_id")
  actorId        String              @map("actor_id") @db.Uuid
  field          ModeratedField
  /// What it says now. Kept so the queue can show the change, not just the ask.
  beforeValue    String?             @map("before_value")
  afterValue     String              @map("after_value")
  status         ChangeRequestStatus @default(pending)
  /// Written by staff on approve or reject. NOT NULL is enforced by a check
  /// constraint on the decided rows — see the migration.
  decisionReason String?             @map("decision_reason")
  decidedById    String?             @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?           @map("decided_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor     User     @relation("ChangeRequestActor", fields: [actorId], references: [id], onDelete: Restrict)
  decidedBy User?    @relation("ChangeRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([businessId, status])
  @@map("listing_change_request")
}

/// The only fields that queue. Adding one is a product decision, and making it
/// an enum is what forces it to be one.
///
/// Board 3b Q1 made the fourth. An **additional** category is queued for the
/// same reason the primary one is: category membership is the join the enquiry
/// fan-out matches on and the facet buyers filter by, so adding one moves which
/// demand a listing receives and which area pages count it. It is the seller's
/// only self-serve route into a market they may not be licensed for.
///
/// `after_value` on this field carries a category id, and the listing keeps its
/// current categories until a moderator clears it — board 3b's own sentence,
/// "your listing stays live on its four current categories while this one is
/// checked".
enum ModeratedField {
  trade_name
  primary_category
  licence
  additional_category

  @@map("moderated_field")
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
  /// The seller changed their mind before anybody looked.
  withdrawn

  @@map("change_request_status")
}

/// How an incoming enquiry reaches a person.
///
/// Board 7d. Round-robin spreads them evenly between the sales seats;
/// by-branch sends each to the branch nearest the buyer; everyone-sees-
/// everything is the default because it is what a five-person supplier
/// actually wants, and the other two only start paying off at scale.
enum LeadRouting {
  round_robin
  by_branch
  everyone

  @@map("lead_routing")
}

/// A seat offered, before it is a seat taken.
///
/// Seats cost money and grant capabilities, so only the owner sends one —
/// `team.manage` is owner-only in lib/auth/capabilities.ts. The invite carries
/// the roles it will grant, so accepting cannot quietly grant more than was
/// offered.
model TeamInvite {
  id         String  @id @default(cuid())
  businessId String  @map("business_id")
  /// Where it goes, when it goes by email. Null for a mobile invitation.
  ///
  /// Nullable since board 8d. It was `String`, and the screen offers one box
  /// reading "Mobile or email" — a supplier's staff are reached on WhatsApp in
  /// this market, and an invitation that could only be emailed was one half of
  /// them would never see.
  email      String?
  /// E.164, normalised on the way in. Null for an email invitation.
  phone      String?
  /// Which branch this seat is scoped to. Null is every branch.
  ///
  /// Applied to `User.branchId` on acceptance, so the scope the owner chose
  /// while inviting is the scope the seat gets — rather than a second decision
  /// nobody remembers to make afterwards.
  branchId   String? @map("branch_id")

  roles       Role[]    @default([])
  invitedById String    @map("invited_by_id") @db.Uuid
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  /// When the last message actually went, for the once-an-hour resend limit.
  ///
  /// §6 asks for that limit server-side rather than only in the UI, and
  /// `createdAt` cannot answer it — a resend does not create a row.
  lastSentAt  DateTime? @map("last_sent_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Restrict)
  branch    Location? @relation("InviteBranch", fields: [branchId], references: [id], onDelete: SetNull)

  /// One outstanding invitation per contact, on whichever channel it uses.
  /// Re-inviting resends rather than stacking a second — §4, and the reason the
  /// send is idempotent.
  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@index([businessId])
  @@map("team_invite")
}

/// Waiting for a sponsored slot somebody else holds.
///
/// Board 11e: one slot per subcategory and emirate, not auctioned. Not
/// auctioned is the decision — an auction would put the supplier with the
/// deepest pockets at the top of every category, which is the thing this
/// directory exists not to be. So a queue, in the order people joined it.
model PlacementWaitlist {
  id         String    @id @default(cuid())
  businessId String    @map("business_id")
  categoryId String    @map("category_id")
  emirate    Emirate?
  createdAt  DateTime  @default(now()) @map("created_at")
  notifiedAt DateTime? @map("notified_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([businessId, categoryId, emirate], map: "placement_waitlist_business_category_emirate_key")
  @@index([categoryId, emirate, createdAt], map: "placement_waitlist_category_emirate_created_idx")
  @@map("placement_waitlist")
}

/// Somebody saying "this listing is mine".
///
/// Boards 2a and 2b. Two routes, both human-checked: a trade licence upload, or
/// a call to the number on the public licence record. The submission is taken
/// either way — including when somebody else has already claimed the listing,
/// because a conflicting claim is a thing staff need to see rather than a door
/// to close in front of the second person.
///
/// Nothing here moves `Business.claimStatus`. Handoff 4 builds the queue that
/// decides; handoff 3 fills it, and criterion 1 is about the seller getting all
/// the way to a dashboard without staff involvement — not about the claim being
/// approved without one.
/// Who the claimant says they are to the licensed entity.
///
/// Board 2b: "a claim from a `manager` with no power of attorney attached is a
/// different review path from a claim from the named owner." The value is not a
/// permission and grants nothing — it routes the review, and it is the first
/// thing a reviewer reads next to the name on the document.
enum ClaimantRole {
  owner
  partner
  manager
  /// The public relations officer, who in UAE practice holds the licence.
  pro
  authorised_signatory

  @@map("claimant_role")
}

model ClaimSubmission {
  id             String      @id @default(cuid())
  businessId     String      @map("business_id")
  claimantId     String      @map("claimant_id") @db.Uuid
  route          ClaimRoute
  /// The licence document, on the licence route.
  documentId     String?     @map("document_id")
  /// The number we would call, on the phone route. Taken from the public
  /// licence record, never typed by the claimant — that is the whole check.
  phone          String?
  /// True when somebody else already held it. Staff see both.
  contested      Boolean     @default(false)
  status         ClaimStatus @default(unclaimed)
  decidedAt      DateTime?   @map("decided_at")
  /// NOT NULL once decided, enforced by a check constraint in the migration.
  decisionReason String?     @map("decision_reason")
  createdAt      DateTime    @default(now()) @map("created_at")

  // ── Board 2b: who is claiming, and what the document says ────────────────
  /// The claimant's name as printed on the licence or the power of attorney.
  /// Not `User.fullName`: the account holder and the person named on the
  /// document are frequently different people, and the reviewer is matching the
  /// second one.
  claimantName String?       @map("claimant_name")
  claimantRole ClaimantRole? @map("claimant_role")

  /// What the claimant submitted, after any correction.
  ///
  /// Deliberately not written onto `Business`. `licenceNumber` and
  /// `licenceExpiry` there come from the licence register and are the record
  /// this claim is measured against; a claimant's assertion overwriting them
  /// before anybody has checked would let a claim edit the evidence it is being
  /// judged on.
  statedLicenceNumber String?   @map("stated_licence_number")
  statedLicenceExpiry DateTime? @map("stated_licence_expiry")

  /// What OCR read off the uploaded document, before the claimant touched it.
  ///
  /// Kept beside the stated values rather than replaced by a `corrected`
  /// boolean, because the pair is what a reviewer actually needs: a flag says
  /// somebody changed something, and these two say from what, to what. OCR on a
  /// licence photographed on a wall is unreliable, so a correction is normal —
  /// what matters is being able to see it. Null where OCR did not run or could
  /// not read the document.
  ocrLicenceNumber String?   @map("ocr_licence_number")
  ocrLicenceExpiry DateTime? @map("ocr_licence_expiry")
  /// 0..1, from the extractor. Null where nothing was extracted.
  ocrConfidence    Float?    @map("ocr_confidence")

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claimant     User            @relation("ClaimClaimant", fields: [claimantId], references: [id], onDelete: Cascade)
  document     Document?       @relation(fields: [documentId], references: [id], onDelete: Restrict)
  conflictsAsA ClaimConflict[] @relation("ConflictA")
  conflictsAsB ClaimConflict[] @relation("ConflictB")

  @@index([businessId, status])
  @@index([status, createdAt])
  @@map("claim_submission")
}

enum ClaimRoute {
  licence_upload
  phone_callback

  @@map("claim_route")
}

/// A half-finished onboarding step, so "Save & exit" is real.
///
/// Board 2b: "onboarding takes six minutes with the licence to hand and a
/// fortnight without it." The fortnight is the case this table exists for — a
/// supplier who starts on a phone in a warehouse, discovers the licence is with
/// the PRO, and comes back on Thursday. Losing what they typed is how that
/// supplier becomes a supplier who never finishes.
///
/// One row per person per listing, replaced wholesale on each save. It holds
/// only what the step's own form holds, never a decision: a draft is not a
/// claim, grants nothing, and is deleted the moment the step is submitted. The
/// step's own tables stay the record.
model OnboardingDraft {
  id         String @id @default(cuid())
  userId     String @map("user_id") @db.Uuid
  businessId String @map("business_id")
  /// Which step this belongs to — `claim`, `verify`, `profile`, `locations`,
  /// `plan`. A string rather than an enum: the funnel's shape is
  /// `lib/onboarding/service.ts`'s to change, and a migration per reordering
  /// would be a schema that fights the product.
  step       String

  /// The form, as typed. Never trusted on the way back in — every value is
  /// revalidated by the step's own service before it becomes a row.
  data Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User     @relation("OnboardingDraftUser", fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation("OnboardingDraftBusiness", fields: [businessId], references: [id], onDelete: Cascade)

  /// One draft per person, per listing, per step.
  @@unique([userId, businessId, step])
  /// The resume read, and the prune.
  @@index([updatedAt])
  @@map("onboarding_draft")
}

/// The four ways board 4c lets staff settle two licences on one premises.
///
/// `ClaimStatus` describes the listing and cannot describe the decision. Two of
/// these four create or restructure businesses, so the resolution has to name
/// what it produced or the audit row is unreadable a year later.
enum ClaimResolution {
  award_to_a
  award_to_b
  split_into_two
  merge_as_branches

  @@map("claim_resolution")
}

/// Two claims on one listing, and what staff did about it.
///
/// Opened by the claim service the moment a second undecided claim arrives on a
/// business, so the queue has a row rather than staff having to notice a pair.
model ClaimConflict {
  id                 String           @id @default(cuid())
  businessId         String           @map("business_id")
  submissionAId      String           @map("submission_a_id")
  submissionBId      String           @map("submission_b_id")
  resolution         ClaimResolution?
  resolvedById       String?          @map("resolved_by_id") @db.Uuid
  resolvedAt         DateTime?        @map("resolved_at")
  /// NOT NULL once resolved, paired by a CHECK in the migration.
  reason             String?
  /// The second listing a split created, or null for the two award outcomes.
  producedBusinessId String?          @map("produced_business_id")
  /// The branch a merge folded the loser into.
  producedLocationId String?          @map("produced_location_id")
  /// Buyers waiting on this listing when it was resolved — board 4c's argument
  /// for why the delay costs something. Recorded because it is only true at
  /// the moment somebody looked.
  buyersWaiting      Int              @default(0) @map("buyers_waiting")
  createdAt          DateTime         @default(now()) @map("created_at")

  business         Business        @relation("ConflictBusiness", fields: [businessId], references: [id], onDelete: Cascade)
  submissionA      ClaimSubmission @relation("ConflictA", fields: [submissionAId], references: [id], onDelete: Restrict)
  submissionB      ClaimSubmission @relation("ConflictB", fields: [submissionBId], references: [id], onDelete: Restrict)
  resolvedBy       User?           @relation("ConflictResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  producedBusiness Business?       @relation("ConflictProduced", fields: [producedBusinessId], references: [id], onDelete: SetNull)
  producedLocation Location?       @relation("ConflictProducedLocation", fields: [producedLocationId], references: [id], onDelete: SetNull)

  @@map("claim_conflict")
}

/// A licence-authority export, staged.
///
/// Nothing here publishes itself. A run parses, categorises what it can, queues
/// what it cannot and rejects the rest by countable reason — and then a person
/// approves it. Criterion 1 is that sequence, in that order.
model LicenceImportRun {
  id               String          @id @default(cuid())
  actorId          String          @map("actor_id") @db.Uuid
  /// Which authority's export. Free text: a new authority is a Tuesday.
  source           String
  filename         String
  status           IngestRunStatus @default(parsing)
  rowCount         Int             @default(0) @map("row_count")
  stagedCount      Int             @default(0) @map("staged_count")
  categorisedCount Int             @default(0) @map("categorised_count")
  queuedCount      Int             @default(0) @map("queued_count")
  rejectedCount    Int             @default(0) @map("rejected_count")
  /// NOT NULL once decided, paired by a CHECK in the migration.
  decisionReason   String?         @map("decision_reason")
  decidedAt        DateTime?       @map("decided_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  actor      User            @relation("IngestActor", fields: [actorId], references: [id], onDelete: Restrict)
  rows       StagedListing[]
  businesses Business[]

  @@index([status, createdAt(sort: Desc)], map: "licence_import_run_status_created_at_idx")
  @@map("licence_import_run")
}

enum IngestRunStatus {
  parsing
  staged
  approved
  discarded

  @@map("ingest_run_status")
}

enum StagedDisposition {
  ready
  needs_category
  rejected
  published

  @@map("staged_disposition")
}

/// The four grounds the README fixes. An enum rather than a string because they
/// are counted, and the counts are the screen.
enum RejectionGround {
  licence_expired_24_months
  no_readable_trade_name
  activity_out_of_scope
  address_outside_uae

  @@map("rejection_ground")
}

/// One row of a licence export, before it is a listing.
///
/// It cannot be staged into `Business`: slug is unique and NOT NULL,
/// `primaryCategoryId` is NOT NULL behind a RESTRICT FK, and the licence
/// columns are NOT NULL. A record whose category could not be inferred has
/// nowhere legal to sit there, which is the whole reason this table exists.
model StagedListing {
  id               String            @id @default(cuid())
  runId            String            @map("run_id")
  rowNumber        Int               @map("row_number")
  /// As it arrived, before we decided anything. Kept so a rejection can be
  /// argued with.
  raw              Json
  tradeName        String?           @map("trade_name")
  licenceNumber    String?           @map("licence_number")
  licenceAuthority String?           @map("licence_authority")
  licenceExpiry    DateTime?         @map("licence_expiry")
  emirate          String?
  areaName         String?           @map("area_name")
  activity         String?
  phone            String?
  /// Nullable, unlike on `Business`. That is the point of staging.
  categoryId       String?           @map("category_id")
  disposition      StagedDisposition @default(needs_category)
  rejectionGround  RejectionGround?  @map("rejection_ground")
  /// Set only when the run is approved and this row becomes a listing.
  businessId       String?           @map("business_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  run      LicenceImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  business Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@unique([runId, rowNumber], map: "staged_listing_run_row_key")
  @@index([runId, disposition], map: "staged_listing_run_disposition_idx")
  @@map("staged_listing")
}

enum MergeBand {
  /// Above 90%. Bulk-merging these is safe.
  certain
  /// 60 to 90%. A person decides — merging two genuinely separate companies
  /// destroys reviews, and this is the band where that happens.
  probable
  /// Below 60%. Not a match.
  unlikely

  @@map("merge_band")
}

/// Two listings that might be one company.
model MergeCandidate {
  id            String    @id @default(cuid())
  keepId        String    @map("keep_id")
  absorbId      String    @map("absorb_id")
  /// 0..1. Computed, never typed.
  score         Float
  band          MergeBand
  /// Which signals agreed, so the number can be argued with.
  signals       Json
  dismissedAt   DateTime? @map("dismissed_at")
  dismissedById String?   @map("dismissed_by_id") @db.Uuid
  dismissReason String?   @map("dismiss_reason")
  mergeId       String?   @map("merge_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  keep        Business       @relation("CandidateKeep", fields: [keepId], references: [id], onDelete: Cascade)
  absorb      Business       @relation("CandidateAbsorb", fields: [absorbId], references: [id], onDelete: Cascade)
  dismissedBy User?          @relation("CandidateDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)
  merge       BusinessMerge? @relation(fields: [mergeId], references: [id], onDelete: SetNull)

  @@map("merge_candidate")
}

/// One merge, and everything it moved.
///
/// The manifest is the point. Reversal replays it rather than recomputing —
/// by the time somebody unmerges, the surviving listing has rows of its own and
/// "everything belonging to the winner" is no longer the same set it was.
model BusinessMerge {
  id              String    @id @default(cuid())
  keepId          String    @map("keep_id")
  absorbId        String    @map("absorb_id")
  actorId         String    @map("actor_id") @db.Uuid
  reason          String
  manifest        Json
  /// The address the absorbed listing had, so a reversal can put it back.
  absorbedSlug    String    @map("absorbed_slug")
  reversibleUntil DateTime  @map("reversible_until")
  reversedAt      DateTime? @map("reversed_at")
  reverseReason   String?   @map("reverse_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  keep       Business         @relation("MergeKeep", fields: [keepId], references: [id], onDelete: Restrict)
  absorb     Business         @relation("MergeAbsorb", fields: [absorbId], references: [id], onDelete: Restrict)
  actor      User             @relation("MergeActor", fields: [actorId], references: [id], onDelete: Restrict)
  candidates MergeCandidate[]

  @@index([absorbId], map: "business_merge_absorb_idx")
  @@map("business_merge")
}

enum PdplKind {
  access
  erasure
  correction

  @@map("pdpl_kind")
}

enum PdplState {
  received
  in_progress
  fulfilled
  refused

  @@map("pdpl_state")
}

/// A person asking what we hold about them, or asking us to delete it.
///
/// The due date is the law's rather than ours, and it is stored rather than
/// computed so changing the window cannot silently reopen closed requests.
model PdplRequest {
  id            String    @id @default(cuid())
  kind          PdplKind
  state         PdplState @default(received)
  /// Where we can identify them. A request can arrive by email from somebody
  /// whose account we cannot find, and refusing to record it because the FK
  /// will not resolve is how a legal deadline gets missed.
  subjectUserId String?   @map("subject_user_id") @db.Uuid
  subjectEmail  String?   @map("subject_email")
  subjectPhone  String?   @map("subject_phone")
  detail        String
  dueAt         DateTime  @map("due_at")
  closedAt      DateTime? @map("closed_at")
  closedById    String?   @map("closed_by_id") @db.Uuid
  /// NOT NULL once closed. A refusal in particular has to say why.
  outcomeReason String?   @map("outcome_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  subjectUser User? @relation("PdplSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  closedBy    User? @relation("PdplClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@map("pdpl_request")
}

/// The only way anything outside this codebase reads our data.
///
/// The secret is never stored — a hash is, and the plaintext is shown once at
/// issue and never again. A key we can read is a key that leaks with a database
/// dump, and "we can resend it" is the reason every key ends up in an email.
model ApiKey {
  id           String    @id @default(cuid())
  name         String
  /// The first characters, so two keys can be told apart on screen.
  prefix       String
  secretHash   String    @map("secret_hash")
  /// An empty list is a key that can do nothing, which is the safer default.
  scopes       String[]  @default([])
  createdById  String    @map("created_by_id") @db.Uuid
  lastUsedAt   DateTime? @map("last_used_at")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at")

  createdBy User @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([secretHash])
  @@map("api_key")
}

/// A staff member looking through a seller's eyes.
///
/// Criterion 8: read-only, expires at 30 minutes, writes an audit row naming
/// the ticket. A row rather than a cookie claim, because the cap has to be a
/// fact the server checks rather than a number the browser was told.
model ViewAsSession {
  id         String    @id @default(cuid())
  staffId    String    @map("staff_id") @db.Uuid
  businessId String    @map("business_id")
  /// NOT NULL. Looking through a seller's eyes without a reason is the thing
  /// §07 calls a privacy event, and "which ticket" is the reason.
  ticketRef  String    @map("ticket_ref")
  startedAt  DateTime  @default(now()) @map("started_at")
  expiresAt  DateTime  @map("expires_at")
  endedAt    DateTime? @map("ended_at")

  staff    User     @relation("ViewAsStaff", fields: [staffId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, startedAt(sort: Desc)], map: "view_as_session_business_idx")
  @@map("view_as_session")
}

enum CallOutcomeKind {
  reached
  no_answer
  wrong_number
  not_interested
  call_back
  converted

  @@map("call_outcome_kind")
}

/// What happened on a call.
///
/// The call *list* is deliberately not a table — board 12d says it builds itself
/// from demand signals, and "no manual entry" is a property you get by having
/// nowhere to type. Only the outcome is written down.
model CallOutcome {
  id         String          @id @default(cuid())
  businessId String          @map("business_id")
  staffId    String          @map("staff_id") @db.Uuid
  kind       CallOutcomeKind
  /// Which signal put them on the list, so the argument that worked can be told
  /// from the one that did not.
  signal     String
  note       String?
  callBackAt DateTime?       @map("call_back_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    User     @relation("CallStaff", fields: [staffId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt(sort: Desc)], map: "call_outcome_business_idx")
  @@map("call_outcome")
}

model MissedEnquiry {
  enquiryId  String     @map("enquiry_id")
  businessId String     @map("business_id")
  reason     SkipReason
  createdAt  DateTime   @default(now()) @map("created_at")

  enquiry  Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([enquiryId, businessId])
  @@index([businessId, createdAt])
  @@map("missed_enquiry")
}

/// Why a supplier was left off an enquiry. Only one reason today; it is an enum
/// because "we ran out of slots" and "you were suspended" are different
/// arguments to make to a seller, and board 11a's whole job is making one.
enum SkipReason {
  at_monthly_cap

  @@map("skip_reason")
}

/// What the seller says happened to a lead. Board 3j's `Mark won` / `Mark lost`.
///
/// Two members and no `open`: absence is open, so a lead cannot be in an
/// outcome state and an open one at the same time.
enum LeadOutcome {
  won
  lost

  @@map("lead_outcome")
}

model EnquiryRecipient {
  enquiryId      String         @map("enquiry_id")
  businessId     String         @map("business_id")
  state          RecipientState @default(delivered)
  openedAt       DateTime?      @map("opened_at")
  /// Enquiry-to-first-reply is what response time is measured from. Never a
  /// seller-editable field.
  firstReplyAt   DateTime?      @map("first_reply_at")
  /// The BUYER's one nudge — board 10g, a supplier who has not answered.
  ///
  /// Named for its actor since boards 3j/11b. It and the seller's follow-up
  /// shared one column, through two services that could not see each other:
  /// lib/enquiry/nudge.ts writes this one, lib/messaging/service.ts wrote the
  /// same column for the opposite direction. A buyer prodding a silent supplier
  /// therefore spent the supplier's one-ever follow-up, and 11b's rail rendered
  /// "Follow-up sent" for a message nobody had sent.
  buyerNudgedAt  DateTime?      @map("nudged_at")
  /// The SELLER's one follow-up, 24 hours after their last message.
  ///
  /// Board 11b: a second loses more deals than it wins, so this is a timestamp
  /// rather than a count. The schema cannot express "three nudges", so no
  /// future screen can offer them.
  sellerNudgedAt DateTime?      @map("seller_nudged_at")
  /// When the scheduled follow-up is due, and the words it will carry.
  ///
  /// The body is stored rather than composed at send time because 11b requires
  /// the draft to be editable *before* it goes: text the job wrote at midnight
  /// is text the seller never saw. Null due date means nothing is scheduled,
  /// which is also what cancelling looks like.
  nudgeDueAt     DateTime?      @map("nudge_due_at")
  nudgeBody      String?        @map("nudge_body")

  /// The seat this lead is routed to. Null is the ordinary state.
  ///
  /// `Business.leadRouting` has been stored since the init migration and applied
  /// nowhere, because there was no column to route *to*. Board 7d's `everyone`
  /// mode means unassigned, and a default assignee would quietly make one seat
  /// answerable for a queue the whole team is meant to see.
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  assignedAt   DateTime? @map("assigned_at")
  assignedById String?   @map("assigned_by_id") @db.Uuid

  /// When the router ran on this lead. Null on every row written before board
  /// 7d, and on every lead that arrived while routing was off.
  routedAt       DateTime?       @map("routed_at")
  /// Set when the router ran and found nobody. Mutually exclusive with an
  /// assignee, enforced by a check constraint — it cannot have both placed the
  /// lead and failed to.
  unroutedReason UnroutedReason? @map("unrouted_reason")

  /// What the SELLER says happened, which is not what the buyer's acceptance
  /// says.
  ///
  /// `Quote.status` accepted/lost and `state = declined` are all written by the
  /// buyer accepting somebody. A seller marking a lead lost must not write a
  /// status the buyer's tracking page reads as "this supplier was beaten", and
  /// marking one won must not imply a contact release that never happened.
  ///
  /// It carries no amount. Board 3j asks for a seller-reported figure; CLAUDE.md
  /// lists quoted value among the derived metrics that have no writable path,
  /// and `Business.quotedValueAed` is already a column nothing reads or writes.
  outcome       LeadOutcome?
  outcomeAt     DateTime?    @map("outcome_at")
  outcomeById   String?      @map("outcome_by_id") @db.Uuid
  /// Only meaningful on a loss, and never required — a seller who does not know
  /// why they lost must still be able to close the row, and a mandatory reason
  /// is answered with a full stop.
  outcomeReason String?      @map("outcome_reason")

  createdAt DateTime @default(now()) @map("created_at")

  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy User?    @relation("LeadAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  outcomeBy  User?    @relation("LeadOutcomeAuthor", fields: [outcomeById], references: [id], onDelete: SetNull)

  @@id([enquiryId, businessId])
  @@index([businessId, state])
  /// The rail's default read: this business, this tab, oldest first in a band.
  @@index([businessId, state, createdAt], map: "enquiry_recipient_inbox_idx")
  /// Free to omit while nothing wrote an assignee. The first business to turn
  /// routing on is the one that notices: the rail's scope filter, its five tab
  /// counts, the quotes pipeline, the speed card and the CSV all filter on it.
  @@index([assignedToId], map: "enquiry_recipient_assignee_idx")
  @@map("enquiry_recipient")
}

model Quote {
  id              String      @id @default(cuid())
  /// QT-8841-R2
  ref             String      @unique
  enquiryId       String      @map("enquiry_id")
  businessId      String      @map("business_id")
  revision        Int         @default(1)
  validityDays    Int         @default(14) @map("validity_days")
  note            String?
  status          QuoteStatus @default(draft)
  lostReason      String?     @map("lost_reason")
  sentAt          DateTime?   @map("sent_at")
  readAt          DateTime?   @map("read_at")
  acceptedAt      DateTime?   @map("accepted_at")
  /// sentAt + validityDays, materialised so the expiry job and the buyer's
  /// countdown read the same number.
  expiresAt       DateTime?   @map("expires_at")
  /// Set when the buyer revised the requirement after this quote was sent.
  ///
  /// Not a status, because the quote is still live and still acceptable — the
  /// buyer may prefer it to anything the revision brings back. It records that
  /// the thing quoted has changed since, which board 1i renders as
  /// `QUOTED R1 · REQUIREMENT CHANGED SINCE`.
  supersededAt    DateTime?   @map("superseded_at")
  /// The enquiry revision this quote was priced against.
  againstRevision Int         @default(1) @map("against_revision")
  createdAt       DateTime    @default(now()) @map("created_at")
  /// When the draft was last autosaved. A sent quote never moves it — a revision
  /// is a new row rather than an edit — so on everything but a draft it equals
  /// `createdAt`, which is why the backfill could set it to exactly that.
  updatedAt       DateTime    @updatedAt @map("updated_at")

  /// How many times the window has been pushed out. Board 3k §5.
  ///
  /// A count rather than a flag, because §11 names it the number worth
  /// watching and it points somewhere else: quotes routinely extended twice
  /// mean board 3j's default validity is too short, which is a fix in the
  /// composer rather than here. `extended` alone cannot make that argument.
  extensionCount Int       @default(0) @map("extension_count")
  lastExtendedAt DateTime? @map("last_extended_at")
  /// Who moved it, for the system line the thread renders.
  extendedById   String?   @map("extended_by_id") @db.Uuid

  enquiry     Enquiry           @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines       QuoteLine[]
  messages    Message[]
  attachments QuoteAttachment[]
  extendedBy  User?             @relation("QuoteExtender", fields: [extendedById], references: [id], onDelete: SetNull)

  @@unique([enquiryId, businessId, revision])
  @@index([businessId, status])
  /// Board 3k's two live tabs: awaiting is a window in the future, expiring soon
  /// is the next seven days of it.
  @@index([businessId, expiresAt], map: "quote_window_idx")
  @@map("quote")
}

model QuoteLine {
  id            String  @id @default(cuid())
  quoteId       String  @map("quote_id")
  /// The buyer's line this one answers.
  ///
  /// The composer used to match a revision's lines back onto the enquiry by
  /// comparing `description`, which is ambiguous on exactly the enquiries this
  /// product is for — ENQ-8841 carries two lines reading "Resilient seated gate
  /// valve, flanged", separated only by `size`.
  ///
  /// Nullable because every line written before board 3j has no answer, and
  /// inventing one by matching descriptions would bake that ambiguity into the
  /// column.
  enquiryLineId String? @map("enquiry_line_id")
  /// Null means a free-text line, flagged for manual pricing.
  productId     String? @map("product_id")
  description   String
  qty           Int
  /// THE ONLY PRICE FIELD IN THE SCHEMA. Private to one buyer and one seller.
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)
  leadTimeDays  Int?    @map("lead_time_days")
  sortOrder     Int     @default(0) @map("sort_order")

  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// `SetNull`. Deleting a buyer's line must not delete the price a supplier
  /// quoted for it — what they quoted still happened.
  enquiryLine EnquiryLine? @relation(fields: [enquiryLineId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([enquiryLineId], map: "quote_line_enquiry_line_idx")
  @@map("quote_line")
}

/// A document cited by a quote.
///
/// Board 3j §5: the composer's chips pull from the catalogue's datasheets and
/// the licence documents. A join rather than a `quoteId` on `Document`, because
/// attaching is *referencing* — the same datasheet hangs off a product and off
/// every quote that cites it, and an owning column would force a copy per quote
/// and leave one storage object with two owners.
model QuoteAttachment {
  quoteId    String   @map("quote_id")
  documentId String   @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")

  quote    Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([quoteId, documentId])
  @@index([documentId], map: "quote_attachment_document_idx")
  @@map("quote_attachment")
}

/// Belongs to an Enquiry + Business pair. Off-platform payment detection runs on
/// the body — IBAN patterns, "transfer to" — and raises a SupplierReport with
/// kind `off_platform_payment`, which skips the moderation queue.
model Message {
  id              String    @id @default(cuid())
  enquiryId       String    @map("enquiry_id")
  businessId      String    @map("business_id")
  senderId        String    @map("sender_id") @db.Uuid
  body            String
  /// Written by the follow-up schedule rather than typed.
  ///
  /// It is still a seller message — it is what the buyer receives, and the
  /// thread is the record — but board 11b tags it `AUTOMATIC` on screen, because
  /// a buyer replying to a person deserves to know when they did not get one.
  automatic       Boolean   @default(false)
  /// A revised quote appears inline in the thread.
  quoteRevisionId String?   @map("quote_revision_id")
  flaggedAt       DateTime? @map("flagged_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  enquiry       Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  quoteRevision Quote?   @relation(fields: [quoteRevisionId], references: [id], onDelete: SetNull)

  @@index([enquiryId, businessId, createdAt])
  @@map("message")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews & trust
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id                 String    @id @default(cuid())
  businessId         String    @map("business_id")
  buyerId            String    @map("buyer_id") @db.Uuid
  /// Gating: one review per enquiry, and the enquiry must exist.
  enquiryId          String    @unique @map("enquiry_id")
  overall            Int
  quotedAccurate     Int       @map("quoted_accurate")
  onTime             Int       @map("on_time")
  asDescribed        Int       @map("as_described")
  responsiveness     Int
  body               String
  showCompanyName    Boolean   @default(true) @map("show_company_name")
  /// created + 14 days.
  editableUntil      DateTime  @map("editable_until")
  /// One only, not editable after posting. Never seller-deletable.
  sellerReply        String?   @map("seller_reply")
  sellerRepliedAt    DateTime? @map("seller_replied_at")
  /// A reply is permanent, and a reply can itself breach policy.
  ///
  /// Board 11c `B4`: the board considered neither a typo nor an abusive reply.
  /// The typo stays — a reply a seller can rewrite is a reply a buyer cannot
  /// rely on — and the abusive one comes down the way a review does: staff,
  /// reasoned, audited.
  ///
  /// `sellerReply` is **not** nulled when this is set. The text is the record
  /// of what was said, the same way a removed review keeps its body, and the
  /// seller does not get a second reply out of it: one reply, and they used it.
  /// Every reader hides the body when this is set and shows the neutral line
  /// instead.
  replyRemovedAt     DateTime? @map("reply_removed_at")
  /// Required when replyRemovedAt is set, by a check constraint.
  replyRemovalReason String?   @map("reply_removal_reason")
  /// Held pending a moderation decision. Board 1m: the row is replaced by a
  /// neutral line naming the hold, with no content and no rating, and the
  /// review is excluded from every average and from `AggregateRating` while it
  /// is set. A hold is reversible and a removal is not, which is why they are
  /// two columns rather than one state machine — releasing a hold restores the
  /// row exactly, and un-removing is not a thing this platform does.
  heldAt             DateTime? @map("held_at")
  /// Required when heldAt is set, by a check constraint. A hold takes a
  /// buyer's published words off a public page, so it is a staff state change
  /// and carries a written reason like every other one.
  heldReason         String?   @map("held_reason")
  removedAt          DateTime? @map("removed_at")
  /// Required when removedAt is set. Enforced by a check constraint in the
  /// migration, not only by the service layer.
  removalReason      String?   @map("removal_reason")
  createdAt          DateTime  @default(now()) @map("created_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyer    User             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  enquiry  Enquiry          @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  media    Media[]
  disputes ReviewDispute[]
  reports  SupplierReport[]

  /// The public read: one business, published, newest first.
  ///
  /// Replaces `(businessId, removedAt)`, which this has as a prefix and which
  /// Postgres would therefore never choose over it. `heldAt` joins the key
  /// because every figure on board 1m's page excludes a held row, so that
  /// filter is on all six of those queries rather than on some of them.
  @@index([businessId, removedAt, heldAt, createdAt])
  @@map("review")
}

/// The four grounds a review comes down on, and no fifth.
///
/// Board 11c: *"'It is unfair' is not a ground."* The same four the rail lists,
/// the same four the dispute flow accepts, and the same four `REMOVAL_GROUNDS`
/// in `lib/reviews/eligibility.ts` has held since board 1m — one list, three
/// readers. Criterion 6 is that the rail lists exactly what the flow accepts,
/// and the cheapest way to make that true is for both to read this.
///
/// They are reason codes rather than prose so the outcome log is queryable:
/// "how many abuse disputes did we uphold last quarter" is a question a
/// moderation queue has to be able to answer about itself.
enum ReviewDisputeGround {
  /// A competitor, or somebody who was never a buyer. The enquiry exists —
  /// `Review.enquiryId` is not nullable — but the trade behind it did not.
  no_traceable_enquiry
  abuse
  private_information
  provably_false

  @@map("review_dispute_ground")
}

/// Two outcomes, not three.
///
/// A supplier report has `seller_corrected` because a listing can be fixed. A
/// review cannot be corrected: either it comes down or it stands. Reusing
/// `ReportOutcome` here would have offered a moderator a third button that
/// resolves to nothing.
enum ReviewDisputeOutcome {
  /// The review is removed, by the same audited path a moderator uses.
  upheld
  /// The review stands. The reply is still available if the window is open.
  refused

  @@map("review_dispute_outcome")
}

/// A seller's formal claim that a review should not stand. Board 11c.
///
/// ## Why this is not a `SupplierReport`
///
/// Board 11c asks for "the review-dispute type in 4h's queue", and 4h renders
/// this beside the conduct reports — but the row is a different shape in all
/// four of its fields. A supplier report is filed *against* a business by a
/// buyer or by the platform, carries a free-text `subjectField` for the
/// three-strikes auto-flag, and resolves to one of three outcomes. A dispute is
/// filed *by* the business about a review, carries one of four fixed grounds,
/// and resolves to one of two. Putting it in the same table would have made
/// `subjectBusinessId` mean "the complainant" on some rows and "the accused" on
/// others, and `priorsFor()` would have counted a seller's own disputes as
/// reports against them.
///
/// ## Upholding one removes a review
///
/// Which is why resolution runs through `removeReview` rather than writing
/// `removedAt` here: removing a buyer's published words is ops-lead-only and
/// carries its own audit row, and a second route to it would be a route that
/// keeps none of the first one's promises.
model ReviewDispute {
  id         String              @id @default(cuid())
  reviewId   String              @map("review_id")
  /// The business the review is about, and the one disputing it. Denormalised
  /// from the review so the queue can group by seller without a join.
  businessId String              @map("business_id")
  /// The owner who raised it. Owner only — board 11c `Q4`: a dispute is a
  /// formal claim the business makes about a customer.
  raisedById String              @map("raised_by_id") @db.Uuid
  ground     ReviewDisputeGround
  /// What the seller says. Required: a ground on its own is a checkbox, and a
  /// moderator deciding in two working days needs the case.
  detail     String

  outcome       ReviewDisputeOutcome?
  /// The moderator's written reason. Required when outcome is set, by a check
  /// constraint — the same rule every staff state change in this schema keeps.
  outcomeReason String?               @map("outcome_reason")
  resolvedAt    DateTime?             @map("resolved_at")
  /// Who decided. Null while open.
  decidedById   String?               @map("decided_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  raisedBy  User     @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("DisputeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  /// The queue: open first, oldest first. Age before volume, like every other
  /// queue in this console.
  @@index([outcome, createdAt])
  @@index([businessId, createdAt])
  /// One open dispute per review is a partial unique index in the migration —
  /// Prisma cannot express `WHERE resolved_at IS NULL`. A seller who disputed
  /// on one ground and was refused may not immediately re-file on another, but
  /// a review that was disputed, refused, and then edited by the buyer inside
  /// their fortnight is a new set of facts, so the constraint is on *open*
  /// rather than on ever.
  @@map("review_dispute")
}

enum ReportKind {
  closed
  wrong_details
  wrong_trade
  claim_conflict
  off_platform_payment
  content
  review_integrity

  @@map("report_kind")
}

enum ReportOutcome {
  seller_corrected
  upheld
  no_action

  @@map("report_outcome")
}

/// The trust queue. Three reports on the same field auto-flag the listing.
/// `off_platform_payment` skips the queue.
model SupplierReport {
  id                String         @id @default(cuid())
  subjectBusinessId String         @map("subject_business_id")
  reporterId        String?        @map("reporter_id") @db.Uuid
  kind              ReportKind
  /// Which field was reported, for the three-strikes auto-flag.
  subjectField      String?        @map("subject_field")
  /// The review this report is about, where it is about one.
  ///
  /// Board 11c `B6`: the incentivised-review log. The request panel promises
  /// that "an incentivised review is removed and logged against your account",
  /// and until this column there was nowhere to write the finding — `kind`
  /// carried `review_integrity` from board 1m with nothing to join it to, which
  /// `lib/reviews/service.ts` noted as the reason a review nobody had reported
  /// could not be reached at all.
  ///
  /// Nullable, because most reports are about a listing rather than a review.
  /// `SetNull` rather than `Cascade`: removing the review is frequently the
  /// *outcome* of the finding, and a log that deletes itself when the thing it
  /// found is acted on is not a log.
  reviewId          String?        @map("review_id")
  detail            String?
  outcome           ReportOutcome?
  outcomeReason     String?        @map("outcome_reason")
  resolvedAt        DateTime?      @map("resolved_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  subjectBusiness Business @relation("ReportSubject", fields: [subjectBusinessId], references: [id], onDelete: Cascade)
  reporter        User?    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  review          Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([subjectBusinessId, outcome])
  @@index([kind])
  @@index([reviewId])
  @@map("supplier_report")
}

// ─────────────────────────────────────────────────────────────────────────────
// Commercials — subscription and sponsored placement only
// ─────────────────────────────────────────────────────────────────────────────

/// D0 silent retry, D3 email, D7 WhatsApp, D14 final notice then Free.
///
/// `dropped` is a plan change and nothing else: criterion 10 says dunning never
/// deletes a listing or removes a badge, and a stage that meant "gone" would be
/// the easiest way for that to stop being true.
enum DunningStage {
  none
  retry
  emailed
  messaged
  final
  dropped

  @@map("dunning_stage")
}

/// One attempt to take the money.
///
/// Kept because "the card failed four times" and "the card failed once and we
/// never tried again" are different conversations to have with a seller.
/// The card, as much of it as ever reaches us.
///
/// Board 3m criterion 13: *"Card details never reach our servers; only last 4,
/// brand and expiry are stored."* `providerToken` is the PSP's handle for a card
/// they hold; the four remaining columns exist so the rail can render
/// `•••• 4471 · Emirates NBD · expires 09/29` without asking the PSP on every
/// page load.
///
/// One per business rather than a wallet. A seller pays for one subscription
/// and there is nothing here to split across cards — a second row would be a
/// default-card question with no screen to answer it.
model PaymentMethod {
  id            String   @id @default(cuid())
  businessId    String   @unique @map("business_id")
  /// Whatever the PSP calls this card. Null while the console provider stands
  /// in, which is how a seeded card renders without pretending to be chargeable.
  providerToken String?  @map("provider_token")
  /// As printed on the rail. The issuer, not the network — the board reads
  /// `Emirates NBD`, which is the name a seller recognises on their statement.
  brand         String
  last4         String   @db.VarChar(4)
  expiryMonth   Int      @map("expiry_month")
  expiryYear    Int      @map("expiry_year")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("payment_method")
}

/// A plan change that has not happened yet.
///
/// Board 11f: *"A downgrade takes effect at the end of the period."* Nothing is
/// charged on the day and nothing on the listing moves, so the change has to be
/// held somewhere until the date — and held somewhere the seller can withdraw
/// it from, which a column on `Subscription` would not be: withdrawing would
/// mean nulling three fields and hoping nothing had read them apart.
///
/// ## Why the keep lists live here
///
/// Basic holds less than this seller has, so the screen hands over the choice —
/// `100 of 1,204 products`, `2 of 4 branches` — and the choice is made *now* for
/// a change that lands *later*. It belongs to the change, not to the
/// subscription: withdraw the change and the choice goes with it.
///
/// Absent means "we choose", and what we choose is the oldest, matching
/// `hideOverPlanCap`. A seller who schedules a downgrade and never opens the
/// chooser still gets a defensible answer rather than an empty catalogue.
///
/// ## One pending change per business
///
/// Q8, and it is structural rather than remembered: a partial unique index on
/// `business_id` where the row is neither applied nor withdrawn. Two pending
/// changes make the effective-date arithmetic uncheckable — the second would
/// have to know whether the first had landed to know what it was changing from.
model SubscriptionChange {
  id          String                 @id @default(cuid())
  businessId  String                 @map("business_id")
  fromPlanId  String                 @map("from_plan_id")
  toPlanId    String                 @map("to_plan_id")
  fromTerm    BillingTerm            @map("from_term")
  toTerm      BillingTerm            @map("to_term")
  /// What this pending row is. Boards 11h and 11j.
  ///
  /// A cancellation *is* a scheduled move to Free — same date, same keep lists,
  /// same withdrawal — so it is this table rather than a second mechanism
  /// beside it. Both were built anyway before the split: `Subscription`
  /// carried `cancelledAt` / `endsAt` and this table carried the choice, and
  /// the two would have drifted the first time one of them was written without
  /// the other.
  ///
  /// It is a column and not a derivation from `toPlanId = 'free'` because the
  /// two are genuinely different acts: a cancellation records a reason and
  /// stops the subscription, and a downgrade that happens to land on Free does
  /// neither. `11f`'s Free column now routes to the cancel flow rather than
  /// scheduling one of these silently, so the distinction has one writer.
  kind        SubscriptionChangeKind @default(plan_change)
  /// End of the period being paid for, copied at schedule time. The renewal
  /// date can move underneath a pending change — a term switch does exactly
  /// that — and the promise on screen was the date the seller read.
  effectiveAt DateTime               @map("effective_at")

  /// Product, location and team-member ids that stay live through the change.
  /// Null until the seller opens the chooser. See the note above.
  keepProductIds  Json? @map("keep_product_ids")
  keepLocationIds Json? @map("keep_location_ids")
  keepSeatIds     Json? @map("keep_seat_ids")

  /// Why the seller is leaving. Board 11j, and the only churn signal we get.
  ///
  /// Nullable, and not because the screen allows it — `scheduleCancellation`
  /// refuses without one, which is criterion 6. It is nullable because the
  /// cancellations that existed before this board were never asked, and a
  /// backfill that invented `something_else` for them would put made-up rows
  /// into the one report this column exists to feed. Null reads as *not
  /// recorded*, which is what it is.
  ///
  /// Never surfaced to the seller and never answered with a counter-offer —
  /// build note B6, and the wave 4 decision it follows from. `4g` (revenue) and
  /// `12d` (supply-gap reporting) are the two readers.
  cancelReason  CancelReason? @map("cancel_reason")
  /// The optional free text, and the required one under `something_else`.
  ///
  /// Confirming is never blocked on this box except there, where it is the only
  /// place the reason can be recorded — a check constraint says so, because the
  /// alternative is a `something_else` row that says nothing at all.
  cancelNote    String?       @map("cancel_note")
  /// Who asked for it. Owner only by capability, but support needs the name.
  requestedById String?       @map("requested_by_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at")
  appliedAt   DateTime? @map("applied_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromPlan    Plan     @relation("ChangeFromPlan", fields: [fromPlanId], references: [id], onDelete: Restrict)
  toPlan      Plan     @relation("ChangeToPlan", fields: [toPlanId], references: [id], onDelete: Restrict)
  requestedBy User?    @relation("ChangeRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([effectiveAt, appliedAt])
  /// The churn read: cancellations by reason over a window, for `4g` and `12d`.
  @@index([kind, createdAt])
  @@map("subscription_change")
}

/// A pending row is one of two acts, and they are not interchangeable.
enum SubscriptionChangeKind {
  plan_change
  cancellation

  @@map("subscription_change_kind")
}

/// The six on board `11j`, in the order they are asked.
///
/// `business_closing` is the fork rather than a reason: choosing it cancels
/// nothing and hands the seller to `11i`, which is not built. The value exists
/// here because the *reason* is still worth recording when `11i` lands.
enum CancelReason {
  too_expensive
  not_enough_enquiries
  poor_quality_enquiries
  another_platform
  business_closing
  something_else

  @@map("cancel_reason")
}

model PaymentAttempt {
  id              String   @id @default(cuid())
  subscriptionId  String   @map("subscription_id")
  amountFils      Int      @map("amount_fils")
  succeeded       Boolean
  /// What the provider said. The seller-facing message is ours, not theirs.
  providerMessage String?  @map("provider_message")
  attemptedAt     DateTime @default(now()) @map("attempted_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, attemptedAt(sort: Desc)], map: "payment_attempt_subscription_idx")
  @@map("payment_attempt")
}

enum SubStatus {
  trialing
  active
  past_due
  cancelled
  expired

  @@map("sub_status")
}

enum InvoiceStatus {
  draft
  issued
  paid
  overdue
  void

  @@map("invoice_status")
}

model Plan {
  id                  String    @id
  name                String
  monthlyPriceAed     Int       @map("monthly_price_aed")
  /// Null means unlimited.
  enquiriesPerMonth   Int?      @map("enquiries_per_month")
  productLimit        Int?      @map("product_limit")
  locationLimit       Int?      @map("location_limit")
  photoLimit          Int?      @map("photo_limit")
  /// How many gallery photographs a *public* storefront shows on this plan.
  /// Null is all of them.
  ///
  /// Separate from `photoLimit`, which is what a seller may upload. Board 1d
  /// cuts a Free storefront to three photographs, and that three was a
  /// `FREE_PHOTO_LIMIT` constant in a page file keyed on `plan.id === "free"` —
  /// a number nobody could change without a deploy, on a plan whose identity
  /// was matched by string. D1, 9 Sep 2026: every plan number lives on this
  /// table and nowhere else.
  publicPhotoLimit    Int?      @map("public_photo_limit")
  /// Megabytes of storage. Null means unlimited.
  ///
  /// Board 3i §1: the header reads `2.1 GB of 10 GB used`, and per board 3f §6
  /// a plan limit is visible before it bites and never destroys a record — at
  /// the cap **uploads stop**, nothing is deleted and nothing is unpublished.
  /// A downgrading seller keeps every file they have; only the next upload is
  /// refused. Separate from `photoLimit`, which counts photographs rather than
  /// bytes: a datasheet costs storage and is not a photograph, and whichever
  /// cap bites first is the one the refusal names.
  storageMb           Int?      @map("storage_mb")
  /// How many categories a listing may sit in, **including the primary one**.
  ///
  /// Board 2c counts this two ways on one screen and they are both right: the
  /// extras field says "2 of 2 extra used on Basic" — the allowance, which is
  /// this number minus the primary — and the strength meter says "3 categories
  /// chosen", the total. A single counter would have to be wrong on one of them.
  ///
  /// Null is unlimited, the same convention as the other caps here. It matters
  /// more than the rest of them: category membership is the join the enquiry
  /// fan-out matches on, so a seller in one category receives one category's
  /// demand. That is what makes the ladder mean something rather than being a
  /// paywall detail.
  categoryLimit       Int?      @map("category_limit")
  teamSeats           Int       @map("team_seats")
  rankingMultiplier   Float     @default(1) @map("ranking_multiplier")
  customDomain        Boolean   @default(false) @map("custom_domain")
  /// The three on/off entitlements board 11f's grid renders beside the caps.
  ///
  /// A cap is a number with a meter behind it; these have no meter and are not
  /// a cap of nought — "analytics, but zero of it" is not what the screen means.
  /// The handoff is explicit that the config carries both kinds, and 11f is the
  /// screen that renders the whole table: without these three columns its
  /// Analytics, CSV import and Sponsored eligibility rows would be the
  /// hardcoded cells criterion 5 forbids.
  ///
  /// Each is enforced where the thing happens, not only rendered here. An
  /// unenforced limit on a billing screen is worse than no limit — the spec says
  /// so about storage and it is no less true of these.
  analytics           Boolean   @default(false)
  csvImport           Boolean   @default(false) @map("csv_import")
  /// Whether this plan may hold a sponsored slot. `11e` sells them and is
  /// blocked on `12c`, so today this gates the billing line and the downgrade
  /// copy rather than a purchase button. It is still config: placement billing
  /// ships before placement purchase, and the grid states the eligibility now.
  sponsoredEligible   Boolean   @default(false) @map("sponsored_eligible")
  sortOrder           Int       @default(0) @map("sort_order")
  /// Months charged for a year. Null means this plan is monthly-only.
  ///
  /// A commercial figure, so it lives beside the others rather than as a
  /// constant somebody has to deploy to change. Null on Free, because a
  /// discount on nothing is nothing.
  ///
  /// A count and not a price. `Plan` has one price column and a second would be
  /// a second number to keep in step — which is the drift the one column exists
  /// to prevent, and which `tests/unit/schema-invariants.test.ts` censuses for.
  annualMonthsCharged Int?      @map("annual_months_charged")
  /// When this plan stopped being sold.
  ///
  /// Board 1l, criterion 12: a withdrawn plan does not appear on `/pricing`,
  /// and everybody already on it keeps it. Both halves are this one column —
  /// the row is never deleted, so `Business.planId` and `Subscription.planId`
  /// still resolve and `entitlementSnapshot` still grandfathers the numbers;
  /// only the surfaces that sell a plan filter on it.
  ///
  /// A date rather than a boolean because "since when" is the question asked
  /// of a plan nobody can buy any more, and a flag cannot answer it.
  withdrawnAt         DateTime? @map("withdrawn_at")

  // NO commissionRate. NO transactionFee.

  businesses    Business[]
  subscriptions Subscription[]
  changesFrom   SubscriptionChange[] @relation("ChangeFromPlan")
  changesTo     SubscriptionChange[] @relation("ChangeToPlan")

  @@map("plan")
}

/// How much of a subscription is paid at once.
///
/// A payment fact and never an entitlement one: an annual Pro seller is
/// entitled to exactly what a monthly Pro seller is, so this must never reach
/// `snapshotOf` in lib/plan/entitlements.ts. Freezing it would make
/// `effectiveCaps` treat two sellers on the same plan differently.
enum BillingTerm {
  monthly
  annual

  @@map("billing_term")
}

model Subscription {
  id                  String       @id @default(cuid())
  businessId          String       @unique @map("business_id")
  planId              String       @map("plan_id")
  status              SubStatus    @default(active)
  startedAt           DateTime     @default(now()) @map("started_at")
  renewsAt            DateTime     @map("renews_at")
  term                BillingTerm  @default(monthly)
  /// Start of the period currently paid for. `renewsAt` is its end.
  ///
  /// Proration divides by the real length of this period. Without it the only
  /// divisor available is a thirty-day default, which on a yearly period
  /// credits a downgrade about twelve times over.
  periodStartedAt     DateTime     @default(now()) @map("period_started_at")
  /// Day of the month the period lands on, taken from the first period.
  ///
  /// A subscription starting 31 January renews 28 February and must then return
  /// to 31 March. Clamping without an anchor walks the date back to the 28th
  /// and leaves it there for good.
  anchorDay           Int          @default(1) @map("anchor_day")
  cancelledAt         DateTime?    @map("cancelled_at")
  /// When the cancellation takes effect. Criterion 10: a cancel drops to Free
  /// at period end, never immediately, so the seller keeps what they paid for.
  /// Paired with cancelledAt by a check constraint — a cancellation that does
  /// not say when it ends is one nothing can act on.
  endsAt              DateTime?    @map("ends_at")
  /// Whatever a payment provider calls this subscription. Null while billing
  /// runs through the console provider — see lib/billing/provider.ts.
  providerRef         String?      @map("provider_ref")
  /// Grandfathering: entitlements captured at signup, unless a plan change
  /// explicitly sets "apply to existing".
  entitlementSnapshot Json?        @map("entitlement_snapshot")
  /// Where this subscription is in the D0/D3/D7/D14 sequence.
  /// When the Pro trial started, and when it ends.
  ///
  /// Board 2e, criterion 11: *"A seller who has used the trial sees no trial
  /// language."* `trialStartedAt` is the durable record of that — it is set
  /// once and nothing clears it, so a seller who trialled, dropped to Free and
  /// came back a year later is not offered a second one. The subscription row
  /// is unique per business and is never deleted, which is what makes it the
  /// right place to keep a fact about the account rather than about the plan it
  /// is on today.
  ///
  /// `trialEndsAt` is what the sweep reads. A trial takes no card — criterion
  /// 12 — so there is nothing to charge at the end of it and the account simply
  /// drops to Free, which is criterion 13 and the same guarantee the No lock-in
  /// card makes.
  trialStartedAt      DateTime?    @map("trial_started_at")
  trialEndsAt         DateTime?    @map("trial_ends_at")
  /// Product ids this platform hid when the plan dropped below what they need.
  ///
  /// "Hidden, not deleted" is the most load-bearing sentence on board 2e, and
  /// it was a claim rather than a behaviour: the cancel summary promised it and
  /// nothing did it. Hiding is `ProductStatus.draft`, which every public
  /// surface already excludes — so no read path had to learn a new rule and
  /// none can forget one. This column is what makes it reversible: an upgrade
  /// restores exactly the products the drop hid, and not the drafts the seller
  /// made themselves.
  hiddenByPlan        Json?        @map("hidden_by_plan")
  dunningStage        DunningStage @default(none) @map("dunning_stage")
  /// When the payment first failed. Every step is measured from here rather
  /// than from the previous one, so a missed run does not push the sequence
  /// back and leave somebody in dunning for a month.
  pastDueSince        DateTime?    @map("past_due_since")
  dunningAdvancedAt   DateTime?    @map("dunning_advanced_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]

  @@index([status, renewsAt])
  @@map("subscription")
}

/// How a subscription's monthly value moved, and why.
///
/// Board 4g wants new / expansion / contraction / churn, and there is no way to
/// derive that from the subscription table: it holds the plan an account is on
/// now, not the one it left. Deriving a waterfall from current state is exactly
/// the kind of fabricated metric this codebase keeps finding and deleting, so
/// movement is an event, written by the four places that can change what an
/// account pays — a plan change, a cancellation taking effect, the dunning drop,
/// and a signup.
///
/// MRR at any date is the sum of `deltaFils` up to it, and that sum must equal
/// the live subscription table. A test asserts the two agree.
model MrrMovement {
  id           String          @id @default(cuid())
  businessId   String          @map("business_id")
  kind         MrrMovementKind
  fromPlanId   String?         @map("from_plan_id")
  toPlanId     String?         @map("to_plan_id")
  /// Signed monthly change, in fils. Negative for contraction and churn.
  deltaFils    Int             @map("delta_fils")
  /// What this account pays a month after the movement. Redundant with the
  /// running sum, and kept because reconciling a ledger against itself is the
  /// only way to find the row that is wrong.
  mrrAfterFils Int             @map("mrr_after_fils")
  occurredAt   DateTime        @map("occurred_at")
  /// What caused it, in words. "Dunning drop after 14 days", "Cancelled at
  /// period end". Not a reason field in the audit sense — nobody decided this.
  note         String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([occurredAt], map: "mrr_movement_occurred_idx")
  @@index([businessId, occurredAt], map: "mrr_movement_business_idx")
  @@map("mrr_movement")
}

enum MrrMovementKind {
  /// First money from an account that has never paid.
  new_business
  /// Paying more than last month, same account.
  expansion
  /// Paying less, but still paying.
  contraction
  /// Was paying, now pays nothing.
  churn
  /// Was paying, stopped, and came back.
  reactivation

  @@map("mrr_movement_kind")
}

/// The ranking weights, as one row.
///
/// Board 12c. `lib/search/ranking.ts` has carried `DEFAULT_WEIGHTS` since
/// handoff 1 with a comment saying the admin editor in handoff 4 would have
/// "one thing to write to" — this is that thing. `searchBusinesses` has always
/// taken a `weights` option and no caller ever passed one, so the constant was
/// the whole configuration.
///
/// A single row, keyed by a constant. Not a settings table with a JSON blob:
/// six named columns are six things a migration can change and a reviewer can
/// read in a diff.
model RankingWeights {
  id               String @id @default("current")
  relevance        Int
  verificationTier Int    @map("verification_tier")
  responseTime     Int    @map("response_time")
  specCompleteness Int    @map("spec_completeness")
  distance         Int
  /// Deliberately the smallest. A directory that sells its way to the top is a
  /// directory nobody comes back to.
  planTier         Int    @map("plan_tier")

  /// What `relevance` means on a page with no query — board 6a §Ranking.
  ///
  /// The landing pages rank the same config as search, and there is nothing on
  /// them for a 34-point relevance weight to score against. Leaving it to
  /// multiply zero is the version that looks like it works: the weight sits in
  /// the admin editor, staff move it, and nothing on the highest-traffic
  /// template in the product changes.
  ///
  ///   `redistribute`    the 34 points spread across the other five in
  ///                     proportion, so verification becomes the dominant
  ///                     signal — which is what the H2 on those pages promises.
  ///   `category_depth`  relevance keeps its points and scores how exactly the
  ///                     listing's own trade matches the page's: primary
  ///                     category exact scores full, a match at sector level
  ///                     scores half.
  ///
  /// A named mode in the config board 12c edits, not a constant in a route:
  /// the spec asks for the decision to be written down where the weights are,
  /// so that whoever moves a weight can see what happens to the pages that
  /// have no query.
  browseRelevanceMode String @default("redistribute") @map("browse_relevance_mode")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ranking_weights")
}

/// A manual nudge up the results, with an expiry and a reason.
///
/// Criterion 5: *"a boost needs reason and expiry."* Both are NOT NULL, so a
/// boost that outlives the reason for it cannot exist — which is the failure
/// mode a manual override has: somebody helps a supplier out for a fortnight in
/// 2026 and the results are still bent in 2029.
///
/// Not a `PlacementSlot`. That is a sold, labelled, one-per-page slot. This is
/// ops moving a listing for a reason of ours, and it is never labelled as
/// sponsored because nobody paid for it.
model ListingBoost {
  id String @id @default(cuid())

  /// The listing this boost names, where it names one.
  ///
  /// Nullable since board `12c`'s second pass, because a boost may instead
  /// target a whole category — *"thin supply, surfacing the few we have"* is a
  /// statement about a category and not about one supplier. Exactly one of
  /// `businessId` and `categoryId` is set, enforced by the
  /// `listing_boost_one_target` check constraint in the migration: Prisma has
  /// no syntax for it, so it is asserted by `pnpm check:schema` instead.
  businessId String?  @map("business_id")
  /// The category this boost lifts, where it lifts a category.
  categoryId String?  @map("category_id")
  /// Narrows a category boost to one emirate. Null means the whole country.
  ///
  /// Meaningless on a business-targeted boost and rejected there: a boost on a
  /// named listing already knows where that listing trades.
  emirate    Emirate?

  /// Added to the computed score. Bounded in the service, because a boost that
  /// can outrank everything is a boost that replaces the ranking.
  ///
  /// The service also bounds the **sum** a business may hold at
  /// `MAX_BOOST_POINTS`, counting the category boosts it falls under. Board
  /// `12c` Q7: without that, five stacked boosts is +125 against weights that
  /// total 100, which is not a nudge but a replacement of the ranking — and the
  /// cap is bypassed entirely by aiming at the category instead of the listing.
  points      Int
  /// Never null. The whole point.
  reason      String
  expiresAt   DateTime @map("expires_at")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  business  Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([businessId, expiresAt], map: "listing_boost_business_idx")
  @@index([categoryId, expiresAt], map: "listing_boost_category_idx")
  @@index([expiresAt], map: "listing_boost_expiry_idx")
  @@map("listing_boost")
}

/// The weights an ops lead is working on, before anybody outside sees them.
///
/// Board `12c` §Publish. Until this table there was no draft: `saveWeights`
/// wrote straight to `RankingWeights:current` and the copy said so — *"Saved.
/// Search results reorder on the next request."* A staff member had no way to
/// look at a change before every buyer did.
///
/// One row, `id = "current"`, for the same reason the live weights are one row:
/// there is one ranking. A second concurrent draft would need an owner, a
/// merge and a rule for which one publish means, and none of those are
/// questions this board should be asking.
///
/// ## The preview lives here too
///
/// Criterion 7 — *publish is impossible on a stale or running preview* — needs
/// staleness to be a fact rather than a guess, so the vector the preview was
/// computed against is stored beside the preview itself. The draft moving is
/// what makes the preview stale; nothing else can, and the comparison is
/// exact rather than a timestamp race.
model RankingDraft {
  id String @id @default("current")

  relevance        Int
  verificationTier Int @map("verification_tier")
  responseTime     Int @map("response_time")
  specCompleteness Int @map("spec_completeness")
  distance         Int
  planTier         Int @map("plan_tier")

  browseRelevanceMode String @default("redistribute") @map("browse_relevance_mode")

  savedById String   @map("saved_by_id") @db.Uuid
  savedAt   DateTime @default(now()) @map("saved_at")

  /// Set when a preview starts, cleared when it finishes. Non-null with no
  /// `previewRanAt` after it means the run is still going.
  previewStartedAt DateTime? @map("preview_started_at")
  previewRanAt     DateTime? @map("preview_ran_at")
  /// The exact draft the stored preview describes — six weights and the mode.
  /// Compared field by field with the draft above; unequal means stale.
  previewFor       Json?     @map("preview_for")
  /// The rows the board renders: category, listings moving, biggest fall, who
  /// gains. Stored rather than recomputed because the publish that follows must
  /// tell sellers the same number the ops lead read.
  preview          Json?

  savedBy User @relation("RankingDraftAuthor", fields: [savedById], references: [id], onDelete: Restrict)

  @@map("ranking_draft")
}

/// Every published ranking change, with the vector that went live.
///
/// Board `12c` `B2` and criterion 4. `RankingWeights` is a single mutable row,
/// so before this the platform could say what the ranking *is* and never what
/// it *was*, and `staffMutation` recorded only the weights that moved rather
/// than the vector they moved to.
///
/// ## One row per publish, not one per day
///
/// The spec asks for one row per day, and the reason it gives is that the
/// position amendment derives state 09 by diffing consecutive rows. That
/// reader shipped first, in PR 146, and it does not read this table: it diffs
/// `ListingFactorDay.weights`, which the nightly snapshot already writes per
/// listing per day. So the per-day grain buys nothing and costs the thing
/// criterion 4 actually asks for — two publishes in one afternoon are two
/// decisions, by possibly two people, each with its own written reason, and a
/// row keyed by day keeps only the second.
///
/// `day` is kept as a column for the 90-day prune and for the history tab's
/// grouping. It is not the identity.
model RankingPublish {
  id String @id @default(cuid())

  /// Dubai-day start, for the prune and the grouping. Not unique.
  day         DateTime @map("day") @db.Date
  publishedAt DateTime @default(now()) @map("published_at")

  relevance        Int
  verificationTier Int @map("verification_tier")
  responseTime     Int @map("response_time")
  specCompleteness Int @map("spec_completeness")
  distance         Int
  planTier         Int @map("plan_tier")

  /// In the vector because a publish that moves no weight and flips this still
  /// reorders every area and emirate landing page — the highest-traffic
  /// template in the product. A six-integer history would record that change
  /// as no change at all.
  browseRelevanceMode String @map("browse_relevance_mode")

  /// The written reason, as every staff state change carries.
  reason String

  /// What the impact preview said this publish would do, kept as the claim that
  /// was made rather than recomputed later against a directory that has moved.
  /// Null on a publish taken with no preview, which the service refuses — so in
  /// practice only on rows written before that refusal existed.
  categoriesMoved Int? @map("categories_moved")
  listingsMoved   Int? @map("listings_moved")
  /// The number on the button when it was pressed. Criterion 6.
  sellersTold     Int? @map("sellers_told")

  publishedById String @map("published_by_id") @db.Uuid
  publishedBy   User   @relation("RankingPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  @@index([publishedAt], map: "ranking_publish_at_idx")
  @@index([day], map: "ranking_publish_day_idx")
  @@map("ranking_publish")
}

model PlacementSlot {
  id              String    @id @default(cuid())
  businessId      String    @map("business_id")
  categoryId      String    @map("category_id")
  emirate         Emirate?
  monthlyPriceAed Int       @map("monthly_price_aed")
  startsOn        DateTime  @map("starts_on")
  endsOn          DateTime? @map("ends_on")
  createdAt       DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, emirate, startsOn])
  @@map("placement_slot")
}

/// What kind of document this is.
///
/// Board 3m Q5: UAE VAT requires a credit note for any correction, and an
/// issued invoice may not be edited. The two are the same table because they
/// are the same list on the seller's screen and the same rows in the VAT
/// return — a credit note is an invoice with a negative total and a pointer to
/// the one it corrects, not a second document store.
enum InvoiceDocType {
  tax_invoice
  credit_note

  @@map("invoice_doc_type")
}

/// Subscription and placement lines only. There is no buyer money here and
/// nothing to refund — a correction is a subscription credit.
///
/// ## Immutable once issued
///
/// Board 3m, criterion 2: *"Invoice rows render stored values and never
/// recompute them."* Two things were recomputed and both are now frozen at
/// issue.
///
/// **The totals.** `invoiceList` and `vatReturn` each summed `InvoiceLine`
/// and applied the rate themselves, which meant the number on the seller's
/// screen was a function of today's code rather than of what was charged. The
/// pair that made this a joint handoff — `BL-INV-20418` reading `7,802.15` on
/// one board and `1,783.95` on the other — is the same failure one layer up.
///
/// **Who it was billed to.** The name, address and TRN were read live from
/// `Business`, so a supplier who renamed rewrote every invoice they had ever
/// been sent. A tax document records a supply that happened to a party as they
/// were then; it is not a view of the customer table.
model Invoice {
  id         String         @id @default(cuid())
  ref        String         @unique
  businessId String         @map("business_id")
  docType    InvoiceDocType @default(tax_invoice) @map("doc_type")
  vatRate    Decimal        @default(0.05) @map("vat_rate") @db.Decimal(4, 4)
  status     InvoiceStatus  @default(draft)
  issuedAt   DateTime?      @map("issued_at")
  dueAt      DateTime?      @map("due_at")
  paidAt     DateTime?      @map("paid_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  /// Sum of the lines, ex-VAT, in whole fils. Negative on a credit note.
  ///
  /// Nullable only because every invoice written before this column existed has
  /// no stored figure and inventing one would be worse than reading it as
  /// absent. `storedTotals()` in lib/billing/invoice.ts is the one reader, and
  /// it falls back to the lines for those and says so.
  subtotalFils Int? @map("subtotal_fils")
  /// VAT at `vatRate`, rounded once per invoice — the convention `vatReturn`
  /// already used, now stored rather than re-derived.
  vatFils      Int? @map("vat_fils")
  /// `subtotalFils + vatFils`. Redundant, and kept for the same reason
  /// `MrrMovement.mrrAfterFils` is: reconciling a total against its own parts
  /// is the only way to find the row that is wrong.
  totalFils    Int? @map("total_fils")

  /// The billed party, as they were on the day. See the note above.
  billedToName    String? @map("billed_to_name")
  billedToTrn     String? @map("billed_to_trn")
  billedToAddress String? @map("billed_to_address")

  /// What paid it, for the `Total paid · card ••4471` line. Brand and last four
  /// only — criterion 13, and the same two fields `PaymentMethod` holds.
  paidByBrand String? @map("paid_by_brand")
  paidByLast4 String? @map("paid_by_last4")

  /// The invoice this one corrects. Set on a credit note and null otherwise.
  correctsId String? @map("corrects_id")

  /// Us, as we were on the day. Board 11g.
  ///
  /// The issuing entity is **Bearing Deployment Company, Inc**, incorporated in
  /// Delaware and operating from San Francisco. It is not registered in the UAE,
  /// so **there is no supplier TRN** — the recipient's is the only tax number on
  /// the document, which is why it is labelled `Recipient TRN` rather than a
  /// bare `TRN`.
  ///
  /// Stored rather than read from a constant for the same reason the recipient
  /// is stored: an office move or a re-registration must not rewrite invoices
  /// already issued and filed. This entity has been restated once already —
  /// the board was drawn with a UAE company — which is the argument made by
  /// events rather than in principle.
  supplierName          String? @map("supplier_name")
  supplierAddress       String? @map("supplier_address")
  supplierIncorporation String? @map("supplier_incorporation")

  /// Date of supply, which is not always the date of issue.
  ///
  /// The board rendered `14 AUG 2026` once and let it stand for date of issue,
  /// date of supply and the supply period at the same time. On a tax document
  /// those are three different claims and each is separately mandatory.
  supplyDate    DateTime? @map("supply_date")
  /// Where the supply is made. `Dubai, UAE` — the recipient's emirate, stored,
  /// because it is a fact about the transaction rather than about the seller now.
  placeOfSupply String?   @map("place_of_supply")
  /// `AED`. One currency today; stated on the document because a total without
  /// one is not a figure an accountant can enter.
  currency      String    @default("AED")

  /// The provider's reference for the transaction, printed under REFERENCES.
  pspRef          String? @map("psp_ref")
  /// Ours for the subscription — `SUB-4471-PRO` on the render.
  subscriptionRef String? @map("subscription_ref")

  /// The PDF written at issue, keyed by invoice id.
  ///
  /// Board 11g's new dependency, and the rule is stricter than it looks: the
  /// download serves *this file*, byte for byte, and never re-renders. A PDF
  /// regenerated by a later template is a different document from the one the
  /// seller filed with their accountant, even when every figure matches.
  ///
  /// Null on an invoice issued before the pipeline existed, and on one whose
  /// write failed — the screen says so rather than offering a download that
  /// would have to invent the bytes.
  pdfPath  String? @map("pdf_path")
  pdfBytes Int?    @map("pdf_bytes")

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines       InvoiceLine[]
  events      InvoiceEvent[]
  /// `Restrict` rather than `Cascade`: deleting an invoice that a credit note
  /// corrects would leave the correction pointing at nothing, and neither
  /// document is ours to delete once issued.
  corrects    Invoice?       @relation("InvoiceCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy Invoice[]      @relation("InvoiceCorrection")

  @@index([businessId, status])
  @@index([businessId, issuedAt(sort: Desc)], map: "invoice_business_issued_idx")
  @@map("invoice")
}

enum InvoiceLineKind {
  subscription
  placement
  subscription_credit

  @@map("invoice_line_kind")
}

/// How a line is treated for VAT.
///
/// Board 11g's second correction, and the reason per-line VAT exists at all. A
/// single blended `VAT 5%` row is arithmetically right for an invoice whose
/// lines are all standard-rated and wrong as a *document design*: the first
/// zero-rated, exempt or out-of-scope line has nowhere to go, and a document's
/// layout cannot change after issue.
///
/// So the treatment is per line and stored, even while every line reads
/// `standard rate`. The alternative is discovering the need on the day a line
/// needs it, across invoices already filed.
enum TaxTreatment {
  standard
  zero_rated
  exempt
  out_of_scope

  @@map("tax_treatment")
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String          @map("invoice_id")
  kind        InvoiceLineKind
  description String
  qty         Int             @default(1)
  amountAed   Decimal         @map("amount_aed") @db.Decimal(12, 2)

  /// What period this line covers, where it covers one.
  ///
  /// The invoice document reads `Pro subscription · 14 Aug – 13 Sep 2026`, and
  /// board 3m Q7 settles that the placement runs on its own clock rather than
  /// the subscription's — so the dates cannot be derived from the invoice, and
  /// a placement line and a subscription line on the same invoice legitimately
  /// carry different ones. Null on a line that covers no period, such as a
  /// pro-rating credit.
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")

  /// Unit price, ex-VAT. `1 × 299.00` on the document.
  ///
  /// `amountAed` is the line total and stays the figure everything sums; this is
  /// what it is the total *of*. Nullable for lines written before board 11g,
  /// where the unit price is the amount because the quantity was always one.
  unitAed      Decimal?     @map("unit_aed") @db.Decimal(12, 2)
  /// The rate this line was charged at, stored. `Invoice.vatRate` is the
  /// document's default; this is what actually applied, and on a zero-rated or
  /// exempt line the two differ.
  vatRate      Decimal?     @map("vat_rate") @db.Decimal(4, 4)
  /// VAT on this line, in dirhams. Stored, never recomputed — criterion 2.
  vatAed       Decimal?     @map("vat_aed") @db.Decimal(12, 2)
  taxTreatment TaxTreatment @default(standard) @map("tax_treatment")

  /// The placement booking this line bills, printed under the description.
  ///
  /// Text, not a link. `11e` owns the booking detail page and is blocked on
  /// `12c`, so there is no route to send anybody to — the same refusal `11d`
  /// makes about a quote list that does not exist. A link to an unbuilt route is
  /// worse on a document than on a screen, because the document outlives the
  /// decision to build it.
  bookingRef String? @map("booking_ref")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line")
}

/// What happened to an invoice after it was issued.
///
/// Board 11g's `DELIVERY` panel, and it exists because accounting teams ask —
/// *"did you send it, and to whom"* — and the record has to exist before the
/// question is asked rather than being reconstructed from a mail log.
///
/// Deliberately not on `AuditEvent`. That table records **decisions staff make**
/// and its `reason` is `NOT NULL` for exactly that reason; nobody decides to
/// download their own invoice, and a required written reason on a download would
/// be a field somebody fills with a full stop. See CLAUDE.md §3.
model InvoiceEvent {
  id        String           @id @default(cuid())
  invoiceId String           @map("invoice_id")
  kind      InvoiceEventKind
  /// Where it went, on an `emailed` row. Null on a download.
  recipient String?
  /// Who did it. Null for a send the platform made on its own at issue.
  actorId   String?          @map("actor_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt(sort: Desc)], map: "invoice_event_invoice_idx")
  @@map("invoice_event")
}

enum InvoiceEventKind {
  emailed
  downloaded

  @@map("invoice_event_kind")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit & platform events
// ─────────────────────────────────────────────────────────────────────────────

/// Write it in the service layer. A mutation that can reach the database
/// without an audit row is a bug, and the suite proves it cannot.
model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String   @map("actor_id") @db.Uuid
  /// tier_change | review_removed | credit_issued | suspend | merge | boost |
  /// view_as | report_resolved | queue_decided | visit_recorded |
  /// taxonomy_changed | staff_changed
  action    String
  /// Entity type and id, e.g. `Business:clx123`.
  subject   String
  /// REQUIRED. Not nullable, by design, in the schema and in the service layer.
  reason    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([subject])
  @@index([action, createdAt])
  @@map("audit_event")
}

enum RevealChannel {
  phone
  whatsapp
  email
  website

  @@map("reveal_channel")
}

/// Masking is not a growth trick. It is how the platform proves it delivered the
/// enquiry — the answer to "what did my subscription buy" is a count of these.
/// Deliberately not an AuditEvent: that log is staff acting on other people's
/// data, and buyer behaviour would make it unreadable.
model ContactReveal {
  id         String        @id @default(cuid())
  /// Null for an anonymous buyer. Most reveals happen before signup.
  actorId    String?       @map("actor_id") @db.Uuid
  businessId String        @map("business_id")
  locationId String?       @map("location_id")
  channel    RevealChannel
  surface    String
  createdAt  DateTime      @default(now()) @map("created_at")

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("contact_reveal")
}

/// The seller's first run through setup, as one row.
///
/// Board 8e's completion screen asserts two comparisons — "up from 62%" and "14
/// spec filters you were invisible to this morning" — and neither can be
/// computed from the present. A comparison needs a *before*, and nothing was
/// storing one: the hub read the score every time it rendered and kept none of
/// them.
///
/// One row per business, ever. The write is an upsert that inserts and never
/// updates, so a second hub render cannot move the baseline the screen is about
/// to compare against. A listing that never opens the hub has no row rather than
/// five nulls on `business`, which matters when 41,000 imported listings will
/// never claim.
model SetupBaseline {
  businessId String @id @map("business_id")

  /// When the hub was first rendered. The denominator of §7's one number worth
  /// watching: hours from first hub view to completion.
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  /// `profileStrength` at that moment. Nullable because a listing can reach the
  /// hub before `strength-job.ts` has ever run, and a baseline of 0 would be a
  /// claim rather than an absence — §2 says drop the clause, not guess.
  baselineScore Int? @map("baseline_score")

  /// Distinct filterable (field, value) pairs the published catalogue carried
  /// then. Without a before there is no delta, only a total, and §6 forbids a
  /// total standing in for one.
  baselineFacets Int? @map("baseline_facets")

  /// When all three tasks first closed. Written by the hub on the transition,
  /// because the hub is the only thing that knows the moment.
  completedAt DateTime? @map("completed_at")

  /// When `/dashboard/setup/done` was actually rendered. The once-only rule:
  /// §1 says the seller reaches it exactly once, and a completion screen that
  /// can be revisited is a stale dashboard. Null means it is still owed.
  doneSeenAt DateTime? @map("done_seen_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([completedAt], map: "setup_baseline_completed_idx")
  @@map("setup_baseline")
}

/// A buyer keeping a supplier for later. Board 8a's right rail counts these.
///
/// Deliberately not a `SavedSearch`: that is a query, and a query cannot answer
/// "four buyers kept you". A shortlist row names one buyer and one supplier, so
/// the count on the seller's side is a fact rather than an inference — which is
/// the whole reason it exists, since the alternative on offer was a DISTINCT
/// over `ContactReveal.actorId`, three quarters of which is null by design.
///
/// Signed-in only. There is no anonymous shortlist and no cookie behind one:
/// a list that lives in a browser is lost on the next device, and a buyer whose
/// shortlist evaporates trusts the list less than they trusted their memory.
model Shortlist {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation("BuyerShortlist", fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// One row per buyer per supplier. Saving twice is saving once.
  @@unique([userId, businessId])
  /// The seller's count, and the buyer's list.
  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@map("shortlist")
}

/// Storefront views, rolled up to the day.
///
/// A row per view was the other option and it is the wrong one for a directory:
/// this product is built to be crawled, most of the traffic is not a person,
/// and 41,000 listings times a crawl is a table nobody can afford to keep. The
/// grain is the smallest one any surface asks a question at — board 8a wants
/// "since you went live", analytics wants a week — so the rollup loses nothing
/// that is read.
///
/// **Counted from the browser, not from the render.** The storefront is a
/// public page and the framework may serve it from a cache, so a render is not
/// a visit; and a crawler that does not run JavaScript is not a buyer. The write
/// path is `/api/events`, which is also what makes the count honest enough to
/// put on a seller's screen.
model ListingViewDay {
  businessId String   @map("business_id")
  /// Asia/Dubai, so a "day" is the day the supplier had.
  day        DateTime @map("day") @db.Date
  views      Int      @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, day])
  @@map("listing_view_day")
}

/// Where a listing appeared in search, rolled up per query per day.
///
/// Board `3l`. Two of its four panels — *"appeared in search"* and *"what
/// buyers searched to reach you"* — had no source at all: `SearchQueryLog`
/// records what was typed and how many results came back, and never which
/// businesses were in them.
///
/// **Rolled up at write time, not one row per impression.** This directory is
/// built to be crawled: one search returning twenty listings would be twenty
/// rows, most of them written for a bot. The grain is the smallest one any
/// surface asks a question at — a business, a query, a day — so a page of
/// twenty results costs twenty upserts and a thousand repeat searches cost
/// nothing more.
///
/// **`bestRank` is the position snapshot.** Board `3l`'s `B2` asks for a daily
/// position table, and this is it: the best position the listing actually held
/// for that query on that day, observed during a real search. The alternative
/// was a cron that re-runs every tracked query against the ranker, which
/// records a position no buyer ever saw. A query with no traffic on a day has
/// no row, so movement is measured between the first and last day it was
/// actually searched — which is the honest window rather than a padded one.
///
/// **That argument still holds here and was overturned for the other object.**
/// The `3a`/`3l` amendment added `CategoryRankDay`, which is exactly the cron
/// this comment rejects — and the difference is what the number is *of*. A
/// category listing exists whether anybody browsed it or not, so ranking it
/// nightly reports a real place in a real set. A phrase nobody typed has no
/// results page to hold a position in, so re-running it would invent both the
/// search and the rank. Impressions stay observed; category position is
/// computed. Neither table has changed its mind about the other.
model SearchImpressionDay {
  businessId  String   @map("business_id")
  /// Asia/Dubai, so a "day" is the day the supplier had.
  day         DateTime @map("day") @db.Date
  /// Lowercased, collapsed whitespace — the same normalisation
  /// `SearchQueryLog.normalised` uses, so the two group identically.
  normalised  String
  impressions Int      @default(0)
  /// Lowest position held that day. 1 is the top of the results.
  bestRank    Int      @map("best_rank")
  /// How many listings the query returned, so the seller reads `#2 of 34`.
  ///
  /// Nullable, and it stays nullable: rows written before the amendment have no
  /// denominator and inventing one for them would be exactly the hardcoded
  /// count the honesty rules forbid. A row without it renders its rank alone
  /// until the 30-day window has rolled past the deploy.
  resultTotal Int?     @map("result_total")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, day, normalised])
  /// The seller's read: their queries over a window, biggest first.
  @@index([businessId, day])
  /// The prune.
  @@index([day])
  @@map("search_impression_day")
}

/// Where a listing ranked inside a category and emirate, per day.
///
/// The **second** of board `3l`'s two position objects, and the one board `3a`'s
/// hidden card reads. They are not the same number and the spec is explicit:
/// `3a` is your rank in a category listing (`Cold rooms · UAE — #11`), and
/// `SearchImpressionDay` is your rank for a free-text query somebody typed
/// (`skf bearing distributor — #14`). One table for both would put two
/// different questions behind one answer and let the two boards disagree with
/// each other while reading the same row.
model CategoryPositionDay {
  /// A surrogate, because the natural key contains a nullable column.
  ///
  /// `emirate` is null when the buyer browsed the category across the whole
  /// country, and that is a real scope rather than missing data — so it belongs
  /// in the identity. Prisma refuses an `@@id` over an optional field, and a
  /// plain unique index would not help either: in SQL a null never equals a
  /// null, so two country-wide rows for one business on one day would both be
  /// accepted.
  ///
  /// The identity is therefore a unique index over
  /// `coalesce(emirate::text, '')` in the migration, and the rollup upserts
  /// through it with a raw `ON CONFLICT`. Same shape as
  /// `subscription_change_one_pending`: an invariant the schema file cannot
  /// express, written once in SQL and asserted by `pnpm check:schema`.
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  categoryId  String   @map("category_id")
  /// Null where the buyer browsed the category across the whole country.
  emirate     Emirate?
  day         DateTime @map("day") @db.Date
  /// Lowest position held that day, as above.
  position    Int
  impressions Int      @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([businessId, day])
  @@index([day])
  @@map("category_position_day")
}

/// Product views, rolled up per product per day.
///
/// The third funnel stage, which had no source: `ProductEvent` is the seller's
/// own setup telemetry and has never counted a buyer looking at a product.
/// Same grain and same reasoning as `ListingViewDay` — counted from the
/// browser, so a cached render is not a visit and a crawler that runs no
/// JavaScript is not a buyer.
model ProductViewDay {
  productId  String   @map("product_id")
  /// Denormalised so the seller's read never joins through `product`.
  businessId String   @map("business_id")
  day        DateTime @map("day") @db.Date
  views      Int      @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([productId, day])
  @@index([businessId, day])
  @@index([day])
  @@map("product_view_day")
}

/// What a listing was viewed on, per day.
///
/// Its own table rather than a column on `ListingViewDay`, because adding one
/// would move that table's primary key — a rewrite of a table that is already
/// counting, to answer a question only one panel asks.
///
/// The board's 68% mobile against a buyer web designed at 1440px is the
/// strongest argument in the product for the mobile pass, which is why the
/// split stays on the page rather than coming off it.
model ListingDeviceDay {
  businessId String     @map("business_id")
  day        DateTime   @map("day") @db.Date
  device     DeviceKind
  views      Int        @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, day, device])
  @@index([day])
  @@map("listing_device_day")
}

/// Where a listing ranked in a category listing, computed nightly.
///
/// The amendment's `B1`, and the reason it exists is that `CategoryPositionDay`
/// is a **counter and not a snapshot**. That table is written by
/// `recordCategoryPositions` when a buyer loads a category page, so a category
/// nobody browsed on Tuesday has no Tuesday row. An arrow computed across a
/// hole in that series is not absent — it is *wrong*, because it silently
/// compares Monday to Thursday and calls the difference a day's movement.
///
/// So the two tables answer two questions and neither substitutes for the
/// other: `CategoryPositionDay` holds **impressions**, which only a real buyer
/// can generate, and this holds the **position**, which is true whether anybody
/// looked or not.
///
/// `total` is the size of the ranked set, and it is here rather than derived at
/// read time because the set is what it was *that night*. A category that grew
/// from five listings to forty would otherwise restate every historical rank
/// against today's denominator, which is the same class of lie as a hardcoded
/// count.
model CategoryRankDay {
  /// A surrogate, for the reason `CategoryPositionDay` documents at length:
  /// `emirate` is nullable, it belongs in the identity, and in SQL a null never
  /// equals a null. Two partial unique indexes in the migration, asserted by
  /// `pnpm check:schema`.
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  categoryId String   @map("category_id")
  /// Null is the country-wide listing — `Cold rooms · UAE` on the card.
  emirate    Emirate?
  day        DateTime @map("day") @db.Date
  /// One-based. A zero would read as better than first everywhere this is
  /// ordered, which is why the migration carries a check constraint for it.
  position   Int
  /// The size of the ranked set that night. `#3 of 5` renders both.
  total      Int

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// The seller's read: their categories over a window.
  @@index([businessId, day])
  /// The prune.
  @@index([day])
  @@map("category_rank_day")
}

/// What the ranker saw when it placed this listing, per day.
///
/// The amendment's `B2`. Board `3l` shipped a rule — every attribution sentence
/// traces to *"a factor changed, by how much, in the window"* — on top of
/// history the platform did not keep. `Business.responseTimeMedianMs`,
/// `profileStrength` and `specCompleteness` are current-value columns that the
/// nightly jobs overwrite, so the platform could say what a factor **is** and
/// never what it **was**.
///
/// ## Vectors, not six named columns
///
/// Six columns would be six migrations the first time the factor set moves, and
/// the factor set is `12c`'s to move. `scores` and `weights` are objects keyed
/// by `WEIGHT_KEYS`, so a seventh factor is a key and not a schema change.
///
/// ## The weights are stored per day, not per change
///
/// This is what makes state 09 free. A staff weight move on `12c` shifts every
/// listing in a category and none of them did anything; diffing two days'
/// `weights` is how attribution knows that, with no audit table to read and no
/// second source to keep in step. It also means a fall caused by a slider is
/// never billed to the seller, which is the failure this amendment exists to
/// stop.
///
/// `raw` carries the display values behind the scores — a median in
/// milliseconds, a filled ratio — because *"rose from 4h to 31h"* is a sentence
/// about the measurement and not about its normalised 0..1 form.
model ListingFactorDay {
  businessId  String   @map("business_id")
  day         DateTime @map("day") @db.Date
  /// `{ relevance, verificationTier, responseTime, specCompleteness, distance,
  /// planTier }`, each 0..1 as `scoreRow` normalises them. Typed as
  /// `FactorVector` in `lib/analytics/factors.ts`.
  scores      Json
  /// The same keys, holding what the seller would recognise: milliseconds, a
  /// tier, a ratio. Typed as `RawFactors`.
  raw         Json
  /// The six weights in force that night, as `12c` had them set.
  weights     Json
  /// Points from a live `ListingBoost`. Added after the weighted sum, so it is
  /// its own number here too — state 10 reads it to say a position was bought.
  boostPoints Int      @default(0) @map("boost_points")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, day])
  /// The prune.
  @@index([day])
  @@map("listing_factor_day")
}

/// Three buckets, from the user agent at beacon time.
///
/// Deliberately coarse. A device string is a fingerprinting surface and the
/// only question any screen asks of it is whether the buyer web needs a mobile
/// pass, which three buckets answer.
enum DeviceKind {
  mobile
  desktop
  tablet

  @@map("device_kind")
}

/// What somebody did, so a screen can be judged rather than guessed at.
///
/// The product had no event of any kind. Board 8a asks the one question this
/// table exists for — *what score are sellers at when they give up* — and
/// nothing in the schema could answer "when", "in what order" or "how long",
/// because every completion was derived from the rows a task happens to leave
/// behind. Derived state answers "is it done now" and nothing else.
///
/// **Not `AuditEvent`.** That log records staff decisions and its `actorId` and
/// `reason` are both NOT NULL for that reason (CLAUDE.md, non-negotiable 3). A
/// product event has no reason at all and often no actor, and mixing the two
/// would make the log that has to be readable in a dispute unreadable.
///
/// `props` is deliberately loose. The alternative is a column per question and
/// a migration per screen, and the rows are read by analysis rather than by a
/// surface — nothing renders from this table.
model ProductEvent {
  id         String   @id @default(cuid())
  /// Snake case, past tense, verbatim from the board: `setup_task_completed`.
  name       String
  /// Which supplier this was about. Null for an event with no business in it.
  businessId String?  @map("business_id")
  /// Who, when there is a session. Null for anonymous public traffic, and
  /// there is no fallback identifier — see docs/telemetry.md.
  actorId    String?  @map("actor_id") @db.Uuid
  /// Groups the events of one page life so a duration can be measured. Minted
  /// per tab, never persisted in the browser, and only ever set where `actorId`
  /// is: an anonymous visitor is counted, never followed.
  sessionId  String?  @map("session_id")
  props      Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?     @relation("EventActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// The analysis read: one event name over a window.
  @@index([name, createdAt])
  /// One supplier's funnel.
  @@index([businessId, name, createdAt])
  /// The prune.
  @@index([createdAt])
  @@map("product_event")
}

/// Where a concierge catalogue load has got to.
///
/// `loaded` and not "complete": what staff did is put products on the listing,
/// and the seller may well add more afterwards. `cancelled` is either side
/// withdrawing.
enum CatalogueImportStatus {
  requested
  in_progress
  loaded
  cancelled

  @@map("catalogue_import_status")
}

/// "Send us your price list and we will key it in." Board 8a's right rail.
///
/// A queue, not a parser. `lib/import/service.ts` is the parser and it needs a
/// spreadsheet with columns; this is for the PDF a supplier has had since 2019,
/// and the work at the other end is a person reading it. It is a promise of a
/// shape this schema no longer has anywhere else: the seller asks, we do
/// something by hand, and the row is what either side points at.
///
/// The file itself is a `Document` with `kind: catalogue` in the private bucket.
/// A price list is commercially sensitive and belongs nowhere public.
///
/// **Every staff move on this row writes an audit row with a written reason**
/// (CLAUDE.md, non-negotiable 3). The seller's own create and cancel do not:
/// they are the subject acting on their own data, which is what the log is for
/// distinguishing from.
model CatalogueImportRequest {
  id             String                @id @default(cuid())
  businessId     String                @map("business_id")
  requestedById  String                @map("requested_by_id") @db.Uuid
  documentId     String?               @map("document_id")
  status         CatalogueImportStatus @default(requested)
  /// What the seller said about the file. Not instructions we promise to follow.
  note           String?
  /// What it costs on this seller's plan, in whole dirhams, frozen at the
  /// moment of asking. Zero where the plan includes it. A price read later
  /// would be a different price, and the seller agreed to this one.
  feeAed         Int                   @default(0) @map("fee_aed")
  /// The two working days the panel promises, resolved to a date on create.
  dueAt          DateTime?             @map("due_at")
  /// How many products went on. Written by staff, shown back to the seller.
  productsLoaded Int?                  @map("products_loaded")
  loadedAt       DateTime?             @map("loaded_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("CatalogueImportRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  /// The seller's own read, and the staff queue.
  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("catalogue_import_request")
}

/// Written on every search that returns nothing. Feeds the admin gap report and
/// the recruitment call list. Required by handoff 1 acceptance criterion 6 —
/// added here rather than at handoff 1 so it is never a retrofit.
model ZeroResultQuery {
  id         String   @id @default(cuid())
  query      String
  categoryId String?  @map("category_id")
  emirate    Emirate?
  /// The facet values that were set, so the gap report can name which filter to
  /// suggest dropping.
  filters    Json     @default("{}")
  tab        String   @default("businesses")
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([query])
  @@index([createdAt])
  @@map("zero_result_query")
}

/// Written on every search, whatever it returned. The sibling of
/// `ZeroResultQuery`, and the store the home page's "Popular:" chips read.
///
/// Two tables rather than one, deliberately. `ZeroResultQuery` carries the
/// applied facets so the gap report can say which filter to suggest dropping,
/// and it is read by the recruitment call list — a table whose every row is a
/// failure. This one is read for the opposite reason: the five things buyers
/// most often searched for *and found*, which is what belongs on the home page.
/// Folding them together would mean the gap report learning to exclude nine
/// rows in ten, and the home page learning to exclude the other one.
///
/// No `actorId`. Nothing reads a popular query per person, and a log of what
/// each buyer searched for is personal data kept for no reason. The
/// normalised form is what is grouped on, so the raw text is kept only to
/// render a chip a buyer will recognise.
model SearchQueryLog {
  id          String   @id @default(cuid())
  /// As the buyer typed it. What a chip renders.
  query       String
  /// Lowercased, collapsed whitespace. What the grouping counts.
  normalised  String   @map("normalised")
  /// How many results came back. The home page reads `> 0` only — a chip
  /// leading to an empty page is worse than no chip.
  resultCount Int      @map("result_count")
  categoryId  String?  @map("category_id")
  emirate     Emirate?
  tab         String   @default("businesses")
  createdAt   DateTime @default(now()) @map("created_at")

  /// The home page's read is "group by normalised, where createdAt >= 30 days
  /// ago and resultCount > 0". This is that query's index, in that order.
  @@index([normalised, createdAt])
  @@index([createdAt])
  @@map("search_query_log")
}

/// One row per rate-limited request. The generic sibling of `AuthAttempt`.
///
/// Board 2a's search is unauthenticated by design — a supplier looking for
/// their own licence record has no account yet, and making them sign up to find
/// out whether we hold them is the fastest way to lose them. Unauthenticated
/// and unmetered is a different thing, so the search is metered here.
///
/// A separate table from `AuthAttempt` rather than a new value on its enum:
/// that one is the audit trail a locked-out person is entitled to see, it
/// carries a raw phone number or email as its identifier, and its retention is
/// a security parameter tied to the OTP windows. This one holds a salted digest
/// of whatever identified the caller and nothing a person could be recognised
/// from, and it is pruned on a much shorter clock.
model RateLimitHit {
  id String @id @default(cuid())

  /// Which limit this counts against — `claim_search`. Never a user-facing
  /// string; the policy for a bucket lives in `lib/rate-limit/policy.ts`.
  bucket     String
  /// A salted SHA-256 digest of the caller — the session's actor id where there
  /// is one, otherwise the forwarded IP. Never the address itself: this table
  /// exists to count, and an address kept in order to count is an address kept
  /// for no reason once the window has passed.
  identifier String
  createdAt  DateTime @default(now()) @map("created_at")

  /// The window read, in the order it is filtered.
  @@index([bucket, identifier, createdAt])
  /// The prune.
  @@index([createdAt])
  @@map("rate_limit_hit")
}

/// A saved search plus its alert cadence. /account/saved.
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  name      String
  query     String
  filters   Json     @default("{}")
  alerts    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_search")
}

/// Slugs are immutable once published. A rename or a merge creates one of these
/// automatically; deleting a page without one is blocked at the service layer.
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique @map("from_path")
  toPath     String   @map("to_path")
  statusCode Int      @default(301) @map("status_code")
  businessId String?  @map("business_id")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@map("redirect")
}

// ─────────────────────────────────────────────────────────────────────────────
// Area landing pages — board 6a
//
// 84 category×emirate combinations plus area-level depth, and the workhorse of
// the whole acquisition engine.
//
// Keyed on the pair, not on the area. `Area.publishedAt` decides whether the
// area is worth a page at all; this decides whether HVAC in Al Quoz is, which
// is a different question with a different answer for every trade in it.
// Criterion 1 is stated per page, and one timestamp per area cannot express it.
// ─────────────────────────────────────────────────────────────────────────────

/// One trade in one area. The only authored thing on it is `intro`.
model AreaPage {
  id         String @id @default(cuid())
  areaId     String @map("area_id")
  categoryId String @map("category_id")

  /// The paragraph a person writes, and the only one. Everything else on the
  /// page is derived, which is criterion 2: a new emirate or subcategory needs
  /// no code change, only supply and a paragraph.
  ///
  /// Counted against the same 250 as every other landing page, by the same
  /// function.
  intro String?

  /// The one written sentence board 6a §SEO asks for, 150-160 characters.
  ///
  /// Not generated. The title carries a live count and beats a competitor on
  /// it; the description has to say something about *this* scope that a
  /// substituted area name cannot, or it is the doorway text the whole gate
  /// exists to keep out. Null falls back to a derived sentence and the page
  /// still publishes — this is not a fifth floor, it is a quality field.
  metaDescription String? @map("meta_description")

  /// What `UPDATED 21 AUG 2026` prints — board 6a §Freshness.
  ///
  /// It moves for exactly three reasons: a listing enters or leaves the scope,
  /// a listing in the scope changes verification tier, or the intro or FAQ is
  /// edited. It does **not** move for a rebuild, a deploy, a ranking-weight
  /// change or a review landing, which is why it is a column of its own rather
  /// than `updatedAt` — Prisma moves that one whenever any field is touched,
  /// including the digest below.
  ///
  /// If this tracked the build, every page on the domain would claim to have
  /// been updated this morning. That is both false and trivially detected.
  contentUpdatedAt DateTime? @map("content_updated_at")

  /// How the sweep knows supply moved, without storing the membership.
  ///
  /// A hash over `businessId:tier` for every listing in the scope, sorted. Two
  /// runs with the same set at the same tiers produce the same digest and
  /// `contentUpdatedAt` stays where it is; a listing joining, leaving or
  /// changing rung changes it and the date moves. Counting listings alone
  /// would miss a swap of one supplier for another, which is exactly the
  /// change a reader would call an update.
  supplyDigest String? @map("supply_digest")

  /// Staff intent, not the live state.
  ///
  /// The page is live only if this is set *and* the board 6f floors currently
  /// hold. Criterion 1's second half — "auto-unpublishes when supply drops" —
  /// is read that way rather than trusted to a job having run, and
  /// `sweepAreaPages` clears the column afterwards so the drop is visible on
  /// the matrix and in the audit log rather than only in a render.
  publishedAt DateTime? @map("published_at")

  /// The first time this page ever went live, and it is never cleared.
  ///
  /// Board 6f's minimum-live window needs something durable to measure from,
  /// and `publishedAt` above is not it: both unpublish paths null it and a
  /// republish stamps a fresh date, so a grace measured from it would reset
  /// every time supply wobbled — the exact opposite of what a grace is for.
  firstPublishedAt DateTime? @map("first_published_at")

  /// "Do not publish this one" — board 6f's `Held · editorial`.
  ///
  /// Set by a person and never cleared automatically. The board's own words:
  /// "There is currently no way to express 'do not publish this one' and there
  /// will be a reason to at some point." It is stored state on a screen whose
  /// governing rule is that nothing is stored — and it is the exception that
  /// proves it, because a human decision is the one thing no query can
  /// re-derive. A held page cannot be published by staff or by any job, and it
  /// is unheld only by a person with a written reason.
  heldAt     DateTime? @map("held_at")
  heldReason String?   @map("held_reason")
  heldById   String?   @map("held_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  area     Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  heldBy   User?    @relation("AreaPageHolder", fields: [heldById], references: [id], onDelete: SetNull)

  faq             LandingFaq[]
  relatedSearches LandingRelatedSearch[]

  @@unique([areaId, categoryId])
  @@index([publishedAt])
  @@map("area_page")
}

/// One trade across one whole emirate — `/:emirate/:category`, board 6c's matrix.
///
/// The sibling of `AreaPage` and deliberately its twin: same two authored
/// fields, same floors, same "staff intent AND supply" reading of live. The two
/// are different pages because they answer different questions — "HVAC in Al
/// Quoz" is where a buyer goes when they know the industrial estate, and "HVAC
/// in Dubai" is where they go when they do not — and an area is not an emirate,
/// so neither can stand in for the other.
///
/// It exists because the paragraph has to. Before this table the emirate page
/// borrowed its sector's `Category.intro`, which meant seven pages sharing one
/// paragraph: thin-content risk on exactly the pages the acquisition engine
/// depends on, and no way for a writer to say anything true about Sharjah that
/// is not also true about Fujairah.
///
/// Keyed on the enum rather than a relation. An emirate is a fixed list of
/// seven in the schema, not a row somebody can add, so there is nothing to
/// point a foreign key at.
/// Searches a month for one landing scope — board 6f.
///
/// A table of its own rather than a column on `AreaPage`, and that is the whole
/// point of it. An `AreaPage` row exists only once somebody has saved copy, so
/// a column there could describe demand only for pages that already exist —
/// while the state board 6f calls RECRUIT is precisely a scope with real demand
/// and no page: 2,260 searches a month for AC repair in Jumeirah, two listings,
/// nothing written. Those rows are the work. They have to be able to exist.
///
/// One row is one scope: (category, emirate) with `areaId` null is an emirate
/// page, and with `areaId` set an area page.
model ScopeDemand {
  id         String  @id @default(cuid())
  categoryId String  @map("category_id")
  emirate    Emirate
  /// Null means the emirate-wide page for this trade rather than one area.
  areaId     String? @map("area_id")

  /// The figure itself. Never defaulted, never zero-filled: an absent row means
  /// the absolute floor alone, and a nought would make the demand-relative need
  /// nought and pass every unmeasured page for the wrong reason.
  monthlySearches Int @map("monthly_searches")

  /// Where the number came from and when it was true, rendered beside it.
  ///
  /// Both required. A keyword volume is a third-party claim with a shelf life,
  /// and a directory whose only asset is that its numbers are true cannot print
  /// one without saying whose it is and how old it is. `Business.derivedAt` is
  /// the counter-example this repo already carries: a vintage written by two
  /// jobs and rendered nowhere.
  source     String
  capturedAt DateTime @map("captured_at")

  /// Who entered it. Nullable only so a reseed's user truncation cannot take
  /// the demand rows with it.
  recordedById String? @map("recorded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  area       Area?    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("ScopeDemandRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  /// Covers the area rows. The emirate rows carry a null `areaId`, which
  /// Postgres reads as distinct from every other null, so they are covered by a
  /// partial unique index written by hand in the migration instead.
  @@unique([categoryId, emirate, areaId])
  @@index([categoryId])
  @@index([areaId])
  @@map("scope_demand")
}

/// A proposed change to a category's publish rules — board 6f.
///
/// Dual control, and the first of it in this codebase. A threshold decides
/// whether hundreds of URLs exist; the board asks for a second person, and
/// there is no rung above `staff_ops_lead` to escalate to, so the second person
/// IS the escalation. `approved_by_id <> proposed_by_id` is a CHECK in the
/// migration rather than an `if` a refactor can drop.
///
/// `impact` is written at propose time rather than recomputed at approval,
/// following `TemplateVersion.storeCount`: the number is the decision. Recomputed
/// later, the second approver would be approving a different change from the
/// one they were shown.
model PublishRuleChange {
  id         String          @id @default(cuid())
  categoryId String          @map("category_id")
  /// The four threshold fields as they stood, and as proposed.
  before     Json
  after      Json
  /// Which pages would start and stop publishing, counted when proposed.
  impact     Json
  state      RuleChangeState @default(proposed)

  proposedById   String @map("proposed_by_id") @db.Uuid
  proposedReason String @map("proposed_reason")

  /// Who ended it, and why, whichever way it ended.
  ///
  /// `decidedBy`, not `approvedBy`. The second-approver CHECK applies to an
  /// APPROVAL — a proposer rejecting or withdrawing their own proposal is not a
  /// self-approval, and a constraint demanding a different person on every exit
  /// from `proposed` would leave a mistyped proposal with no way out of the
  /// queue but a second ops lead's signature.
  ///
  /// NOT NULL on decided rows with a written reason, enforced by a partial
  /// CHECK in the migration — the shape `ListingChangeRequest.decisionReason`
  /// uses.
  decidedById   String?   @map("decided_by_id") @db.Uuid
  decidedReason String?   @map("decided_reason")
  decidedAt     DateTime? @map("decided_at")

  /// When `impact` was counted, so the approver is told how old the number is.
  ///
  /// Supply moves nightly. "Publishes 214" computed on Monday and approved on
  /// Thursday is a claim about Monday, and the panel recomputes beside it
  /// rather than letting the stored figure stand in for the live one.
  impactAt  DateTime @map("impact_at")
  createdAt DateTime @default(now()) @map("created_at")

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  proposedBy User     @relation("RuleChangeProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedBy  User?    @relation("RuleChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([state, createdAt])
  @@index([categoryId, state])
  @@map("publish_rule_change")
}

enum RuleChangeState {
  proposed
  approved
  rejected
  withdrawn

  @@map("rule_change_state")
}

model EmiratePage {
  id         String  @id @default(cuid())
  emirate    Emirate
  categoryId String  @map("category_id")

  /// The paragraph a person writes, and the only one. Everything else on the
  /// page is derived. Counted against the same 250 words as every other
  /// landing page, by the same function.
  intro String?

  /// The written sentence, as on `AreaPage`. Same rule, same 150-160.
  metaDescription String? @map("meta_description")

  /// Content freshness, as on `AreaPage`. Same three reasons, same sweep.
  contentUpdatedAt DateTime? @map("content_updated_at")
  supplyDigest     String?   @map("supply_digest")

  /// Staff intent, not the live state.
  ///
  /// The page is live only if this is set *and* the board 6f floors currently
  /// hold, which is how `AreaPage` reads it and for the same reason: a page
  /// whose supply dropped this morning must stop being indexable now rather
  /// than when a job next runs.
  publishedAt DateTime? @map("published_at")

  /// As on `AreaPage`, and for the same reason. Never cleared.
  firstPublishedAt DateTime? @map("first_published_at")

  /// `Held · editorial`, as on `AreaPage`. Same rule, same reason.
  heldAt     DateTime? @map("held_at")
  heldReason String?   @map("held_reason")
  heldById   String?   @map("held_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  heldBy   User?    @relation("EmiratePageHolder", fields: [heldById], references: [id], onDelete: SetNull)

  faq             LandingFaq[]
  relatedSearches LandingRelatedSearch[]

  @@unique([emirate, categoryId])
  @@index([publishedAt])
  @@map("emirate_page")
}

// ─────────────────────────────────────────────────────────────────────────────
// Landing-page content records — board 6a §5
//
// The FAQ rows and the related searches are **content, not queries**. That is
// the sentence in the spec's data table, and it is the whole difference between
// this template and a doorway generator: the questions are per-scope editorial
// and two of them must be answerable only for this scope. A shared list with
// the area name substituted in is the thing being forbidden.
//
// Both tables hang off either landing class, because board 6a is one template
// serving two of them and duplicating the tables would guarantee the emirate
// pages drifted. Exactly one parent is set, enforced by a check constraint in
// the migration rather than by hope — a row with neither is invisible content
// and a row with both belongs to two pages at once.
// ─────────────────────────────────────────────────────────────────────────────

/// One question and its answer, on one landing page.
model LandingFaq {
  id String @id @default(cuid())

  /// Exactly one of these. `num_nonnulls(...) = 1`, in the migration.
  areaPageId    String? @map("area_page_id")
  emiratePageId String? @map("emirate_page_id")

  /// Reading order. The board draws four; the gate asks for at least four.
  position Int

  question String
  answer   String

  /// Whether this one could only be asked about this scope.
  ///
  /// The fourth publish condition needs two of them, and it is the condition
  /// that stops a writer clearing the gate with four generic questions and a
  /// find-and-replace. Board 6a's own model is "Is Al Quoz the right area for
  /// my job?" — it names the neighbourhoods this area serves and sends the
  /// wrong buyer somewhere else, which nothing generic can do.
  ///
  /// Staff assert it. There is no way to measure it, and pretending otherwise
  /// with a similarity heuristic would be a number nobody could argue with.
  scopeSpecific Boolean @default(false) @map("scope_specific")

  /// A number this answer needs, resolved at render.
  ///
  /// `quote_range` is the only one, and it is the reason the row is a content
  /// record rather than a generated sentence: a person writes the sentence and
  /// names where the number goes, and the number is measured. Below its
  /// minimum sample the whole row does not render — it does not render a range
  /// from four quotes and it does not say "not enough data".
  liveToken String? @map("live_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  areaPage    AreaPage?    @relation(fields: [areaPageId], references: [id], onDelete: Cascade)
  emiratePage EmiratePage? @relation(fields: [emiratePageId], references: [id], onDelete: Cascade)

  @@unique([areaPageId, position])
  @@unique([emiratePageId, position])
  @@index([areaPageId])
  @@index([emiratePageId])
  @@map("landing_faq")
}

/// One curated link in the RELATED SEARCHES card. Capped at five in the service.
///
/// A link, not a query. The board asks for sibling scopes and adjacent
/// categories chosen by somebody who knows what a buyer on this page asks next,
/// and the nearest automatic version of that — "categories sharing a parent" —
/// produces five links that are already in the sibling block at the bottom.
model LandingRelatedSearch {
  id String @id @default(cuid())

  areaPageId    String? @map("area_page_id")
  emiratePageId String? @map("emirate_page_id")

  position Int
  label    String
  /// An internal path. Validated in the service: this card is five anchors on
  /// the highest-authority template we own, and an external one spends that.
  href     String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  areaPage    AreaPage?    @relation(fields: [areaPageId], references: [id], onDelete: Cascade)
  emiratePage EmiratePage? @relation(fields: [emiratePageId], references: [id], onDelete: Cascade)

  @@unique([areaPageId, position])
  @@unique([emiratePageId, position])
  @@index([areaPageId])
  @@index([emiratePageId])
  @@map("landing_related_search")
}

// ─────────────────────────────────────────────────────────────────────────────
// Curated lists — board 6b
//
// Every other "best of" list in this market is sold. Stating the rules is the
// only thing that makes ours worth reading, and it is why sellers chase
// verification instead of chasing us.
//
// So the rules are **code, not columns**. A list picks what it is about — a
// trade, and optionally an area — and its editorial framing. It cannot pick its
// bar, because a bar somebody can lower is a bar somebody can be sold. There is
// no placement field on this model for the same reason: criterion 4 says
// placement cannot be bought, and the cheapest way to guarantee that is to have
// nowhere to put it.
//
// Membership **is** stored, and this reversed a decision. It used to be computed
// from the rules on every read, so a supplier whose reply time slipped left the
// list without anybody running anything. Board 6b §3 says why that cannot work:
//
//   the entries are hand-written and they cross-reference each other. Entry 03
//   reads "slower to reply than the two above"; the `BEST FOR:` lines are chosen
//   so that twelve recommendations do not overlap; the rank numerals are
//   editorial. **Automated reordering corrupts prose no automated process can
//   rewrite.**
//
// So the page is a dated snapshot. Every figure a reader sees was measured on
// the audit date and the page says so twice. A nightly job compares live data to
// the snapshot and writes drift to an editorial queue rather than acting on it.
// One failure is hard-suppressed in the build — a lapsed licence — because that
// is the one that makes the page's central claim false rather than merely stale.
//
// What that costs is the guarantee the old model got for free. "Placement cannot
// be bought" used to hold because there was no row to write; now there is, so the
// bar moved into `lib/seo/curated/audit.ts`, which refuses to record a member who
// does not pass the criteria at audit time and writes an audit row saying who
// decided. The selection record is the evidence, and it is retained rather than
// overwritten — the history is the point.
// ─────────────────────────────────────────────────────────────────────────────

/// An editorial list. What it is about, how it is framed, and when it was last
/// measured. Who is on it lives in `CuratedListMember`.
model CuratedList {
  id    String @id @default(cuid())
  slug  String @unique
  /// Board 6b Q1: the H1 carries the query and the year — "The 12 best HVAC
  /// contractors in Al Quoz, 2026" — because this is the one page whose job is
  /// acquisition, and the voice is worth less than the ranking. The editorial
  /// voice moves to `standfirst`. Board 6a's READ NEXT card renders this same
  /// field, so the two cannot say different things about one page.
  title String

  /// The hero standfirst: the criteria in a sentence, then "No one paid to be
  /// here." Four words, own sentence, load-bearing — §2 says never soften it,
  /// never merge it into the preceding clause, never move it below the fold.
  standfirst String?

  /// The editorial framing — why this list exists and who it is for. Rendered
  /// as the last rail card, "Why we publish the criteria", which is the page
  /// arguing for its own trustworthiness and should stay the last thing read.
  intro String?

  /// What the list is about. Required: a list of "the best suppliers" with no
  /// trade is a list of everybody.
  categoryId String  @map("category_id")
  /// Optionally narrowed to one area.
  areaId     String? @map("area_id")

  /// The criteria **this list** was chosen on, as `{key, kind}` rows.
  ///
  /// On the record rather than in a config file: §2 says the method panel is a
  /// record of how *this* list was chosen, not a statement of general policy —
  /// so two lists with different criteria render different panels (acceptance
  /// 10). General policy lives on `/verification-policy`.
  ///
  /// It is not seller-editable and not per-list *negotiable*: the audit service
  /// validates against whatever is recorded here, and a criterion nobody
  /// enforced is a criterion nobody may publish.
  criteria Json @default("[]")

  /// When the figures on the page were measured. Not a publish date and not a
  /// build date.
  ///
  /// A re-audit is the only thing that moves it — not a rebuild, not a review
  /// landing, not a deploy. Same rule as `AreaPage.contentUpdatedAt` and for the
  /// same reason: a date that tracks the build is a date that is always today
  /// and therefore says nothing.
  auditedAt DateTime? @map("audited_at")

  /// Who audited it last. "No one paid to be here" is unfalsifiable without a
  /// name against the decision.
  editorId String? @map("editor_id") @db.Uuid

  /// How many businesses were considered. Published as a number; the names are
  /// not, and they are in `CuratedListAudit.record` for staff.
  consideredCount Int @default(0) @map("considered_count")

  /// When an entry was last dropped by the build for a lapsed licence.
  ///
  /// Rendered in the hero beside the audit date, deliberately ugly, so it pushes
  /// editorial to re-audit rather than sit. §3, consequence 3.
  entryRemovedAt DateTime? @map("entry_removed_at")

  /// The re-audit SLA. Past this with unresolved drift, the list unpublishes
  /// rather than degrade — an unaudited curated list is worth less than none.
  reauditDueAt DateTime? @map("reaudit_due_at")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  area     Area?    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  editor   User?    @relation("CuratedListEditor", fields: [editorId], references: [id], onDelete: SetNull)

  members CuratedListMember[]
  audits  CuratedListAudit[]
  drift   CuratedListDrift[]

  @@index([publishedAt])
  @@index([reauditDueAt])
  @@map("curated_list")
}

/// One hand-written entry, and the figures as they stood on the audit date.
///
/// Every metric here is a **snapshot**, never a live read (acceptance 5). The
/// columns are prefixed `snap` so that a future reader reaching for
/// `business.responseTimeMedianMs` on this page has to notice they are leaving
/// the model.
model CuratedListMember {
  id         String @id @default(cuid())
  listId     String @map("list_id")
  businessId String @map("business_id")

  /// Editorial order. The rank numeral is decorative weight, not a score — §3
  /// draws it in `--line-strong` for exactly that reason.
  position Int

  /// `BEST FOR: CHILLER AMC ON A TIGHT BUILDING`.
  ///
  /// Unique within a list, enforced here rather than in review: this line is
  /// the actual product of the curation — it turns a ranked list into twelve
  /// non-competing recommendations — and two entries sharing one is the list
  /// failing at the thing it is for. Acceptance 16.
  bestFor String @map("best_for")

  /// Three or four sentences a person wrote after reading the reviews and the
  /// quotes. Specific and checkable; no adjective that cannot be sourced.
  prose String

  /// The figures, as measured on `snapshotAt`.
  snapshotAt          DateTime @map("snapshot_at")
  snapRatingOverall   Float?   @map("snap_rating_overall")
  snapReviewCount     Int      @map("snap_review_count")
  snapResponseMs      Int      @map("snap_response_ms")
  snapEstablishedYear Int?     @map("snap_established_year")

  /// The metric strip's varying fourth cell — `CATALOGUE 312 products`,
  /// `CALLOUT 24 hours`.
  ///
  /// Authored, and varying by entry on purpose: §3 says a fixed grid with
  /// blanks would say less. Both null renders three cells, not an empty one.
  extraLabel String? @map("extra_label")
  extraValue String? @map("extra_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  list     CuratedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([listId, position])
  @@unique([listId, businessId])
  @@unique([listId, bestFor])
  @@index([businessId])
  @@map("curated_list_member")
}

/// The selection record, retained.
///
/// "No one paid to be here" is unfalsifiable unless there is a record, and a
/// record that is overwritten on every re-audit is not evidence — it is the
/// current claim restated. One row per audit, kept.
model CuratedListAudit {
  id     String @id @default(cuid())
  listId String @map("list_id")

  auditedAt       DateTime @map("audited_at")
  editorId        String?  @map("editor_id") @db.Uuid
  consideredCount Int      @map("considered_count")
  memberCount     Int      @map("member_count")

  /// The full snapshot as it was written: per member the business, the metrics
  /// and the `BEST FOR:` assignment. Json because it is a frozen document
  /// nobody queries across — the live shape is `CuratedListMember`.
  record Json

  createdAt DateTime @default(now()) @map("created_at")

  list   CuratedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  editor User?       @relation("CuratedListAuditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@index([listId, auditedAt])
  @@map("curated_list_audit")
}

/// A member who no longer matches the snapshot the page publishes.
///
/// Written nightly, read by board 6f, and acted on by **a person**. The whole
/// point of §3 is that this queue changes nothing the reader sees: reordering or
/// dropping a member automatically would make the surrounding prose wrong.
///
/// The exception is a lapsed licence, which never reaches this table — it is
/// suppressed in the build, because it is the one failure that makes the page's
/// claim false rather than stale.
model CuratedListDrift {
  id         String @id @default(cuid())
  listId     String @map("list_id")
  businessId String @map("business_id")

  /// `reply` or `reviews`. The criterion that moved.
  criterion String

  /// Both sides, as rendered strings — this is a queue a person reads, and
  /// "4 h 10 min against 2 h 30 min at audit" is the whole content of the row.
  snapshotValue String @map("snapshot_value")
  liveValue     String @map("live_value")

  detectedAt DateTime  @default(now()) @map("detected_at")
  /// Cleared by a re-audit, which is the only thing that resolves drift.
  resolvedAt DateTime? @map("resolved_at")

  list     CuratedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([listId, resolvedAt])
  @@map("curated_list_drift")
}

/// Criterion 8 — the zero-result alert, and the end of the flywheel.
///
/// A buyer searches for a stainless DN100 UL/FM valve, finds nobody, and asks
/// to be told when one is listed. The CRM works the same gap from the other
/// end — `ZeroResultQuery` feeds the recruitment call list — so the supplier
/// who eventually lists it is often one we went and found. The alert is what
/// turns that back into an enquiry rather than a statistic.
///
/// Separate from `SavedSearch`, which needs an account and has a cadence. Most
/// people who hit a zero-result page have neither: this takes a provisional
/// identity, the same one the RFQ flow creates, and fires exactly once.
model ProductAlert {
  id String @id @default(cuid())

  /// The words they typed. Matched against `Product.searchText`.
  ///
  /// Empty for a restock watch, where `productId` is the subject instead. The
  /// two are one table on purpose: both are "tell me when this exists", both
  /// fire once, and both are swept by the same job — a second table would be a
  /// second sweep to keep correct and a second place for a notification to go
  /// missing.
  query      String
  categoryId String?  @map("category_id")
  emirate    Emirate?

  /// The product being watched, for "Notify me" on an out-of-stock line.
  ///
  /// Board 1e criterion 7. A watch on a *specific* product is a stronger
  /// promise than a query alert that fires when anybody lists something
  /// similar, and it is the promise the button makes.
  productId String? @map("product_id")

  /// Who to tell. Provisional is normal here rather than exceptional.
  userId String @map("user_id") @db.Uuid

  /// The query that spawned it, so the gap report can show which searches
  /// somebody cared enough about to wait for.
  zeroResultQueryId String? @map("zero_result_query_id")

  /// Fires once. A second notification for the same alert would be a
  /// subscription nobody asked for.
  notifiedAt       DateTime? @map("notified_at")
  matchedProductId String?   @map("matched_product_id")

  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  matched  Product?  @relation(fields: [matchedProductId], references: [id], onDelete: SetNull)
  product  Product?  @relation("ProductWatch", fields: [productId], references: [id], onDelete: Cascade)

  /// The sweep reads the open ones. Partial in spirit; most rows end up closed.
  @@index([notifiedAt])
  /// The seller's catalogue screen counts open watches per product.
  @@index([productId, notifiedAt])
  @@map("product_alert")
}

// ─────────────────────────────────────────────────────────────────────────────
// Campaign landings — board 10i
//
// A page with no site nav beyond the wordmark, one escape link, and always the
// directory offered as an alternative: a page that traps the visitor converts
// worse and ranks worse.
//
// Criterion 9 is the interesting half — "campaign pages preserve UTM through to
// the enquiry and attribute it in admin". A visitor arriving on one of these
// may click through the directory for ten minutes before sending anything, so
// the attribution cannot ride in the query string. It is set as a first-party
// cookie here and read at `createEnquiry`.
// ─────────────────────────────────────────────────────────────────────────────

/// One campaign landing page. Content, so it lives here and not in a commit.
model Campaign {
  id         String  @id @default(cuid())
  slug       String  @unique
  /// The one big line. Not the `<title>`, which is `metaTitle`.
  headline   String
  /// Two or three sentences under it.
  standfirst String?
  /// The body, in the same paragraph-per-blank-line shape a landing intro uses.
  body       String?

  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")

  /// Where the one call to action goes. Null sends them to search.
  ctaCategoryId String? @map("cta_category_id")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  ctaCategory Category? @relation("CampaignCtaCategory", fields: [ctaCategoryId], references: [id], onDelete: SetNull)
  enquiries   Enquiry[]

  @@index([publishedAt])
  @@map("campaign")
}

// ─────────────────────────────────────────────────────────────────────────────
// Entry surfaces — /for-buyers and /list-your-business
//
// The two audiences arrive for opposite reasons. A buyer wants to know the
// directory has the supplier they need; a supplier wants to know buyers are
// asking. One sign-in page cannot argue both, so each audience gets its own
// page and its own evidence.
//
// The numbers on those pages are measured — `getDirectoryStats` counts rows.
// The quotes are not, so they live here rather than in a constant: a quote
// written through the admin costs a revalidation, and one written into
// `lib/…` costs a build, a deploy and a cold cache for every page on the site.
// ─────────────────────────────────────────────────────────────────────────────

enum TestimonialAudience {
  buyer
  supplier

  @@map("testimonial_audience")
}

/// One quote on one entry surface. Staff-authored from `/admin/content/testimonials`.
///
/// Attribution is required and free text. A quote with no name attached is a
/// claim the platform is making about itself in someone else's voice, which is
/// the one thing §08 will not let a trust signal do — and `verification_tier`
/// exists precisely because we do not take unattributed word for anything.
model Testimonial {
  id       String              @id @default(cuid())
  audience TestimonialAudience

  /// The quote. Held to a floor in `lib/content/testimonials.ts` — a five-word
  /// testimonial persuades nobody and costs the page its credibility.
  body String

  /// Who said it. A person's name, not a company: a company cannot speak.
  attribution String

  /// Their role and firm, on the line under the name. Optional, because a
  /// buyer who will give a name but not a company is still a real buyer.
  context String?

  /// Ascending. Ties break on `createdAt`, so an unset order is still stable.
  sortOrder Int @default(0) @map("sort_order")

  /// Null is a draft. The entry pages read published rows only.
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([audience, publishedAt, sortOrder])
  @@map("testimonial")
}

// ─────────────────────────────────────────────────────────────────────────────
// Legal pages — board 10j
//
// Four of them, one template. Content again: a change to the review policy
// should cost a revalidation and not a deploy, and the person who writes it is
// not the person who can push.
// ─────────────────────────────────────────────────────────────────────────────

enum LegalPageKind {
  terms
  privacy
  verification_policy
  review_policy

  @@map("legal_page_kind")
}

/// One of the four. Versioned by `effectiveFrom`, because a policy that changed
/// silently is a policy nobody can rely on.
model LegalPage {
  id   String        @id @default(cuid())
  kind LegalPageKind @unique

  title String
  body  String

  /// When this wording took effect. Shown on the page — a policy with no date
  /// is a policy that has always said whatever it says now.
  effectiveFrom DateTime @map("effective_from")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("legal_page")
}

// ─────────────────────────────────────────────────────────────────────────────
// Guides — boards 10b and 6d
//
// Twenty-two articles on verification, quoting, payment terms and getting a
// supplier to turn up. They are the only content in handoff 5 that works before
// supply density exists, and they earn the links the 84 area pages need to rank
// at all.
//
// Not governed by the board 6f matrix. That gate counts listings and verified
// share, and a guide about payment terms has neither. What a guide answers to
// is the word floor — the same 250 in `lib/publish-threshold.ts`, read from
// there rather than restated, so there is one number in the codebase.
// ─────────────────────────────────────────────────────────────────────────────

/// An editorial article on the directory. Staff-authored, published from
/// `/admin/content/guides`, and never generated.
/// The subjects a reader browses guides by — board 10b §3.
///
/// A table rather than an enum, and that is the spec's own doing: its Q2 says
/// the four subjects have never been agreed and recommends dropping one of
/// them. An enum bakes a contested taxonomy into a migration, so renaming a
/// subject or adding one would cost a deploy — while the global rule is that
/// content added through the admin costs a revalidation and the same content
/// added as a constant costs a build and a cold cache.
///
/// Not `Guide.topic`, which stays what its own comment says it is: the mono
/// kicker's middle term on the article. A trade licence guide can be filed
/// under "Buying safely" and still print `GUIDE · VERIFICATION · 6 MIN` — the
/// kicker is about the article and the subject is about the shelf.
model GuideSubject {
  id   String @id @default(cuid())
  /// The chip's URL: `/guides/buying-safely`.
  ///
  /// One namespace with `Guide.slug`, because both live directly under
  /// `/guides/`. `guideSlugCollision` refuses a subject that takes a guide's
  /// slug and a guide that takes a subject's, the way `slugCollision` already
  /// does for areas and categories.
  slug String @unique
  name String

  /// One line under the subject heading in the `Every guide` block. Optional:
  /// a subject with no blurb renders its heading and its count.
  blurb String?

  /// Where this subject sits on the index, left to right.
  ///
  /// Board 10b Q1: editorial sequence, not recency. "Newest review first turns
  /// the index into a changelog, and a guide re-checked yesterday is not more
  /// useful than the one that explains the badge."
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  guides Guide[]

  @@map("guide_subject")
}

model Guide {
  id      String @id @default(cuid())
  /// Frozen once published. The rule `Redirect` states, enforced in
  /// `lib/guides/service.ts`: a published URL that moves without a 301 spends
  /// standing the article was written to earn.
  slug    String @unique
  title   String
  /// The card on the index and the meta description. One sentence.
  summary String

  /// Heading, paragraph, bullets, numbered steps, callout, directory call to
  /// action. A guide's own vocabulary, not the storefront page one: that has a
  /// block reading a seller's documents and a call to action wired to a
  /// seller's catalogue, and it is edited per template by staff.
  body Json @default("[]")

  /// A string, not a relation. A byline is a name until somebody asks for
  /// author pages, and a `User` relation would imply the author has a seat.
  byline String?

  /// What the byline says the author does. "Verification lead", not a title.
  ///
  /// Board 6d Q1: an anonymous byline on an article instructing buyers about
  /// licensing and VAT is a rankings cost as well as a trust one, and this is
  /// the content type where a named, credentialed author moves rankings most.
  /// Null renders the byline without a role rather than inventing one.
  bylineRole String? @map("byline_role")

  /// The mono kicker's middle term — `GUIDE · VERIFICATION · 6 MIN READ`.
  ///
  /// Not `ctaCategoryId`, which is a trade in the directory taxonomy. A guide
  /// about payment terms belongs to no trade and still needs a kicker.
  topic String?

  /// The sentence Google shows and the one that decides whether the page is
  /// read. §4: it states the problem, it does not summarise the article.
  standfirst String?

  /// When the external facts were last checked against the world.
  ///
  /// Guides make claims about a named authority, a VAT rate, a renewal cadence,
  /// and those change. An article with a 2026 publication date and 2029 traffic
  /// is a liability on a page whose subject is trustworthiness.
  ///
  /// `Article.dateModified` renders this and `datePublished` renders
  /// `publishedAt`. Neither moves on a rebuild, a redeploy or a typo fix — the
  /// same rule as `AreaPage.contentUpdatedAt` and `CuratedList.auditedAt`, for
  /// the same reason.
  regulatoryCheckedAt DateTime? @map("regulatory_checked_at")

  /// How often the external facts need re-checking, in months. Null for an
  /// article that makes no claim about the world.
  ///
  /// Per article, not per programme: a guide naming an authority or a tax rate
  /// earns a six-month cadence, and one about how to write a good RFQ does not.
  /// Overdue articles surface in the board 6f queue and **stay published** —
  /// the deliberate difference from a curated list, where a stale page
  /// misrepresents named sellers rather than merely being old.
  reviewCadenceMonths Int? @map("review_cadence_months")

  /// Where the article sends the reader. Every guide ends in the directory —
  /// that is what they are for. Null means the index; a slug means that trade.
  ctaCategoryId String? @map("cta_category_id")

  /// Which shelf the index files this under — board 10b §3.
  ///
  /// Nullable, and the index says so rather than hiding it: a published guide
  /// with no subject still needs a link from its own index, or it is one of
  /// the fifteen articles this board exists to stop being unreachable.
  subjectId String? @map("subject_id")

  /// Editorial sequence within the subject. Board 10b Q1.
  sortOrder Int @default(0) @map("sort_order")

  /// The `START HERE` slot — board 10b §4.
  ///
  /// A timestamp rather than a boolean so the log says when it was chosen, and
  /// at most one across the whole programme: the migration carries a unique
  /// index over a constant expression filtered to `featured_at IS NOT NULL`,
  /// which is a rule Postgres enforces rather than one an `if` can drop.
  ///
  /// The slot is editorial and the label says so. The board called it
  /// `MOST READ`, which is either a computed ranking or an editorial choice
  /// and cannot be both — and if it is computed, nobody has written a
  /// standfirst for whichever article wins.
  featuredAt DateTime? @map("featured_at")

  /// The line under the featured standfirst saying why this one is first.
  ///
  /// A column, because the slot moves and the sentence is about the article in
  /// it. Board 10b §4 asks for "a second line saying why it is first", and a
  /// constant would go on saying the trade-licence guide defines the badge
  /// however many times the slot changed hands — the same defect §Ordering
  /// exists to prevent one paragraph earlier, where a computed ranking and a
  /// frozen editorial claim cannot describe each other.
  ///
  /// Null renders no line rather than a generic one.
  featuredNote String? @map("featured_note")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  ctaCategory Category?     @relation("GuideCtaCategory", fields: [ctaCategoryId], references: [id], onDelete: SetNull)
  subject     GuideSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  related     GuideRelated[] @relation("GuideFrom")
  relatedFrom GuideRelated[] @relation("GuideTo")

  /// The index reads published guides newest first, and the sitemap will read
  /// the same set.
  @@index([publishedAt])
  @@index([regulatoryCheckedAt])
  /// The index reads one shelf at a time, in the editor's order.
  @@index([subjectId, sortOrder])
  @@map("guide")
}

/// Three related guides, chosen by an editor.
///
/// Board 6d §6: *"Chosen editorially per article, not by tag similarity."* And
/// the reason is sharper than taste — *"A guide that covers a section this
/// article does not must appear here."* That is how "Free zone vs mainland"
/// resolved: it is a separate article, so it is a link rather than a heading,
/// and two of our own pages never target one query.
///
/// A join table rather than an array of ids, so a guide that is deleted cannot
/// leave a dangling reference in somebody else's rail — the failure a `String[]`
/// of ids has no way to prevent.
model GuideRelated {
  id       String @id @default(cuid())
  fromId   String @map("from_id")
  toId     String @map("to_id")
  /// Reading order in the rail. Three of them, and the order is the editor's.
  position Int

  from Guide @relation("GuideFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Guide @relation("GuideTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, position])
  @@unique([fromId, toId])
  @@index([toId])
  @@map("guide_related")
}

// ─────────────────────────────────────────────────────────────────────────────
// Storefront templates
//
// Sellers do not build storefronts. We build templates per sector; sellers fill
// the fields we opened. Ordering, adding, removing and composing sections is a
// staff action, which makes every template edit a fan-out: changing the
// Industrial template changes every live storefront in that sector.
//
// Three shapes carry that:
//
//   1. One live template per sector, enforced by a partial unique index. The
//      store count is only well defined if a listing has one template.
//   2. `TemplateSection.id` is stable across versions. `StorefrontContent` is
//      keyed to it, so a version restore that replaced section rows would
//      silently destroy seller content across every store on the template.
//      Restore upserts by id; it never clones.
//   3. Singletons are a column and an index, not a service remembering.
// ─────────────────────────────────────────────────────────────────────────────

// `TemplateStatus` is shared with `SpecTemplate` above. Draft, live and retired
// mean the same three things here, and a second enum with the same members
// would be a migration's worth of ceremony for no guarantee.

enum TemplateDensity {
  compact
  comfortable
  roomy

  @@map("template_density")
}

enum TypePairing {
  editorial
  clean
  technical

  @@map("type_pairing")
}

model StorefrontTemplate {
  id       String         @id @default(cuid())
  /// A top-level category. Not any category: a sector is the unit a seller
  /// recognises as their trade, and a template per subcategory would be a
  /// hundred templates nobody maintains.
  sectorId String         @map("sector_id")
  name     String
  status   TemplateStatus @default(draft)
  /// Bumped on publish. The history lives in `TemplateVersion`.
  version  Int            @default(1)

  // ── Theme, board 5b ──
  /// Which of the six presets sellers in this sector may pick.
  offeredThemes  String[]        @default([]) @map("offered_themes")
  defaultTheme   String          @default("default") @map("default_theme")
  /// A hex outside the six. Contrast-checked on save, refused below 4.5:1.
  allowCustomHex Boolean         @default(false) @map("allow_custom_hex")
  typePairing    TypePairing     @default(clean) @map("type_pairing")
  cornerRadius   Int             @default(6) @map("corner_radius")
  density        TemplateDensity @default(comfortable)
  darkHeader     Boolean         @default(false) @map("dark_header")
  /// Pro entitlement. Whether a seller on this template may take our badge off.
  badgeRemovable Boolean         @default(false) @map("badge_removable")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sector   Category          @relation("SectorTemplates", fields: [sectorId], references: [id], onDelete: Restrict)
  sections TemplateSection[]
  pages    TemplatePage[]
  versions TemplateVersion[]

  @@index([sectorId, status], map: "storefront_template_sector_idx")
  @@map("storefront_template")
}

model TemplateSection {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  /// A `SectionType` key from `lib/storefront/section-types.ts`. Not an enum:
  /// adding a type is a code change and the catalogue is the source of truth,
  /// so a migration per section type would be ceremony with no guarantee.
  type       String

  sortOrder Int     @default(0) @map("sort_order")
  enabled   Boolean @default(true)
  /// Cannot be moved, disabled or removed. Only the header. Denormalised from
  /// the catalogue so the check constraint below can see it.
  fixed     Boolean @default(false)
  /// Denormalised for the partial unique index. Criterion 7.
  singleton Boolean @default(false)

  /// Which of the type's declared fields this template lets a seller fill.
  /// Always a subset of `sellerFieldKeys(type)`, checked at write time.
  sellerEditableFields String[] @default([]) @map("seller_editable_fields")
  showOnMobile         Boolean  @default(true) @map("show_on_mobile")
  /// Staff settings for this instance — hero layout, background source. Shaped
  /// by the type, validated in the service.
  settings             Json     @default("{}")

  template StorefrontTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  content  StorefrontContent[]

  @@index([templateId, sortOrder], map: "template_section_order_idx")
  @@map("template_section")
}

/// What one seller filled into one section.
///
/// The fifth object, which the specification does not name and cannot work
/// without: ten of the fourteen types have a "Seller fills" column and there
/// was nowhere to put what a specific seller filled in.
///
/// Keyed to `TemplateSection.id`, which survives a version restore. Keyed to a
/// row that a restore replaced, a template rollback would wipe seller content
/// across every store in the sector — silently, and with no way back.
model StorefrontContent {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  sectionId  String   @map("section_id")
  /// Only keys in the section's `sellerEditableFields`, only field types the
  /// section type declares. Validated on write; a blob nobody checks is a blob
  /// that eventually renders somebody's price.
  values     Json     @default("{}")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  section  TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([businessId, sectionId])
  @@index([sectionId], map: "storefront_content_section_idx")
  @@map("storefront_content")
}

model TemplatePage {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  slug       String
  title      String

  metaDescription String?        @map("meta_description")
  /// Heading, text, image+text, numbers row, timeline, gallery, certifications,
  /// call to action. A smaller vocabulary than sections, because a page is
  /// prose and a storefront home is data.
  blocks          Json           @default("[]")
  showInNav       Boolean        @default(true) @map("show_in_nav")
  allowIndexing   Boolean        @default(true) @map("allow_indexing")
  status          TemplateStatus @default(draft)
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  template StorefrontTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, slug])
  @@map("template_page")
}

/// A published version, kept whole.
///
/// Criterion 12: publish is reversible from version history. The snapshot is
/// the section list and the theme settings as they were, and a restore writes
/// them back by section id rather than recreating rows — see
/// `StorefrontContent` for why that distinction is the whole ballgame.
model TemplateVersion {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  version    Int
  /// The sections and settings as published. Read by the restore path and by
  /// the diff the publish confirmation shows.
  snapshot   Json

  /// How many live storefronts this publish changed. On the row because the
  /// number is the decision — "this affects 1,842 stores" is what somebody
  /// confirmed, and a history that lost it cannot say what was agreed.
  storeCount  Int      @map("store_count")
  publishedBy String   @map("published_by") @db.Uuid
  /// Never null. Same rule as `AuditEvent`, for the same reason.
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  template StorefrontTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  author   User               @relation(fields: [publishedBy], references: [id], onDelete: Restrict)

  @@unique([templateId, version])
  @@map("template_version")
}

/// A named person on a storefront, with the consent to be there.
///
/// The "Meet the team" section asks for names, roles and numbers on a public
/// page. `User.phone` is a sign-in credential and is never this. A row here is
/// a deliberate act with a timestamp on it, in the same handoff that builds the
/// PDPL erasure path — and the number defaults to the branch line rather than
/// anybody's mobile.
model TeamMember {
  id         String  @id @default(cuid())
  businessId String  @map("business_id")
  name       String
  role       String
  /// The branch line unless somebody chose otherwise. Never `User.phone`.
  phone      String?
  locationId String? @map("location_id")
  mediaId    String? @map("media_id")
  sortOrder  Int     @default(0) @map("sort_order")

  /// When this person agreed to appear. NOT NULL: there is no row without
  /// consent, so there is no state in which one is published without it.
  consentGivenAt DateTime @map("consent_given_at")
  /// Who recorded it, so an erasure request has somebody to ask.
  consentBy      String   @map("consent_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  media    Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([businessId, sortOrder], map: "team_member_business_idx")
  @@map("team_member")
}

enum DomainStatus {
  pending
  partial
  verified
  failed
  revoked

  @@map("domain_status")
}

/// A seller's own web address, and how far along it is.
///
/// Two addresses, both live: the platform URL keeps its ranking and the custom
/// domain is the one on the business card. Neither replaces the other, which is
/// also why a revoked domain costs the seller nothing — `/b/:slug` was serving
/// all along.
///
/// One per business. A seller with two web addresses pointing at one storefront
/// is two sets of canonical tags and a ranking problem we would have made.
model CustomDomain {
  id         String       @id @default(cuid())
  businessId String       @unique @map("business_id")
  hostname   String       @unique
  /// Goes in the TXT record. Random, and never reused across hostnames.
  token      String
  status     DomainStatus @default(pending)

  /// Per record, independently. Partial propagation is the normal case and
  /// must not read as failure — criterion 8.
  cnameState String @default("waiting") @map("cname_state")
  txtState   String @default("waiting") @map("txt_state")

  addedAt        DateTime  @default(now()) @map("added_at")
  lastCheckedAt  DateTime? @map("last_checked_at")
  verifiedAt     DateTime? @map("verified_at")
  /// Set only where a real provider issued one. Null while the issuer is the
  /// console fake, which is what stops a screen claiming TLS it has not got.
  certificateRef String?   @map("certificate_ref")
  /// Which of the named causes, where it failed. Never a resolver error string.
  failureCause   String?   @map("failure_cause")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status, lastCheckedAt], map: "custom_domain_poll_idx")
  @@map("custom_domain")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
//
// Templates are database records rather than code because handoff 4 gives
// admin an editor for them, and because a WhatsApp template needs Meta
// approval before a new version can send — so a version has to be a row with a
// status, not a deploy.
//
// Rule 1 applies here hardest: no notification of any kind may contain a
// buyer's contact details. A test asserts it across every template.
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationEvent {
  enquiry_received
  enquiry_unanswered
  enquiry_escalated
  quote_received
  quote_revised
  quote_accepted
  quote_expiring
  review_posted
  review_requested
  /// Board 11c `B5`. The dispute rail promises a decision in about two working
  /// days and that "the outcome and the reason are logged and sent to you" —
  /// the second half needs an emitter, or the sentence is the unowned promise
  /// board 4e Q2 already got wrong.
  ///
  /// The outcome and the ground travel; the moderator's prose does not.
  /// `render()` refuses a value that looks like contact details, and a reason
  /// explaining that a review published somebody's mobile number would throw
  /// rather than send. It is on the review, where the seller reads it.
  review_dispute_decided
  document_expiring
  /// Criterion 8. A buyer whose search found nothing, told when it would not.
  product_alert_matched
  /// A subscription charged for another period. The first event a cron sends.
  subscription_renewed
  /// Board 8a's one nudge: 72 hours after go-live, if a setup task is still
  /// open. Exactly one, ever — the panel on the hub says so out loud, so the
  /// job has to honour it. See lib/setup/nudge-job.ts.
  setup_nudge
  /// Board 11b's follow-up. A buyer who has gone quiet is by definition not
  /// looking at the thread, so a message to them needs a carrier.
  message_received
  /// Board 3d: the Ramadan window we publish has moved.
  ///
  /// The dates are ours and the card promises "we shift them and email you when
  /// they move" — a commitment in shipped copy needs an emitter, or it is the
  /// unowned-promise shape board 4e Q2 already got wrong. The seller's *hours*
  /// are untouched by the shift, and the mail says so: a date we corrected is
  /// not a reason to re-ask them a question they have already answered.
  ramadan_dates_moved
  weekly_digest

  @@map("notification_event")
}

enum NotificationChannel {
  whatsapp
  sms
  email
  in_app

  @@map("notification_channel")
}

enum TemplateApproval {
  draft
  /// WhatsApp only: submitted to Meta and waiting.
  pending_meta
  live
  retired

  @@map("template_approval")
}

model NotificationTemplate {
  id      String              @id @default(cuid())
  event   NotificationEvent
  channel NotificationChannel
  locale  String              @default("en")
  version Int                 @default(1)
  status  TemplateApproval    @default(draft)

  /// Email only.
  subject     String?
  /// Placeholders are {curly}. Never a buyer phone, email or company name.
  body        String
  /// The one action. Deep link, relative.
  actionLabel String? @map("action_label")
  actionPath  String? @map("action_path")

  /// WhatsApp only: the Meta-approved template name this maps to.
  metaTemplateName String? @map("meta_template_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@unique([event, channel, locale, version])
  @@index([event, channel, status])
  @@map("notification_template")
}

/// A seller's routing matrix, board 7e. One row per business.
/// A channel a seat can be reached on, and whether anybody proved it.
///
/// Boards 7d and 7e. The rule that spans them — *a seat with no verified
/// notification channel cannot be a routing target* — has four readers and had
/// nothing to read: 7d's `REACHABLE ON` column, 7d §4's routing skip, 7e §3's
/// reachability rail, and 7e's promise that an unverified number receives
/// nothing.
///
/// ## Why not `User.phone` and `User.email`
///
/// Neither means what this needs. `createProvisionalIdentity` writes
/// `User.phone` with `phone_confirm: false` and `addressFor` hands it straight
/// to the carrier, so a non-null phone is false-positive for exactly the seats
/// this column exists to catch. And `adoptProfile` writes phone *or* email with
/// nothing ever adding the second, so "WhatsApp · email" cannot be true of
/// anybody on that shape.
///
/// ## Why in-app is not a kind
///
/// It needs no address and no verification, and 7e §2 keeps it always on for
/// anything with a deadline. A row for it would make every seat trivially
/// reachable and the routing rule would mean nothing.
model SeatChannel {
  id         String          @id @default(cuid())
  /// The seat. Cascades: a deleted account takes its channels with it.
  userId     String          @map("user_id") @db.Uuid
  /// Denormalised from `User.businessId`. Every read on both boards is "the
  /// channels for this business's seats", and the alternative is a join through
  /// `user` on screens that already join it for names.
  businessId String          @map("business_id")
  kind       SeatChannelKind
  /// E.164 for a number, an address for email. Normalised by the service, so
  /// the column holds one shape per kind.
  address    String

  /// The whole point of the table. Null means the seat typed a number and never
  /// proved it: hidden from buyers, receives nothing, not a routing target.
  verifiedAt      DateTime? @map("verified_at")
  /// When a code last went out, for the resend throttle. Never the code itself:
  /// `AuthAttempt` owns the attempt history, `SeatChannelChallenge` holds the
  /// hash, and this table — which four screens read and the roster joins — holds
  /// no secret at all.
  challengeSentAt DateTime? @map("challenge_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  business  Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  challenge SeatChannelChallenge?

  /// One address per kind per seat. Two WhatsApp numbers on one seat is a seller
  /// who cannot say which routing should try, and 7e §3 renders the order they
  /// are tried in rather than a set.
  @@unique([userId, kind], map: "seat_channel_user_kind_key")
  @@index([businessId, verifiedAt], map: "seat_channel_business_idx")
  @@map("seat_channel")
}

/// The code that proves a channel. Board 7e §8.1.
///
/// Its own table because `SeatChannel` is read by four surfaces and joined into
/// the team roster, and a hashed secret has no business travelling with it.
///
/// One live challenge per channel: asking again replaces it rather than stacking
/// a second, so the code in the most recent message is the only one that works.
/// Two valid codes is a window that stays open as long as somebody keeps
/// pressing the button — the same rule `inviteSeat` applies to its token.
model SeatChannelChallenge {
  id            String   @id @default(cuid())
  seatChannelId String   @unique @map("seat_channel_id")
  /// SHA-256 of the six digits. The code is sent and never stored, so a leaked
  /// backup of this table proves nothing on its own.
  codeHash      String   @map("code_hash")
  expiresAt     DateTime @map("expires_at")
  /// Wrong guesses against this one code. `lib/auth/throttle.ts` counts attempts
  /// per address across codes; this counts them per code, so asking for a new
  /// one is a fresh five rather than an escape from the last five.
  attempts      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  channel SeatChannel @relation(fields: [seatChannelId], references: [id], onDelete: Cascade)

  @@map("seat_channel_challenge")
}

enum SeatChannelKind {
  whatsapp
  sms
  email

  @@map("seat_channel_kind")
}

/// Why the router could not place a lead.
///
/// 7d §9 calls `unroutable_lead` the single measurement that says whether this
/// pair of screens works, and `assigned_to_id IS NULL` cannot carry it: a lead
/// under `everyone` routing is unassigned because nobody was meant to own it,
/// and a lead the router tried to place and could not is a failure. Same null,
/// opposite meanings.
enum UnroutedReason {
  no_reachable_seat
  outside_hours
  no_seat_in_branch
  routing_off

  @@map("unrouted_reason")
}

model NotificationPreference {
  id         String @id @default(cuid())
  businessId String @unique @map("business_id")

  /// Event to channels, e.g. { "enquiry_received": ["whatsapp", "in_app"] }.
  /// JSON rather than a join table: the matrix is edited as a whole and read
  /// as a whole, and a row per cell would be forty rows nobody queries singly.
  routing Json @default("{}")

  /// Quiet hours suppress WhatsApp and SMS. In-app is never suppressed —
  /// it is not an interruption.
  quietHoursEnabled Boolean @default(true) @map("quiet_hours_enabled")
  quietFromHour     Int     @default(21) @map("quiet_from_hour")
  quietToHour       Int     @default(7) @map("quiet_to_hour")
  quietOnSunday     Boolean @default(true) @map("quiet_on_sunday")

  /// A high-value enquiry overrides quiet hours. Null means never override.
  highValueOverrideAed Int? @default(50000) @map("high_value_override_aed")

  /// Where the escalation in the matrix goes after two hours unanswered.
  escalateToUserId     String? @map("escalate_to_user_id") @db.Uuid
  escalateAfterMinutes Int     @default(120) @map("escalate_after_minutes")

  /// The single follow-up nudge, and how long after delivery it fires.
  nudgeEnabled    Boolean @default(true) @map("nudge_enabled")
  nudgeAfterHours Int     @default(24) @map("nudge_after_hours")

  /// Where invoices go. Board 11g's `Email to accounts@…` reads this.
  ///
  /// Null is the ordinary state, not a gap: `billingRecipient()` then resolves
  /// the finance seat, and the owner after that. A supplier who has given the
  /// card to a bookkeeper has already told us where invoices should land by
  /// seating them, and asking again in Settings would be a field most sellers
  /// leave empty while the answer sits one table over.
  ///
  /// Set, it wins — an accounts inbox is not a person and cannot be a seat.
  billingEmail String? @map("billing_email")

  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

enum DeliveryStatus {
  queued
  /// Held by quiet hours, to send when they lift.
  deferred
  sent
  failed
  /// Suppressed on purpose — duplicate, or the channel is off in the matrix.
  skipped

  @@map("delivery_status")
}

/// Every send attempt. Quiet-hours deferral, deduplication and the one-nudge
/// rule all need to know what has already gone out.
model NotificationDelivery {
  id         String              @id @default(cuid())
  templateId String?             @map("template_id")
  event      NotificationEvent
  channel    NotificationChannel
  status     DeliveryStatus      @default(queued)

  /// Who it went to. A user id, never a phone number — the number is read from
  /// the user at send time and never stored on the log.
  recipientUserId String? @map("recipient_user_id") @db.Uuid
  businessId      String? @map("business_id")
  enquiryId       String? @map("enquiry_id")

  /// Why it was skipped or deferred, for the seller's own audit of their alerts.
  reason       String?
  /// The rendered message, for a delivery that is going to be sent later.
  ///
  /// Written only when quiet hours defer one. Everything needed to hand it to a
  /// carrier except the address: subject, body, action label and URL, and the
  /// Meta template name. **Never contact details** — the number or address is
  /// read from the user at send time, which is the rule the `recipientUserId`
  /// comment above states and this column has to keep.
  ///
  /// Rendered when the event happened rather than when the message goes out, so
  /// a notification held overnight says what was true at the time. Re-rendering
  /// at send would quietly describe a quote that has since been amended.
  payload      Json?
  scheduledFor DateTime? @map("scheduled_for")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([event, businessId, createdAt])
  @@index([status, scheduledFor])
  @@map("notification_delivery")
}

// ─────────────────────────────────────────────────────────────────────────────
// Review requests
// ─────────────────────────────────────────────────────────────────────────────

/// Seller-initiated, board 11c. One per buyer ever — the unique constraint is
/// the rule, not a screen that remembers. No incentives: an incentivised
/// review is removed and logged against the account.
model ReviewRequest {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  buyerId    String   @map("buyer_id") @db.Uuid
  /// The accepted quote that earns the right to ask.
  enquiryId  String   @map("enquiry_id")
  sentAt     DateTime @default(now()) @map("sent_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyer    User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  enquiry  Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@unique([businessId, buyerId])
  @@index([businessId, sentAt])
  @@map("review_request")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform settings — the calendar and the geography board 12h owns
// ─────────────────────────────────────────────────────────────────────────────

/// One row per platform-level setting. Board 12h edits these; everything else
/// reads them.
///
/// It exists because of one specific line in board 2d: *"The dates come from one
/// platform-level setting, not from each seller. Ramadan moves yearly and 41,000
/// sellers will not update it."* The dates were already platform-level — a
/// constant in `lib/trade/hours.ts` — which satisfied the "not each seller" half
/// and failed the other: a lunar calendar that shifts every year should not need
/// a deploy to correct, and CLAUDE.md is explicit that content belongs in the
/// database rather than in a commit.
///
/// A key/value table rather than a column per setting, because the alternative
/// is a one-row table that grows a migration every time the platform learns a
/// new fact about itself. `value` is validated on read by whichever module owns
/// the key — see `lib/trade/ramadan-calendar.ts` — and a malformed or missing
/// row falls back to the compiled default rather than taking a surface down.
///
/// **A staff write to this table is a staff state change and owes an audit row
/// with a written reason** (CLAUDE.md, non-negotiable 3). `updatedById` is who,
/// and it is nullable only because the seed writes these rows before any user
/// exists. There is deliberately no writer in this codebase yet: board 12h owns
/// it, and it must go through the audit service rather than around it.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("SettingWriter", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_setting")
}
