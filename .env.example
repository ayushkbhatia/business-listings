# ─── Supabase ────────────────────────────────────────────────────────────────
# Project: business-listings · org: Ayush Project Vault · region: ap-south-1 (Mumbai)
# Dashboard: https://supabase.com/dashboard/project/irywaycgqjeeoklfmzzd

NEXT_PUBLIC_SUPABASE_URL="https://irywaycgqjeeoklfmzzd.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# Dashboard → Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY=""

# ─── Postgres (Prisma) ───────────────────────────────────────────────────────
# Copy both strings verbatim from Dashboard → Connect. Do not hand-assemble them:
# the pooler hostname differs between older and newer projects.
#
# DATABASE_URL  = Transaction pooler, port 6543. Used by the app at runtime.
# DIRECT_URL    = Session pooler, port 5432. Used by `prisma migrate` only.
#
# Direct `db.<ref>.supabase.co` is IPv6-only on this project — use the pooler.

DATABASE_URL="postgresql://postgres.irywaycgqjeeoklfmzzd:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.irywaycgqjeeoklfmzzd:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
