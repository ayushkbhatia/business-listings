# ─── Supabase ────────────────────────────────────────────────────────────────
# Project: business-listings · org: Ayush Project Vault · region: ap-south-1 (Mumbai)
# Dashboard: https://supabase.com/dashboard/project/irywaycgqjeeoklfmzzd

NEXT_PUBLIC_SUPABASE_URL="https://irywaycgqjeeoklfmzzd.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# Dashboard → Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY="sb_secret_..."

# ─── Postgres (Prisma) ───────────────────────────────────────────────────────
# Copy both strings from Dashboard → Connect, or use the shape below. Percent-encode
# every reserved character in the password: & becomes %26, ^ becomes %5E, @ becomes %40.
# An unencoded & silently truncates the connection string at that point.
#
# DATABASE_URL  = Transaction pooler, port 6543. Used by the app at runtime.
# DIRECT_URL    = Session pooler, port 5432. Used by `prisma migrate` only.
#
# The tenant is on aws-0; aws-1 answers with "tenant/user not found". Direct
# `db.<ref>.supabase.co` resolves AAAA only, so the pooler is the portable choice.
# A password reset takes a few minutes to reach the pooler — retry before debugging.

DATABASE_URL="postgresql://postgres.irywaycgqjeeoklfmzzd:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.irywaycgqjeeoklfmzzd:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Bird — WhatsApp OTP delivery ────────────────────────────────────────────
# Region is baked into the key: a bk_eu1_ key is valid only against eu1.
BIRD_API_BASE="https://eu1.platform.bird.com"
BIRD_API_KEY="bk_eu1_..."
BIRD_WHATSAPP_CHANNEL_ID=""
BIRD_WHATSAPP_OTP_TEMPLATE=""

# ─── Resend — transactional email ────────────────────────────────────────────
# The carrier for the `email` notification channel. Both are required: a `from`
# on a domain Resend has not verified is accepted by the API and then not
# delivered, so the key alone would turn a setup mistake into silent
# non-delivery. Without both, email is a recorded skip in production and prints
# in development — never a send we cannot back up.
#
# Separate from the Supabase Auth SMTP setting, which is what sends the sign-in
# code. That one is configured in the Supabase dashboard and uses Resend's SMTP
# credentials rather than this API key.
RESEND_API_KEY="re_..."
RESEND_FROM="Business Listings <notifications@businesslistings.me>"
# Where a seller's reply goes if they hit Reply. Optional.
RESEND_REPLY_TO=""

# Shared secret between the Supabase send-SMS auth hook and our endpoint.
# Paste the same value both sides. Supabase gives it as `v1,whsec_…`; the
# endpoint strips the prefix. Without it the endpoint answers 500 rather than
# accepting unsigned requests — an unverified hook is an open OTP oracle.
# openssl rand -hex 32
AUTH_HOOK_SECRET=""

# Shared secret for the scheduled jobs at /api/jobs/*. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Unset refuses every call rather than
# allowing every call — a job that stops running beats one anybody can run.
# openssl rand -hex 32
CRON_SECRET=""

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Seller web addresses ────────────────────────────────────────────────────
# The zone every storefront label sits under.
#
# A seller on Pro gets `<label>.<zone>` — `indus-hydraulics` becomes
# `indushydraulics.businesslistings.me`. We own the zone, so nothing is verified
# and nothing is polled: `proxy.ts` matches the host against this value and
# rewrites to the storefront.
#
# Two things have to be true outside this repo for a browser to arrive:
# a wildcard `*.businesslistings.me` DNS record at the registrar, and the
# wildcard domain added to the Vercel project so one certificate covers every
# seller. Neither is application code and neither can be done from here.
#
# Locally this is `localhost` — `indushydraulics.localhost:3000` resolves on
# most systems without a hosts entry, which is enough to drive the rewrite.
NEXT_PUBLIC_SUBDOMAIN_ZONE="businesslistings.me"

# ─── Development only ────────────────────────────────────────────────────────
# The seller seat /dashboard acts as when there is no session at all.
# A seeded business slug. Ignored entirely when NODE_ENV is production — see
# lib/auth/dev-seller.ts — and ignored when unset, so leave it blank to get the
# real session path.
#
# Prefer /dev/seat, which signs you in properly and lets you switch business and
# role without an edit here.
DEV_SELLER_SLUG="al-marwan-industrial-supplies-llc"

# The /dev surfaces — /dev, /dev/seat, /dev/gallery, /dev/notifications.
#
# They render only when DATABASE_URL is loopback, so this is not what keeps them
# out of production; lib/dev/guard.ts is, and the database is the condition that
# carries the weight. Set to "off" to close them on a local machine as well.
DEV_SURFACES=""
